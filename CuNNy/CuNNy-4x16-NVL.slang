#define L0(x, y) (half3)(INPUT.SampleLevel(sam, pos + float2(x, y) * pt, 0).rgb)

[bgfx::EFFECT("CuNNy 4x16", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("CuNNy 4x16 neural network 2x upscaler")]
[bgfx::FP16]
[bgfx::PASS(1, "in (3x16)")]
[bgfx::PASS_IO("INPUT", "t0, t1, t2, t3")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half3 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	half4 r0 = half4(1.406e-02h, -1.134e-03h, -1.611e-02h, -2.320e-04h);
	half4 r1 = half4(3.087e-02h, 1.628e-03h, 3.260e-02h, 5.064e-03h);
	half4 r2 = half4(8.945e-03h, 1.333e-01h, 1.492e-02h, -4.488e-03h);
	half4 r3 = half4(2.635e-03h, -9.137e-03h, -8.033e-01h, -1.303e-02h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half3x4(7.157e-03h, 1.490e-02h, 8.311e-03h, -1.157e-03h, 6.252e-02h, -8.575e-03h, 4.185e-02h, 1.996e-02h, -3.998e-03h, -4.913e-03h, -2.806e-02h, -9.369e-03h), r0);
	r1 = MulAdd(s0_0_0, half3x4(-9.445e-05h, 5.493e-03h, 3.455e-02h, -1.350e-02h, -4.914e-02h, 1.802e-02h, -7.098e-02h, -2.797e-02h, 6.551e-04h, -1.144e-02h, -7.462e-04h, 5.474e-03h), r1);
	r2 = MulAdd(s0_0_0, half3x4(1.800e-02h, 3.464e-02h, -1.416e-02h, -8.819e-02h, -3.611e-02h, 3.967e-02h, 5.867e-03h, 9.414e-02h, -4.628e-02h, -1.848e-02h, 3.075e-04h, -1.116e-02h), r2);
	r3 = MulAdd(s0_0_0, half3x4(-7.233e-03h, -2.764e-02h, -2.142e-02h, 2.087e-02h, 1.905e-02h, -5.868e-02h, -4.900e-02h, 3.184e-02h, 1.831e-03h, 4.915e-03h, 2.649e-02h, -1.217e-02h), r3);
	r0 = MulAdd(s0_0_1, half3x4(5.857e-03h, 9.514e-03h, 1.102e-02h, -1.616e-03h, -7.543e-02h, -1.011e-02h, -1.817e-02h, -1.148e-02h, 1.734e-03h, 1.404e-03h, -3.328e-03h, 9.912e-03h), r0);
	r1 = MulAdd(s0_0_1, half3x4(-1.850e-02h, 2.933e-01h, -6.853e-02h, 2.949e-02h, -3.841e-02h, 6.708e-01h, 5.893e-02h, 3.614e-01h, 9.383e-03h, 1.069e-01h, 3.493e-03h, 1.655e-03h), r1);
	r2 = MulAdd(s0_0_1, half3x4(9.473e-02h, 4.626e-03h, 1.054e-02h, -1.005e-01h, 2.881e-01h, 8.076e-03h, 2.435e-02h, 1.111e-01h, -6.196e-02h, -7.233e-03h, 7.476e-03h, -6.289e-03h), r2);
	r3 = MulAdd(s0_0_1, half3x4(6.262e-03h, 3.516e-03h, 2.109e-02h, 8.779e-03h, -2.143e-02h, 4.856e-02h, -4.855e-02h, -4.048e-02h, 2.852e-03h, -1.029e-02h, -4.945e-02h, -1.199e-02h), r3);
	r0 = MulAdd(s0_0_2, half3x4(-1.176e-03h, -2.588e-03h, -3.174e-02h, -6.474e-03h, -4.673e-03h, -2.921e-05h, -2.364e-02h, 2.064e-03h, 3.611e-03h, 3.187e-03h, 9.060e-02h, 6.318e-04h), r0);
	r1 = MulAdd(s0_0_2, half3x4(1.771e-02h, 5.698e-03h, 1.709e-02h, -3.503e-02h, 5.520e-03h, 3.892e-02h, -1.585e-02h, -9.999e-03h, -7.066e-03h, -1.358e-02h, -6.007e-04h, 2.835e-03h), r1);
	r2 = MulAdd(s0_0_2, half3x4(1.550e-02h, 3.339e-02h, -1.560e-03h, -1.513e-02h, 7.854e-02h, 2.149e-02h, -2.321e-03h, 7.129e-03h, -1.244e-02h, 6.597e-04h, -5.545e-03h, 5.801e-03h), r2);
	r3 = MulAdd(s0_0_2, half3x4(-5.756e-03h, -9.332e-04h, 7.462e-03h, -2.783e-02h, 1.247e-04h, 1.930e-02h, -5.367e-02h, 6.196e-03h, -2.841e-03h, -2.488e-03h, 3.808e-02h, -6.416e-04h), r3);
	r0 = MulAdd(s0_1_0, half3x4(3.175e-01h, -3.259e-02h, 5.764e-03h, 3.572e-01h, 6.230e-01h, 3.457e-02h, -2.519e-02h, 6.973e-01h, 1.037e-01h, -2.233e-03h, 2.533e-02h, 1.058e-01h), r0);
	r1 = MulAdd(s0_1_0, half3x4(5.013e-02h, 2.124e-03h, -3.317e-02h, 1.362e-02h, 8.784e-02h, -3.546e-02h, 1.501e-01h, -3.481e-02h, 1.142e-02h, 1.639e-02h, 1.085e-02h, -5.622e-03h), r1);
	r2 = MulAdd(s0_1_0, half3x4(1.018e-01h, 1.750e-02h, 9.937e-02h, 9.039e-01h, 1.865e-01h, 2.924e-02h, -1.143e-02h, -8.926e-01h, -5.468e-02h, -3.759e-02h, -1.213e-02h, 2.427e-02h), r2);
	r3 = MulAdd(s0_1_0, half3x4(-1.728e-02h, -2.822e-01h, -7.844e-02h, -5.404e-02h, -5.536e-02h, -5.129e-01h, 1.272e-02h, -4.425e-02h, -5.391e-03h, -6.419e-02h, -2.723e-02h, 1.895e-02h), r3);
	r0 = MulAdd(s0_1_1, half3x4(-3.135e-01h, 1.039e-01h, -2.092e-02h, -3.584e-01h, -6.341e-01h, -8.082e-02h, -2.023e-02h, -6.899e-01h, -9.937e-02h, -1.752e-02h, 1.861e-02h, -1.137e-01h), r0);
	r1 = MulAdd(s0_1_1, half3x4(-1.899e-01h, -2.959e-01h, 4.434e-01h, 4.040e-02h, 4.209e-01h, -6.660e-01h, -3.923e-01h, -1.362e-01h, -1.875e-02h, -9.937e-02h, 7.274e-03h, -1.664e-02h), r1);
	r2 = MulAdd(s0_1_1, half3x4(-1.285e-02h, -3.076e-01h, -2.356e-02h, 1.420e-02h, -1.861e-01h, -2.874e-01h, -9.692e-02h, 7.617e-03h, 1.460e-01h, 1.130e-01h, -1.789e-02h, -3.112e-02h), r2);
	r3 = MulAdd(s0_1_1, half3x4(-3.037e-01h, 2.982e-01h, 4.015e-01h, -2.343e-01h, -5.697e-01h, 5.332e-01h, 9.464e-01h, -5.139e-01h, -7.152e-02h, 7.354e-02h, 4.921e-02h, -3.209e-02h), r3);
	r0 = MulAdd(s0_1_2, half3x4(2.575e-02h, 4.951e-01h, 7.005e-02h, 7.335e-03h, -2.310e-02h, -4.872e-01h, 2.339e-01h, -9.570e-03h, 1.262e-03h, -1.385e-02h, 1.686e-01h, 5.026e-03h), r0);
	r1 = MulAdd(s0_1_2, half3x4(7.112e-02h, -1.259e-02h, -4.966e-02h, -3.044e-02h, -6.528e-02h, -3.708e-02h, 2.255e-01h, 1.337e-02h, 1.147e-02h, 1.541e-02h, 2.419e-04h, -5.793e-04h), r1);
	r2 = MulAdd(s0_1_2, half3x4(-1.679e-01h, 4.385e-02h, 4.834e-02h, -3.524e-02h, -2.842e-01h, -1.049e-02h, 1.458e-03h, 3.501e-02h, 4.593e-02h, -1.034e-02h, 9.453e-03h, -2.663e-03h), r2);
	r3 = MulAdd(s0_1_2, half3x4(7.414e-03h, -8.961e-03h, -9.222e-03h, -1.505e-03h, 7.776e-03h, 3.633e-03h, -1.130e-01h, -3.001e-02h, 1.463e-02h, -7.014e-03h, -6.145e-02h, -1.919e-02h), r3);
	r0 = MulAdd(s0_2_0, half3x4(5.313e-03h, -9.997e-03h, -3.144e-02h, 1.395e-02h, 1.068e-01h, 3.945e-05h, -4.951e-02h, 1.874e-03h, -6.101e-03h, 1.351e-02h, 1.806e-02h, -9.222e-03h), r0);
	r1 = MulAdd(s0_2_0, half3x4(-2.050e-02h, -1.242e-02h, 5.457e-03h, 1.360e-02h, -2.155e-02h, 5.849e-03h, -4.120e-02h, -2.882e-03h, -5.776e-03h, -5.614e-03h, -4.758e-03h, 2.753e-03h), r1);
	r2 = MulAdd(s0_2_0, half3x4(2.717e-02h, 2.725e-02h, -9.739e-02h, -8.745e-02h, 3.573e-02h, 2.733e-02h, 2.979e-02h, 1.004e-01h, 9.685e-03h, 4.758e-03h, -1.871e-03h, -1.864e-02h), r2);
	r3 = MulAdd(s0_2_0, half3x4(2.245e-02h, -1.159e-02h, 4.099e-02h, -2.380e-02h, 2.692e-02h, -1.038e-01h, -2.480e-02h, -3.101e-03h, -4.996e-03h, 2.104e-03h, 1.954e-02h, -3.133e-02h), r3);
	r0 = MulAdd(s0_2_1, half3x4(-3.370e-02h, -7.489e-01h, 9.913e-03h, -3.727e-03h, -2.200e-02h, 7.189e-01h, 8.426e-02h, -1.251e-02h, 3.844e-03h, 7.860e-03h, 1.343e-01h, 1.060e-02h), r0);
	r1 = MulAdd(s0_2_1, half3x4(2.718e-02h, 1.739e-02h, -1.048e-01h, -6.029e-03h, 5.644e-03h, 5.693e-03h, 1.256e-01h, 4.214e-02h, 3.031e-03h, -6.308e-03h, -1.031e-02h, 7.556e-03h), r1);
	r2 = MulAdd(s0_2_1, half3x4(-8.227e-02h, -2.763e-02h, 2.261e-01h, -7.162e-02h, 1.635e-03h, 4.283e-02h, 9.947e-02h, 7.666e-02h, 2.887e-02h, 7.367e-03h, 1.854e-02h, -4.228e-03h), r2);
	r3 = MulAdd(s0_2_1, half3x4(3.075e-01h, 2.363e-02h, -6.788e-02h, 2.479e-01h, 5.996e-01h, 4.575e-02h, -4.749e-02h, 4.628e-01h, 6.661e-02h, -5.581e-03h, -3.518e-02h, 6.356e-02h), r3);
	r0 = MulAdd(s0_2_2, half3x4(4.938e-03h, 1.720e-01h, -1.095e-04h, -6.701e-03h, -1.233e-02h, -1.695e-01h, -1.677e-01h, 3.480e-03h, 1.336e-03h, 1.412e-02h, -7.429e-01h, 3.504e-04h), r0);
	r1 = MulAdd(s0_2_2, half3x4(3.460e-02h, 2.450e-03h, -8.434e-02h, -1.975e-02h, 2.967e-03h, -1.477e-04h, 9.797e-02h, 1.727e-02h, 7.965e-03h, -1.813e-03h, 1.288e-03h, -6.565e-04h), r1);
	r2 = MulAdd(s0_2_2, half3x4(-1.458e-02h, 3.034e-02h, 4.005e-03h, -4.391e-02h, -8.667e-02h, 3.182e-04h, -7.493e-02h, 2.559e-02h, -4.620e-02h, -4.471e-03h, 7.274e-03h, 1.621e-02h), r2);
	r3 = MulAdd(s0_2_2, half3x4(-6.385e-03h, -1.216e-02h, 7.528e-03h, 1.992e-02h, -1.993e-03h, 6.777e-03h, -2.777e-02h, 9.337e-02h, -2.772e-03h, 1.418e-03h, 2.503e-02h, 7.394e-03h), r3);
	r0 = max(r0, 0.0h);
	t0_UAV[gxy] = float4(r0);
	r1 = max(r1, 0.0h);
	t1_UAV[gxy] = float4(r1);
	r2 = max(r2, 0.0h);
	t2_UAV[gxy] = float4(r2);
	r3 = max(r3, 0.0h);
	t3_UAV[gxy] = float4(r3);
}

#undef L0

#define L0(x, y) (half4)(t0.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L1(x, y) (half4)(t1.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L2(x, y) (half4)(t2.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L3(x, y) (half4)(t3.SampleLevel(sam, pos + float2(x, y) * pt, 0))

[bgfx::PASS(2, "conv1 (16x16)")]
[bgfx::PASS_IO("t0, t1, t2, t3", "t4, t5, t6, t7")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half4 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2, s1_0_0, s1_0_1, s1_0_2, s1_1_0, s1_1_1, s1_1_2, s1_2_0, s1_2_1, s1_2_2;
	half4 r0 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r1 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r2 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r3 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	s1_0_0 = L1(-1.0, -1.0); s1_0_1 = L1(0.0, -1.0); s1_0_2 = L1(1.0, -1.0);
	s1_1_0 = L1(-1.0, 0.0); s1_1_1 = L1(0.0, 0.0); s1_1_2 = L1(1.0, 0.0);
	s1_2_0 = L1(-1.0, 1.0); s1_2_1 = L1(0.0, 1.0); s1_2_2 = L1(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half4x4(1.788e-02h, 2.205e-01h, 2.886e-03h, 4.223e-01h, 2.034e-01h, -3.195e-01h, -3.347e-01h, -1.427e-01h, 1.224e-01h, -1.505e-01h, -9.164e-02h, -4.850e-01h, -1.100e-02h, -2.660e-01h, 6.822e-02h, -3.488e-01h), r0);
	r1 = MulAdd(s0_0_0, half4x4(-7.201e-02h, -1.380e-01h, 3.308e-02h, -2.421e-02h, 2.715e-02h, 2.007e-01h, 3.527e-02h, -2.437e-02h, -1.058e-01h, -3.545e-01h, -9.836e-02h, 1.884e-01h, 1.247e-01h, 2.260e-01h, -3.649e-02h, 9.177e-03h), r1);
	r2 = MulAdd(s0_0_0, half4x4(6.776e-02h, -3.331e-02h, -2.107e-02h, 1.116e-01h, 1.162e-01h, 3.677e-02h, -1.374e-01h, 1.475e-01h, 1.012e-01h, -1.307e-02h, -1.029e-01h, -4.349e-01h, -4.044e-02h, 2.801e-02h, 3.096e-02h, -1.280e-01h), r2);
