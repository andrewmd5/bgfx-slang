import bgfx;

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t0;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t0_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t1;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t2;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t3;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t4;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t5;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t5_UAV;


#define L0(x, y) half(dot(half3(0.299h, 0.587h, 0.114h), (half3)(INPUT.SampleLevel(sam, pos + float2(x, y) * pt, 0).rgb)))

[bgfx::EFFECT("CuNNy fast", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("CuNNy fast neural network 2x upscaler")]
[bgfx::FP16]
[bgfx::PASS(1, "in (1x12)")]
[bgfx::PASS_IO("INPUT", "t0, t1, t2")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	half4 r0 = half4(-7.280e-05h, 1.400e-04h, -1.296e-04h, 4.014e-04h);
	half4 r1 = half4(-1.023e-03h, 2.540e-04h, 1.793e-03h, -4.770e-03h);
	half4 r2 = half4(-5.813e-04h, 2.326e-02h, 2.179e-02h, 3.161e-03h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	r0 = mad(s0_0_0, half4(3.974e-03h, -4.994e-02h, -1.106e-01h, 7.984e-02h), r0);
	r1 = mad(s0_0_0, half4(-1.146e-02h, 2.714e-02h, -1.208e-01h, -5.811e-03h), r1);
	r2 = mad(s0_0_0, half4(2.306e-02h, -1.984e-02h, -1.205e-02h, -5.797e-03h), r2);
	r0 = mad(s0_0_1, half4(8.621e-01h, 4.326e-01h, 5.918e-01h, -1.650e-01h), r0);
	r1 = mad(s0_0_1, half4(5.566e-03h, -1.528e-01h, 1.548e-01h, -3.752e-01h), r1);
	r2 = mad(s0_0_1, half4(-2.113e-02h, -2.094e-04h, 6.522e-02h, -5.227e-02h), r2);
	r0 = mad(s0_0_2, half4(1.085e-02h, -1.058e-01h, -7.681e-03h, -8.618e-02h), r0);
	r1 = mad(s0_0_2, half4(2.526e-03h, -1.193e-01h, 1.655e-01h, 2.262e-02h), r1);
	r2 = mad(s0_0_2, half4(4.877e-03h, 8.765e-03h, 9.976e-03h, 3.630e-02h), r2);
	r0 = mad(s0_1_0, half4(-6.514e-03h, -1.627e-02h, 9.897e-02h, 3.289e-02h), r0);
	r1 = mad(s0_1_0, half4(7.988e-01h, 3.223e-02h, 3.274e-02h, -2.993e-01h), r1);
	r2 = mad(s0_1_0, half4(2.822e-03h, -4.395e-03h, 3.037e-01h, -2.012e-01h), r2);
	r0 = mad(s0_1_1, half4(-8.652e-01h, -1.159e-02h, 8.169e-02h, 4.252e-01h), r0);
	r1 = mad(s0_1_1, half4(-7.781e-01h, 4.338e-01h, 2.879e-01h, 7.549e-01h), r1);
	r2 = mad(s0_1_1, half4(6.310e-01h, -1.011e-01h, -2.446e-01h, 5.293e-01h), r2);
	r0 = mad(s0_1_2, half4(-5.410e-03h, -9.159e-02h, -6.371e-01h, -6.387e-01h), r0);
	r1 = mad(s0_1_2, half4(-1.319e-02h, -1.619e-01h, 2.345e-01h, -8.862e-02h), r1);
	r2 = mad(s0_1_2, half4(-1.833e-02h, 3.118e-02h, 2.168e-02h, -4.513e-02h), r2);
	r0 = mad(s0_2_0, half4(5.906e-05h, -6.218e-03h, 2.289e-02h, -1.228e-01h), r0);
	r1 = mad(s0_2_0, half4(-1.375e-02h, 1.999e-02h, 9.690e-02h, 1.443e-02h), r1);
	r2 = mad(s0_2_0, half4(2.581e-02h, -1.284e-01h, 3.156e-02h, -6.670e-02h), r2);
	r0 = mad(s0_2_1, half4(2.334e-03h, -4.197e-03h, -1.160e-01h, 3.487e-01h), r0);
	r1 = mad(s0_2_1, half4(2.869e-03h, -2.522e-02h, -4.490e-01h, 8.423e-02h), r1);
	r2 = mad(s0_2_1, half4(-5.647e-03h, 3.777e-01h, -1.097e-01h, -1.901e-01h), r2);
	r0 = mad(s0_2_2, half4(-4.110e-03h, 1.439e-03h, 7.400e-02h, 1.250e-01h), r0);
	r1 = mad(s0_2_2, half4(6.177e-03h, 1.872e-02h, -4.033e-01h, -1.047e-01h), r1);
	r2 = mad(s0_2_2, half4(1.412e-02h, 1.066e-02h, -2.194e-02h, 2.292e-02h), r2);
	r0 = max(r0, 0.0h);
	t0_UAV[gxy] = float4(r0);
	r1 = max(r1, 0.0h);
	t1_UAV[gxy] = float4(r1);
	r2 = max(r2, 0.0h);
	t2_UAV[gxy] = float4(r2);
}

#undef L0

#define L0(x, y) (half4)(t0.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L1(x, y) (half4)(t1.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L2(x, y) (half4)(t2.SampleLevel(sam, pos + float2(x, y) * pt, 0))

[bgfx::PASS(2, "conv1 (12x12)")]
[bgfx::PASS_IO("t0, t1, t2", "t3, t4, t5")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half4 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2, s1_0_0, s1_0_1, s1_0_2, s1_1_0, s1_1_1, s1_1_2, s1_2_0, s1_2_1, s1_2_2;
	half4 r0 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r1 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r2 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	s1_0_0 = L1(-1.0, -1.0); s1_0_1 = L1(0.0, -1.0); s1_0_2 = L1(1.0, -1.0);
	s1_1_0 = L1(-1.0, 0.0); s1_1_1 = L1(0.0, 0.0); s1_1_2 = L1(1.0, 0.0);
	s1_2_0 = L1(-1.0, 1.0); s1_2_1 = L1(0.0, 1.0); s1_2_2 = L1(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half4x4(-1.195e-01h, -2.782e-03h, -1.647e-02h, 8.935e-02h, 1.342e-01h, -4.409e-02h, -2.694e-02h, -1.557e-01h, -4.474e-01h, 5.639e-02h, 1.080e-01h, -1.304e-01h, -2.758e-01h, 7.983e-02h, -1.059e-02h, -6.616e-02h), r0);
	r1 = MulAdd(s0_0_0, half4x4(1.783e-01h, 9.807e-02h, -2.627e-02h, -2.885e-02h, 2.384e-01h, -2.243e-01h, -7.838e-03h, 6.787e-02h, -2.319e-01h, 2.666e-01h, 1.008e-01h, -1.147e-01h, 9.865e-02h, 1.294e-01h, 4.350e-02h, 1.246e-01h), r1);
	r2 = MulAdd(s0_0_0, half4x4(-1.619e-02h, -3.094e-02h, -4.934e-02h, -1.328e-02h, -4.038e-02h, 2.685e-02h, -2.006e-01h, -1.888e-02h, -3.766e-02h, 3.719e-02h, 8.466e-02h, 6.166e-03h, -9.328e-02h, -2.239e-01h, -7.447e-02h, 1.739e-02h), r2);
	r0 = MulAdd(s0_0_1, half4x4(-5.621e-01h, -1.996e-02h, 8.765e-02h, -3.496e-02h, 4.525e-01h, -7.246e-02h, -2.052e-01h, -1.602e-01h, -2.078e-01h, 6.393e-02h, 2.912e-02h, 7.006e-02h, 4.341e-01h, 1.246e-01h, 2.096e-02h, 6.617e-02h), r0);
	r1 = MulAdd(s0_0_1, half4x4(2.314e-02h, -3.825e-02h, 2.103e-02h, 4.088e-02h, 3.772e-01h, -2.136e-01h, -9.008e-02h, -1.062e-01h, -9.125e-03h, 7.250e-02h, 2.888e-02h, -1.003e-01h, 1.971e-02h, -3.385e-01h, -5.944e-04h, 2.791e-01h), r1);
	r2 = MulAdd(s0_0_1, half4x4(8.260e-03h, -1.815e-01h, 1.043e-01h, -6.471e-03h, -2.324e-01h, 3.654e-02h, -3.034e-01h, -4.956e-02h, 6.765e-02h, 9.634e-02h, 6.750e-02h, 2.752e-02h, 2.886e-02h, -1.977e-01h, 6.311e-01h, 2.736e-02h), r2);
	r0 = MulAdd(s0_0_2, half4x4(-1.072e-01h, -7.057e-02h, 1.890e-02h, 1.577e-01h, 2.271e-01h, 1.453e-01h, -8.716e-02h, -2.320e-01h, -1.048e-01h, 1.195e-02h, -6.811e-03h, 2.474e-02h, -3.527e-02h, -1.130e-01h, -1.529e-02h, -8.423e-02h), r0);
	r1 = MulAdd(s0_0_2, half4x4(-8.031e-02h, -9.505e-02h, -4.529e-02h, 9.090e-02h, 1.433e-01h, -1.259e-01h, 7.499e-02h, 7.982e-02h, 3.114e-03h, 4.358e-02h, -4.961e-02h, -1.052e-01h, -3.700e-02h, -1.449e-01h, -1.125e-01h, 1.505e-01h), r1);
	r2 = MulAdd(s0_0_2, half4x4(-3.306e-02h, -4.710e-03h, 1.636e-01h, 4.672e-02h, 1.131e-01h, 2.906e-02h, -6.813e-02h, -7.225e-03h, -2.967e-02h, -1.007e-01h, 2.268e-02h, -1.861e-02h, -6.798e-02h, 5.887e-02h, 2.688e-02h, -1.170e-05h), r2);
	r0 = MulAdd(s0_1_0, half4x4(6.728e-02h, 3.510e-02h, 2.658e-02h, 2.512e-01h, -3.088e-01h, -1.993e-01h, 2.953e-01h, -2.033e-01h, 2.062e-01h, 1.665e-02h, 1.870e-01h, -2.065e-01h, -3.763e-01h, -2.050e-01h, -1.891e-02h, -5.449e-01h), r0);
	r1 = MulAdd(s0_1_0, half4x4(3.610e-01h, 5.925e-01h, 2.751e-02h, -2.362e-02h, 6.179e-01h, -2.047e-01h, -7.985e-02h, -3.896e-01h, 2.502e-02h, 5.250e-01h, -7.937e-03h, -3.707e-01h, -4.750e-01h, -1.274e-01h, 1.043e-01h, 6.493e-01h), r1);
	r2 = MulAdd(s0_1_0, half4x4(-8.045e-02h, -4.278e-01h, -3.148e-01h, 1.371e-02h, 4.091e-02h, 7.419e-02h, -1.184e-01h, -8.461e-02h, 8.302e-03h, 3.290e-02h, -1.579e-01h, 1.514e-01h, -3.994e-02h, 1.810e-01h, -2.520e-01h, 7.419e-02h), r2);
	r0 = MulAdd(s0_1_1, half4x4(3.134e-01h, 3.896e-01h, 7.740e-01h, 7.747e-01h, 3.455e-02h, 1.452e-01h, 2.454e-02h, 5.856e-02h, -8.463e-02h, 2.719e-02h, 3.138e-02h, 1.391e-01h, 1.401e-01h, 2.224e-02h, 5.334e-02h, -1.340e-01h), r0);
	r1 = MulAdd(s0_1_1, half4x4(2.838e-01h, 5.138e-01h, 3.291e-01h, 3.940e-01h, 1.003e-01h, 1.362e-01h, 1.313e-01h, 9.639e-02h, 2.783e-01h, -5.034e-01h, -6.909e-02h, -3.842e-01h, 1.153e-01h, 2.969e-01h, -4.680e-02h, 8.920e-01h), r1);
	r2 = MulAdd(s0_1_1, half4x4(3.780e-01h, -4.150e-01h, 5.874e-01h, 4.346e-01h, -5.301e-03h, -6.339e-01h, 1.921e-01h, -1.519e-01h, -5.744e-02h, 2.906e-02h, 4.541e-01h, -1.083e-01h, 3.193e-01h, -1.175e-01h, -1.372e-01h, 3.318e-01h), r2);
	r0 = MulAdd(s0_1_2, half4x4(1.232e-01h, -3.721e-01h, 9.193e-02h, 1.525e-01h, 5.252e-01h, 2.155e-01h, 1.284e-01h, -2.804e-01h, -1.023e-01h, -2.272e-01h, -2.110e-02h, -6.227e-03h, -1.946e-02h, -9.592e-02h, -5.048e-02h, -2.675e-02h), r0);
	r1 = MulAdd(s0_1_2, half4x4(1.930e-01h, -8.656e-01h, -2.994e-01h, -2.104e-01h, 1.890e-01h, 4.542e-01h, 2.574e-02h, -1.720e-01h, -1.645e-01h, -3.407e-01h, -5.756e-02h, -1.956e-01h, 1.388e-01h, -1.445e-01h, -6.649e-02h, 2.406e-01h), r1);
	r2 = MulAdd(s0_1_2, half4x4(-1.713e-01h, -1.264e-01h, 2.701e-01h, 2.557e-02h, 1.577e-01h, 1.241e-01h, 1.909e-01h, 1.067e-01h, -2.781e-02h, 1.250e-01h, 8.625e-02h, -3.212e-02h, -4.053e-02h, -2.230e-02h, 2.453e-02h, -7.918e-03h), r2);
	r0 = MulAdd(s0_2_0, half4x4(4.534e-02h, -4.142e-02h, 8.179e-02h, -2.684e-01h, -4.161e-02h, -8.607e-02h, -5.479e-02h, 1.754e-01h, -8.713e-02h, -1.797e-02h, 4.359e-02h, -1.742e-01h, -2.398e-02h, 5.235e-02h, 5.225e-02h, 1.756e-01h), r0);
	r1 = MulAdd(s0_2_0, half4x4(-1.164e-01h, 2.328e-01h, 2.310e-01h, 1.101e-01h, 2.458e-02h, -8.798e-01h, -2.802e-01h, 5.107e-02h, -1.197e+00h, 2.584e-01h, 3.634e-02h, -4.719e-01h, 6.120e-01h, 2.479e-02h, 1.159e-01h, 4.846e-01h), r1);
	r2 = MulAdd(s0_2_0, half4x4(5.291e-02h, 1.612e-01h, -2.273e-01h, 1.439e-01h, 4.775e-01h, 1.082e-02h, -3.568e-02h, 1.408e-01h, 1.625e-01h, -1.131e-01h, -7.561e-02h, 1.519e-01h, -6.958e-03h, -2.370e-01h, 1.773e-02h, -1.732e-02h), r2);
	r0 = MulAdd(s0_2_1, half4x4(4.541e-01h, 2.469e-01h, -1.168e-02h, -3.170e-01h, -1.101e+00h, -7.643e-01h, -2.874e-01h, 2.968e-02h, 1.191e-02h, 1.177e-01h, 1.100e-03h, -8.066e-01h, 6.307e-02h, 1.023e-01h, 2.403e-02h, 2.938e-01h), r0);
	r1 = MulAdd(s0_2_1, half4x4(4.083e-01h, 2.414e-01h, 1.567e-02h, 5.885e-01h, -1.929e+00h, 2.075e-01h, 4.123e-02h, 2.607e-01h, 2.411e-01h, 3.928e-02h, -8.402e-02h, -4.086e-01h, 1.313e-01h, -6.640e-03h, 1.242e-01h, 4.443e-01h), r1);
	r2 = MulAdd(s0_2_1, half4x4(1.621e+00h, 2.404e-01h, -3.576e-01h, 1.405e+00h, -8.027e-01h, 7.398e-01h, 6.259e-01h, -3.249e-01h, 3.969e-01h, -9.999e-02h, 2.323e-01h, 2.189e-01h, 1.142e-01h, -1.526e-01h, 1.631e-01h, 7.761e-02h), r2);
