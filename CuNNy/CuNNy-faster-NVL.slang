import bgfx;

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t0;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t0_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t1;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t2;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t3;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t3_UAV;


#define L0(x, y) half(dot(half3(0.299h, 0.587h, 0.114h), (half3)(INPUT.SampleLevel(sam, pos + float2(x, y) * pt, 0).rgb)))

[bgfx::EFFECT("CuNNy faster", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("CuNNy faster neural network 2x upscaler")]
[bgfx::FP16]
[bgfx::PASS(1, "in (1x8)")]
[bgfx::PASS_IO("INPUT", "t0, t1")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	half4 r0 = half4(-1.467e-03h, -2.492e-04h, -6.573e-04h, -6.401e-04h);
	half4 r1 = half4(-4.736e-03h, 7.443e-03h, 2.352e-03h, -8.863e-04h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	r0 = mad(s0_0_0, half4(-3.649e-02h, 6.494e-03h, 6.929e-03h, -1.320e-02h), r0);
	r1 = mad(s0_0_0, half4(-2.453e-01h, 2.722e-02h, -7.841e-02h, -8.301e-01h), r1);
	r0 = mad(s0_0_1, half4(-5.663e-02h, 2.213e-03h, -9.981e-03h, 7.036e-03h), r0);
	r1 = mad(s0_0_1, half4(-2.193e-01h, 5.934e-04h, -3.767e-02h, -6.469e-02h), r1);
	r0 = mad(s0_0_2, half4(-5.772e-02h, -7.180e-03h, 4.832e-03h, -4.077e-03h), r0);
	r1 = mad(s0_0_2, half4(3.104e-02h, 3.213e-03h, 8.831e-02h, -1.925e-02h), r1);
	r0 = mad(s0_1_0, half4(-1.444e-01h, 2.094e-03h, -8.605e-01h, -3.923e-02h), r0);
	r1 = mad(s0_1_0, half4(1.032e-01h, 4.432e-02h, 3.857e-01h, 8.655e-01h), r1);
	r0 = mad(s0_1_1, half4(7.103e-01h, 8.262e-01h, 8.574e-01h, 6.191e-01h), r0);
	r1 = mad(s0_1_1, half4(8.105e-01h, -8.463e-02h, -5.097e-01h, 4.015e-02h), r1);
	r0 = mad(s0_1_2, half4(-8.078e-02h, -1.313e-01h, -2.669e-04h, 3.881e-02h), r0);
	r1 = mad(s0_1_2, half4(-1.696e-01h, -3.874e-02h, 1.460e-01h, 1.208e-02h), r1);
	r0 = mad(s0_2_0, half4(-5.270e-02h, -9.660e-03h, 3.139e-03h, 5.236e-02h), r0);
	r1 = mad(s0_2_0, half4(8.130e-02h, 2.059e-01h, 1.882e-01h, -3.923e-02h), r1);
	r0 = mad(s0_2_1, half4(-1.171e-01h, -7.569e-01h, 9.770e-04h, -6.428e-02h), r0);
	r1 = mad(s0_2_1, half4(-2.483e-01h, 3.656e-02h, -2.046e-01h, 3.488e-02h), r1);
	r0 = mad(s0_2_2, half4(1.227e-02h, 6.710e-02h, -5.071e-03h, 3.497e-02h), r0);
	r1 = mad(s0_2_2, half4(-1.450e-01h, 6.362e-02h, 2.222e-02h, -1.415e-03h), r1);
	r0 = max(r0, 0.0h);
	t0_UAV[gxy] = float4(r0);
	r1 = max(r1, 0.0h);
	t1_UAV[gxy] = float4(r1);
}

#undef L0

#define L0(x, y) (half4)(t0.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L1(x, y) (half4)(t1.SampleLevel(sam, pos + float2(x, y) * pt, 0))

[bgfx::PASS(2, "conv1 (8x8)")]
[bgfx::PASS_IO("t0, t1", "t2, t3")]
[shader("compute")]
