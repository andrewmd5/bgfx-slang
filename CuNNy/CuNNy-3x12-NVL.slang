import bgfx;

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t0;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t0_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t1;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t2;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t3;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t4;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t5;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t5_UAV;


#define L0(x, y) (half3)(INPUT.SampleLevel(sam, pos + float2(x, y) * pt, 0).rgb)

[bgfx::EFFECT("CuNNy 3x12", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("CuNNy 3x12 neural network 2x upscaler")]
[bgfx::FP16]
[bgfx::PASS(1, "in (3x12)")]
[bgfx::PASS_IO("INPUT", "t0, t1, t2")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half3 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	half4 r0 = half4(-3.838e-04h, -1.473e-02h, 2.105e-04h, -1.662e-02h);
	half4 r1 = half4(-5.161e-04h, -7.702e-03h, 5.444e-04h, 5.153e-01h);
	half4 r2 = half4(-1.625e-04h, -4.639e-04h, -6.901e-05h, 1.916e-01h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half3x4(-8.004e-02h, 3.306e-02h, 2.809e-03h, 1.799e-02h, 4.088e-02h, -1.101e-01h, 1.779e-01h, -6.916e-03h, 6.212e-02h, -1.051e-01h, 8.316e-03h, -1.999e-02h), r0);
	r1 = MulAdd(s0_0_0, half3x4(-1.018e-03h, 5.281e-02h, -3.671e-03h, -9.022e-04h, 8.121e-03h, 3.896e-01h, 6.807e-03h, -2.565e-03h, -2.056e-03h, 2.885e-02h, -5.021e-03h, 6.286e-03h), r1);
	r2 = MulAdd(s0_0_0, half3x4(-6.619e-03h, -6.941e-03h, -9.951e-04h, 2.560e-03h, 1.368e-02h, -8.019e-03h, 8.860e-03h, 3.502e-02h, -1.219e-02h, -1.648e-02h, -1.284e-04h, 1.618e-02h), r2);
	r0 = MulAdd(s0_0_1, half3x4(-5.145e-02h, -8.557e-02h, 7.632e-02h, 1.667e-02h, 2.628e-02h, 4.722e-01h, 1.992e-01h, -1.234e-01h, 1.607e-02h, 1.615e-01h, -6.932e-03h, -1.517e+00h), r0);
	r1 = MulAdd(s0_0_1, half3x4(9.342e-03h, 1.045e-01h, 1.247e-02h, 2.767e-02h, -2.459e-02h, 9.835e-02h, -2.164e-02h, 6.366e-02h, 1.557e-03h, 7.984e-02h, 1.361e-02h, 1.242e-02h), r1);
	r2 = MulAdd(s0_0_1, half3x4(1.802e-01h, 2.350e-02h, -2.171e-03h, 3.287e-02h, 7.780e-01h, 1.447e-02h, -1.550e-03h, 1.412e-01h, 6.470e-02h, 5.975e-03h, -4.353e-03h, 4.922e-03h), r2);
	r0 = MulAdd(s0_0_2, half3x4(3.057e-01h, 1.163e-01h, -5.224e-02h, -4.806e-02h, -1.667e-01h, 5.029e-02h, 1.030e-01h, 2.855e-02h, -1.322e-01h, -5.030e-02h, 3.477e-02h, 4.541e-01h), r0);
	r1 = MulAdd(s0_0_2, half3x4(4.095e-03h, -1.366e-01h, 1.371e-02h, 7.380e-03h, 7.256e-03h, -3.971e-01h, -7.612e-03h, -1.147e-02h, -6.970e-03h, -1.003e-01h, -6.160e-03h, -3.729e-03h), r1);
	r2 = MulAdd(s0_0_2, half3x4(-1.672e-02h, -5.558e-04h, 1.079e-03h, -1.867e-03h, 2.246e-02h, 3.502e-02h, 4.412e-03h, 1.433e-02h, -1.110e-02h, -5.331e-03h, -2.294e-03h, -2.783e-03h), r2);
	r0 = MulAdd(s0_1_0, half3x4(-5.050e-01h, -1.129e-01h, 1.362e-01h, -1.381e-01h, 2.457e-01h, 4.098e-01h, 3.087e-01h, -1.106e-01h, 2.201e-01h, 2.176e-02h, 6.282e-02h, 2.000e-01h), r0);
	r1 = MulAdd(s0_1_0, half3x4(1.641e-02h, -2.346e-02h, 2.563e-02h, -4.359e-04h, -2.779e-02h, 6.961e-02h, -2.510e-02h, 2.655e-02h, 1.316e-02h, 8.984e-03h, -6.255e-04h, 2.326e-03h), r1);
	r2 = MulAdd(s0_1_0, half3x4(1.201e-02h, -2.015e-02h, -1.423e-02h, -3.623e-02h, -1.895e-02h, 3.178e-02h, 2.327e-02h, 6.212e-02h, 1.200e-02h, 4.885e-03h, 3.593e-03h, 8.842e-03h), r2);
	r0 = MulAdd(s0_1_1, half3x4(-8.829e-01h, 1.794e-01h, -3.974e-01h, 6.902e-02h, 4.236e-01h, -2.352e+00h, -8.976e-01h, 3.539e-01h, 4.229e-01h, 1.710e-01h, -8.174e-02h, 1.806e-01h), r0);
	r1 = MulAdd(s0_1_1, half3x4(-2.061e-01h, -1.003e-01h, -2.644e-01h, -1.278e-01h, -7.559e-01h, -9.074e-01h, -8.613e-01h, -4.990e-01h, -7.363e-02h, -1.090e-01h, -7.582e-02h, -2.663e-02h), r1);
	r2 = MulAdd(s0_1_1, half3x4(-1.855e-01h, -3.328e-01h, 2.014e-02h, -1.061e-01h, -7.715e-01h, -1.080e+00h, -3.037e-02h, -6.953e-01h, -6.446e-02h, -8.815e-02h, 1.773e-03h, -3.069e-02h), r2);
	r0 = MulAdd(s0_1_2, half3x4(4.815e-01h, -9.921e-02h, 9.823e-02h, -2.057e-03h, -2.357e-01h, 3.492e-01h, -2.543e-01h, 2.569e-02h, -2.200e-01h, -9.123e-02h, -3.606e-02h, 1.597e-02h), r0);
	r1 = MulAdd(s0_1_2, half3x4(1.336e-02h, 1.433e-02h, 2.036e-01h, 1.491e-02h, -2.435e-02h, 4.806e-01h, 9.176e-01h, 3.480e-02h, 2.033e-02h, 5.692e-02h, 7.300e-02h, 1.008e-02h), r1);
	r2 = MulAdd(s0_1_2, half3x4(3.352e-03h, 3.727e-02h, 2.577e-03h, 3.610e-02h, -1.435e-02h, -2.008e-02h, 1.104e-03h, -6.423e-03h, 1.849e-02h, 1.964e-02h, 1.142e-03h, -1.254e-04h), r2);
	r0 = MulAdd(s0_2_0, half3x4(9.755e-02h, 7.786e-02h, 4.177e-02h, 3.039e-02h, -5.141e-02h, 1.119e-01h, 1.274e-01h, 4.471e-03h, -2.445e-02h, -1.436e-02h, 2.118e-02h, -6.314e-02h), r0);
	r1 = MulAdd(s0_2_0, half3x4(-6.104e-03h, -6.230e-02h, -6.457e-03h, -2.358e-03h, 5.778e-03h, -2.301e-01h, 6.849e-03h, -1.679e-02h, -4.539e-03h, -1.902e-02h, -6.001e-04h, -1.960e-03h), r1);
	r2 = MulAdd(s0_2_0, half3x4(2.637e-03h, 3.330e-01h, 2.302e-01h, 3.634e-02h, -9.790e-04h, 1.051e+00h, 7.835e-01h, 7.599e-02h, -1.271e-03h, 7.008e-02h, 7.817e-02h, 5.323e-03h), r2);
	r0 = MulAdd(s0_2_1, half3x4(-1.597e-01h, -4.237e-02h, -2.068e-02h, 1.278e-02h, 7.768e-02h, -2.273e-02h, 1.392e-01h, 1.641e-02h, 8.793e-02h, -3.311e-02h, 4.318e-03h, -2.049e-02h), r0);
	r1 = MulAdd(s0_2_1, half3x4(1.882e-01h, 4.531e-02h, 1.395e-02h, 5.440e-02h, 7.944e-01h, -3.128e-02h, -2.484e-02h, 7.494e-02h, 6.330e-02h, 6.745e-04h, 3.291e-03h, 1.395e-02h), r1);
	r2 = MulAdd(s0_2_1, half3x4(4.550e-03h, -5.659e-02h, -2.260e-01h, -7.046e-03h, -6.486e-03h, -1.208e-02h, -7.871e-01h, 1.704e-01h, 2.202e-03h, 4.179e-02h, -8.120e-02h, 1.672e-02h), r2);
	r0 = MulAdd(s0_2_2, half3x4(2.425e-01h, 2.374e-02h, -2.404e-02h, 1.450e-02h, -1.131e-01h, 1.969e-02h, 8.958e-02h, -1.023e-01h, -1.361e-01h, -2.301e-02h, -4.773e-02h, 4.883e-02h), r0);
	r1 = MulAdd(s0_2_2, half3x4(-1.753e-02h, 9.386e-02h, 4.877e-03h, 2.227e-03h, 1.747e-02h, 5.314e-01h, 6.404e-03h, -3.009e-02h, -1.093e-02h, 5.469e-02h, -1.424e-03h, -7.789e-03h), r1);
	r2 = MulAdd(s0_2_2, half3x4(5.474e-03h, 1.939e-02h, -1.011e-02h, 9.980e-03h, 9.453e-04h, -1.498e-02h, -2.597e-03h, 6.000e-02h, -8.301e-03h, -3.578e-02h, 3.540e-03h, -9.692e-03h), r2);
	r0 = max(r0, 0.0h);
	t0_UAV[gxy] = float4(r0);
	r1 = max(r1, 0.0h);
	t1_UAV[gxy] = float4(r1);
	r2 = max(r2, 0.0h);
	t2_UAV[gxy] = float4(r2);
}

#undef L0

#define L0(x, y) (half4)(t0.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L1(x, y) (half4)(t1.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L2(x, y) (half4)(t2.SampleLevel(sam, pos + float2(x, y) * pt, 0))

[bgfx::PASS(2, "conv1 (12x12)")]
[bgfx::PASS_IO("t0, t1, t2", "t3, t4, t5")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half4 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2, s1_0_0, s1_0_1, s1_0_2, s1_1_0, s1_1_1, s1_1_2, s1_2_0, s1_2_1, s1_2_2;
	half4 r0 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r1 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r2 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	s1_0_0 = L1(-1.0, -1.0); s1_0_1 = L1(0.0, -1.0); s1_0_2 = L1(1.0, -1.0);
	s1_1_0 = L1(-1.0, 0.0); s1_1_1 = L1(0.0, 0.0); s1_1_2 = L1(1.0, 0.0);
	s1_2_0 = L1(-1.0, 1.0); s1_2_1 = L1(0.0, 1.0); s1_2_2 = L1(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half4x4(9.525e-02h, 1.266e-02h, 3.445e-03h, 7.378e-03h, 1.958e-02h, 2.888e-02h, -3.022e-04h, -4.919e-02h, 1.474e-02h, 5.379e-02h, 2.465e-02h, -2.110e-02h, 1.007e-01h, 4.968e-02h, 7.625e-03h, -2.355e-02h), r0);
	r1 = MulAdd(s0_0_0, half4x4(-5.259e-02h, -3.138e-02h, 1.081e-01h, -1.583e-01h, -8.368e-02h, 1.400e-01h, -5.287e-02h, 5.207e-02h, -8.263e-02h, 5.925e-02h, -6.862e-02h, 2.268e-01h, 8.502e-02h, -1.662e-02h, 4.158e-02h, 1.310e-02h), r1);
	r2 = MulAdd(s0_0_0, half4x4(6.493e-03h, 1.380e-02h, 3.747e-03h, -2.227e-02h, 1.202e-02h, -1.451e-04h, 2.250e-02h, 3.513e-02h, 2.935e-02h, 3.707e-02h, 2.023e-02h, 5.505e-02h, -5.075e-02h, 3.709e-03h, -9.123e-02h, 3.416e-02h), r2);
	r0 = MulAdd(s0_0_1, half4x4(-1.232e-02h, 4.537e-02h, 8.322e-03h, -2.819e-02h, -7.270e-02h, -1.638e-01h, 7.426e-03h, 4.253e-02h, -2.711e-01h, -6.879e-02h, 4.308e-02h, 3.822e-03h, -4.461e-02h, -4.596e-02h, -1.255e-02h, 2.594e-02h), r0);
	r1 = MulAdd(s0_0_1, half4x4(-1.456e-01h, 8.759e-02h, -1.232e-01h, 1.440e-01h, -9.656e-02h, -8.897e-02h, 9.890e-02h, -8.393e-01h, 8.269e-02h, -8.710e-02h, 2.890e-01h, 4.217e-01h, 4.398e-02h, 2.851e-02h, -5.137e-03h, 1.096e-02h), r1);
	r2 = MulAdd(s0_0_1, half4x4(5.458e-02h, -2.263e-02h, -5.579e-02h, 3.635e-02h, 1.768e-01h, 3.603e-02h, 1.203e-02h, 2.682e-02h, 7.902e-02h, 8.412e-03h, 3.872e-01h, 8.573e-02h, 7.203e-02h, -8.531e-03h, -2.039e-01h, 7.960e-02h), r2);
	r0 = MulAdd(s0_0_2, half4x4(-9.491e-02h, -1.431e-02h, 1.541e-02h, 7.125e-03h, -2.342e-01h, -5.845e-02h, -3.911e-02h, 1.345e-02h, -6.537e-02h, -2.341e-03h, -1.913e-02h, -7.491e-02h, -2.823e-02h, -7.889e-04h, 2.246e-03h, -2.572e-02h), r0);
	r1 = MulAdd(s0_0_2, half4x4(3.182e-02h, -1.205e-01h, -8.174e-02h, 9.559e-02h, -4.225e-03h, 8.761e-03h, 9.877e-02h, -4.413e-03h, 9.772e-02h, -5.354e-02h, -1.508e-01h, 1.507e-02h, -1.111e-01h, -5.514e-03h, -1.764e-02h, -4.508e-02h), r1);
	r2 = MulAdd(s0_0_2, half4x4(-8.983e-02h, 9.532e-03h, 6.249e-02h, 1.644e-02h, -1.396e-01h, -3.630e-02h, -3.226e-01h, -8.937e-02h, 3.096e-02h, -2.228e-02h, 6.260e-02h, 2.801e-02h, -2.691e-02h, -1.946e-02h, 3.042e-01h, 6.429e-02h), r2);
	r0 = MulAdd(s0_1_0, half4x4(4.774e-02h, -2.753e-03h, 3.733e-02h, 5.234e-02h, 2.063e-01h, 6.343e-02h, -2.685e-02h, -2.345e-02h, -1.343e-01h, -1.969e-01h, 1.783e-02h, 4.953e-02h, 1.283e-01h, -1.768e-02h, 6.969e-03h, -3.803e-02h), r0);
	r1 = MulAdd(s0_1_0, half4x4(-6.848e-02h, 1.805e-01h, -3.072e-01h, 8.786e-02h, -4.533e+00h, -2.733e-01h, 9.678e-02h, -7.903e-02h, 6.315e-01h, -2.436e-01h, 6.929e-02h, 2.639e-03h, 4.882e-02h, 8.620e-03h, -1.157e-02h, 2.297e-01h), r1);
