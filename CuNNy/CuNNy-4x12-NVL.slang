import bgfx;

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t0;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t0_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t1;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t2;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t3;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t4;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
Texture2D t5;
[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> t5_UAV;


#define L0(x, y) (half3)(INPUT.SampleLevel(sam, pos + float2(x, y) * pt, 0).rgb)

[bgfx::EFFECT("CuNNy 4x12", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("CuNNy 4x12 neural network 2x upscaler")]
[bgfx::FP16]
[bgfx::PASS(1, "in (3x12)")]
[bgfx::PASS_IO("INPUT", "t0, t1, t2")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half3 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	half4 r0 = half4(2.371e-02h, 1.429e-03h, -1.518e-03h, -1.126e-03h);
	half4 r1 = half4(-8.419e-01h, -3.915e-04h, 7.733e-04h, 1.825e-07h);
	half4 r2 = half4(-3.869e-02h, 5.169e-03h, -1.235e-04h, -4.538e-04h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half3x4(-7.386e-03h, -5.469e-02h, 1.746e-02h, -7.538e-02h, -4.545e-02h, -4.873e-01h, -4.916e-02h, -1.283e-01h, -2.024e-03h, -3.993e-02h, 5.444e-03h, 2.504e-01h), r0);
	r1 = MulAdd(s0_0_0, half3x4(-7.243e-02h, 5.732e-04h, 1.089e-01h, 2.781e-02h, -6.259e-02h, 1.818e-03h, 5.067e-01h, -1.359e-03h, 3.032e-02h, -5.970e-03h, -7.168e-03h, -4.071e-03h), r1);
	r2 = MulAdd(s0_0_0, half3x4(-3.235e-03h, -8.249e-03h, 5.048e-03h, 2.856e-03h, 1.328e-02h, 5.994e-02h, 2.688e-02h, -9.917e-03h, -7.008e-03h, 1.200e-02h, -5.993e-05h, 1.259e-02h), r2);
	r0 = MulAdd(s0_0_1, half3x4(-4.481e-02h, -4.577e-02h, -2.425e-01h, 8.612e-02h, -1.968e-01h, 2.938e-02h, -9.121e-01h, -7.690e-02h, -1.899e-02h, 3.110e-03h, -1.540e-01h, -1.780e+00h), r0);
	r1 = MulAdd(s0_0_1, half3x4(-1.152e-01h, 1.819e-02h, 1.569e-02h, 2.558e-01h, -6.440e-02h, -3.147e-02h, 5.094e-02h, 8.379e-01h, -8.025e-02h, 9.843e-03h, 1.203e-02h, 7.306e-02h), r1);
	r2 = MulAdd(s0_0_1, half3x4(-1.968e-03h, -2.847e-03h, -4.148e-03h, -2.091e-01h, -6.473e-03h, 9.986e-03h, 4.125e-02h, -8.573e-01h, 6.614e-03h, -3.453e-02h, 2.267e-03h, -6.174e-02h), r2);
	r0 = MulAdd(s0_0_2, half3x4(-4.561e-03h, 6.066e-02h, 2.461e-01h, -6.254e-02h, -3.035e-02h, 1.289e-01h, 8.730e-01h, -9.420e-03h, -7.786e-04h, 1.935e-02h, 1.362e-01h, 3.951e-01h), r0);
	r1 = MulAdd(s0_0_2, half3x4(1.164e+00h, -5.721e-04h, -2.677e-02h, -2.235e-02h, 5.593e-01h, 1.732e-02h, 3.845e-02h, 2.547e-02h, 1.626e-01h, -1.258e-02h, -1.786e-02h, -6.332e-03h), r1);
	r2 = MulAdd(s0_0_2, half3x4(-5.411e-03h, -1.579e-02h, 6.164e-05h, 3.549e-03h, -1.140e-03h, -7.766e-02h, -1.922e-02h, -2.055e-02h, -3.550e-03h, 1.331e-02h, 1.014e-03h, -1.736e-03h), r2);
	r0 = MulAdd(s0_1_0, half3x4(-5.236e-02h, -1.606e-01h, -1.882e-02h, 6.696e-03h, -1.711e-01h, -3.822e-01h, 4.992e-02h, 9.131e-02h, -2.025e-02h, -2.197e-02h, -9.928e-03h, 4.434e-02h), r0);
	r1 = MulAdd(s0_1_0, half3x4(7.801e-04h, 1.954e-03h, -1.577e-01h, -2.695e-01h, -9.303e-03h, -8.061e-03h, -6.738e-01h, -8.372e-01h, 2.277e-03h, 4.330e-03h, 2.384e-02h, -9.592e-02h), r1);
	r2 = MulAdd(s0_1_0, half3x4(4.204e-02h, 4.112e-02h, -6.321e-03h, -9.850e-03h, 8.119e-02h, -4.919e-02h, 5.286e-03h, 2.945e-03h, 1.587e-02h, -4.608e-03h, 6.811e-03h, -9.825e-03h), r2);
	r0 = MulAdd(s0_1_1, half3x4(1.547e-01h, 1.787e-01h, 2.570e-01h, -1.229e-02h, 7.285e-01h, 6.604e-01h, 8.773e-01h, 1.478e-01h, 5.629e-02h, 6.842e-02h, 1.870e-01h, 2.441e-01h), r0);
	r1 = MulAdd(s0_1_1, half3x4(-5.694e-02h, -1.830e-01h, 2.021e-02h, -1.896e-02h, -5.155e-02h, -8.613e-01h, 5.923e-02h, -2.199e-02h, -4.334e-02h, -5.851e-02h, -2.120e-02h, 4.841e-02h), r1);
	r2 = MulAdd(s0_1_1, half3x4(5.260e-02h, 3.307e-02h, 1.349e-01h, 2.220e-01h, 3.151e-01h, 3.018e-01h, 5.776e-01h, 8.574e-01h, 2.537e-02h, 6.137e-02h, 4.454e-02h, 4.895e-02h), r2);
	r0 = MulAdd(s0_1_2, half3x4(-1.901e-02h, -3.397e-04h, -2.533e-01h, 6.013e-02h, -2.369e-02h, 9.543e-02h, -8.429e-01h, 1.395e-02h, 2.221e-03h, -9.763e-03h, -1.653e-01h, -8.905e-02h), r0);
	r1 = MulAdd(s0_1_2, half3x4(-2.009e-01h, 1.782e-01h, 1.372e-02h, -3.673e-03h, -2.411e-01h, 8.752e-01h, -2.155e-02h, 1.346e-02h, -2.332e-02h, 4.865e-02h, -5.773e-03h, 1.563e-03h), r1);
	r2 = MulAdd(s0_1_2, half3x4(2.545e-03h, -2.133e-01h, -2.288e-02h, -7.434e-03h, 7.792e-02h, -8.770e-01h, -7.027e-02h, 2.110e-02h, 3.652e-03h, 5.824e-02h, -2.055e-02h, 8.632e-03h), r2);
	r0 = MulAdd(s0_2_0, half3x4(-4.618e-03h, 7.533e-02h, 3.191e-04h, 2.329e-02h, -5.662e-03h, 2.104e-01h, -1.219e-02h, -5.316e-02h, 4.399e-03h, 8.012e-03h, 9.658e-03h, -4.013e-03h), r0);
	r1 = MulAdd(s0_2_0, half3x4(1.214e-02h, -4.554e-03h, 1.340e-02h, 2.632e-02h, 1.650e-02h, -7.431e-05h, -8.060e-03h, -1.084e-03h, -2.011e-02h, -4.600e-04h, -2.877e-02h, -1.232e-02h), r1);
	r2 = MulAdd(s0_2_0, half3x4(6.979e-02h, -2.692e-02h, 7.482e-03h, 6.417e-03h, 3.348e-01h, 3.505e-02h, 3.129e-02h, 5.542e-03h, -1.225e-02h, -1.401e-02h, -1.266e-03h, 8.324e-04h), r2);
	r0 = MulAdd(s0_2_1, half3x4(-1.724e-03h, 5.198e-03h, 1.529e-03h, -2.257e-02h, 3.968e-03h, 5.456e-02h, 6.396e-02h, 1.018e-01h, 1.426e-03h, -8.712e-03h, 7.497e-03h, 2.531e-02h), r0);
	r1 = MulAdd(s0_2_1, half3x4(-1.016e-03h, -1.151e-03h, -2.179e-02h, 2.617e-04h, 2.426e-03h, -2.212e-02h, 1.129e-02h, -7.126e-03h, -3.228e-02h, 2.641e-02h, -1.260e-03h, -6.232e-03h), r1);
	r2 = MulAdd(s0_2_1, half3x4(-2.182e-01h, 3.730e-02h, -2.093e-02h, -1.364e-02h, -1.346e+00h, 1.938e-01h, -4.649e-02h, 5.817e-03h, -3.633e-02h, -2.405e-02h, -1.693e-02h, 5.099e-04h), r2);
	r0 = MulAdd(s0_2_2, half3x4(1.103e-04h, -6.213e-02h, -1.111e-02h, 3.962e-03h, 7.550e-03h, -3.073e-01h, -4.484e-02h, -4.740e-02h, -9.361e-03h, -1.714e-02h, -1.528e-02h, 3.008e-02h), r0);
	r1 = MulAdd(s0_2_2, half3x4(-3.040e-02h, -9.259e-03h, -3.092e-03h, 2.860e-03h, -6.506e-03h, 2.856e-02h, -3.184e-03h, -6.592e-03h, 9.029e-03h, -1.179e-02h, 2.493e-02h, 2.025e-03h), r1);
	r2 = MulAdd(s0_2_2, half3x4(2.447e-02h, 1.106e-01h, 5.033e-03h, 4.270e-03h, 5.833e-02h, 3.534e-01h, 5.783e-03h, -7.361e-03h, -2.033e-02h, -4.764e-02h, 1.376e-02h, 2.350e-03h), r2);
	r0 = max(r0, 0.0h);
	t0_UAV[gxy] = float4(r0);
	r1 = max(r1, 0.0h);
	t1_UAV[gxy] = float4(r1);
	r2 = max(r2, 0.0h);
	t2_UAV[gxy] = float4(r2);
}

#undef L0

#define L0(x, y) (half4)(t0.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L1(x, y) (half4)(t1.SampleLevel(sam, pos + float2(x, y) * pt, 0))
#define L2(x, y) (half4)(t2.SampleLevel(sam, pos + float2(x, y) * pt, 0))

[bgfx::PASS(2, "conv1 (12x12)")]
[bgfx::PASS_IO("t0, t1, t2", "t3, t4, t5")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid : SV_DispatchThreadID)
{
	uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8))
	    + (tid.xy / 8) * 8;
	uint2 inputSize = GetInputSize();
	if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) return;
	float2 pt = GetInputPt();
	float2 pos = (float2(gxy) + 0.5) * pt;
	half4 s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2, s1_0_0, s1_0_1, s1_0_2, s1_1_0, s1_1_1, s1_1_2, s1_2_0, s1_2_1, s1_2_2;
	half4 r0 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r1 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	half4 r2 = half4(0.0h, 0.0h, 0.0h, 0.0h);
	s0_0_0 = L0(-1.0, -1.0); s0_0_1 = L0(0.0, -1.0); s0_0_2 = L0(1.0, -1.0);
	s0_1_0 = L0(-1.0, 0.0); s0_1_1 = L0(0.0, 0.0); s0_1_2 = L0(1.0, 0.0);
	s0_2_0 = L0(-1.0, 1.0); s0_2_1 = L0(0.0, 1.0); s0_2_2 = L0(1.0, 1.0);
	s1_0_0 = L1(-1.0, -1.0); s1_0_1 = L1(0.0, -1.0); s1_0_2 = L1(1.0, -1.0);
	s1_1_0 = L1(-1.0, 0.0); s1_1_1 = L1(0.0, 0.0); s1_1_2 = L1(1.0, 0.0);
	s1_2_0 = L1(-1.0, 1.0); s1_2_1 = L1(0.0, 1.0); s1_2_2 = L1(1.0, 1.0);
	r0 = MulAdd(s0_0_0, half4x4(1.163e-01h, 1.156e-01h, 1.457e-01h, -6.471e-02h, -1.618e-02h, 9.700e-02h, -1.586e-01h, 1.539e-02h, 1.924e-02h, 1.621e-02h, -1.343e-01h, -4.331e-02h, 5.127e-03h, 8.125e-02h, -1.768e-02h, 1.399e-02h), r0);
	r1 = MulAdd(s0_0_0, half4x4(4.747e-02h, -1.428e-01h, -3.318e-01h, 4.421e-02h, -9.593e-03h, 9.177e-02h, 5.804e-02h, -2.659e-03h, -8.757e-03h, 2.132e-01h, 1.320e-01h, -5.020e-02h, -1.620e-03h, -7.543e-02h, -1.298e-01h, -1.489e-02h), r1);
	r2 = MulAdd(s0_0_0, half4x4(2.494e-01h, 3.677e-01h, 8.672e-02h, 1.938e-02h, -6.616e-02h, -2.685e-02h, -1.523e-01h, -4.285e-02h, 5.086e-02h, -6.759e-02h, 8.454e-02h, 2.415e-03h, -2.521e-02h, 8.552e-02h, -1.935e-02h, -3.447e-02h), r2);
	r0 = MulAdd(s0_0_1, half4x4(2.002e-02h, 2.456e-01h, 4.244e-01h, -1.283e-01h, 6.184e-03h, 2.605e-01h, 2.199e-01h, -2.072e-02h, 2.171e-03h, -1.605e-01h, 4.502e-02h, -2.313e-02h, -4.377e-02h, 1.323e-01h, -8.970e-02h, 2.607e-02h), r0);
	r1 = MulAdd(s0_0_1, half4x4(7.455e-02h, -3.308e-01h, -6.099e-01h, 9.643e-02h, 2.136e-02h, -1.195e-01h, -3.679e-02h, -8.183e-02h, -1.535e-02h, 8.867e-02h, 1.545e-01h, -2.720e-02h, -1.320e-02h, -1.139e-01h, -4.386e-02h, 2.701e-02h), r1);
	r2 = MulAdd(s0_0_1, half4x4(-6.660e-01h, -3.999e-01h, -5.881e-02h, -3.469e-01h, -7.218e-02h, -4.373e-02h, -3.779e-01h, -1.317e-01h, 4.652e-02h, 2.815e-03h, 1.035e-03h, 2.925e-02h, -9.762e-02h, -8.644e-03h, -8.729e-02h, -3.912e-02h), r2);
	r0 = MulAdd(s0_0_2, half4x4(-1.642e-01h, -1.925e-01h, 1.791e-01h, 4.927e-02h, 2.007e-02h, 1.683e-01h, -2.002e-01h, 6.172e-04h, -3.581e-04h, -6.771e-02h, 1.810e-01h, -4.235e-03h, 1.902e-02h, 7.933e-02h, 1.135e-01h, -1.783e-02h), r0);
	r1 = MulAdd(s0_0_2, half4x4(-6.026e-02h, -2.214e-01h, 2.219e-01h, -2.853e-02h, 5.208e-02h, -4.546e-02h, 9.622e-03h, -1.328e-02h, -7.084e-03h, 4.145e-03h, 5.873e-02h, -1.877e-02h, 1.708e-02h, 1.208e-01h, -1.322e-02h, 5.464e-02h), r1);
	r2 = MulAdd(s0_0_2, half4x4(-1.215e-01h, -8.505e-02h, 2.639e-01h, -3.397e-01h, -6.812e-02h, -1.726e-02h, -2.596e-01h, -1.450e-01h, 1.194e-02h, 3.039e-02h, -8.624e-02h, 5.425e-02h, 3.149e-02h, 1.806e-02h, 1.849e-01h, 8.528e-03h), r2);
	r0 = MulAdd(s0_1_0, half4x4(-5.927e-02h, -2.056e-01h, -7.717e-02h, 1.800e-01h, -2.715e-02h, -8.305e-02h, 1.303e-01h, -1.972e-02h, 7.263e-02h, 1.587e-01h, -2.244e+00h, -4.746e-02h, -3.545e-02h, -1.343e-01h, 4.560e-02h, 1.635e-02h), r0);
	r1 = MulAdd(s0_1_0, half4x4(6.715e-02h, -2.241e-01h, -3.088e-01h, -8.333e-02h, -3.748e-02h, 5.220e-02h, 9.541e-02h, -4.337e-02h, 4.700e-02h, 1.081e-01h, -1.407e-01h, 1.372e-03h, -1.445e-02h, -1.451e-01h, 8.263e-02h, -5.546e-02h), r1);
