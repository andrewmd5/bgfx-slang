// Anime4K GAN Upscaler x3 (Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 3", "INPUT_HEIGHT * 3")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex7;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex7_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex8;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex8_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex9;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex9_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex10;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex10_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex11;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex11_UAV;

[bgfx::SIZE("INPUT_WIDTH * 3", "INPUT_HEIGHT * 3")]
[format("rgba16f")]
Texture2D conv1ups;

[bgfx::SIZE("INPUT_WIDTH * 3", "INPUT_HEIGHT * 3")]
[format("rgba16f")]
RWTexture2D<float4> conv1ups_UAV;

[bgfx::SIZE("INPUT_WIDTH * 3", "INPUT_HEIGHT * 3")]
[format("rgba16f")]
Texture2D conv1ups1;

[bgfx::SIZE("INPUT_WIDTH * 3", "INPUT_HEIGHT * 3")]
[format("rgba16f")]
RWTexture2D<float4> conv1ups1_UAV;

[bgfx::EFFECT("Anime4K Upscale GAN x3 L", 3)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("GAN-based 3x upscaling filter for anime content. Large variant with high quality.")]
[bgfx::FP16]
[bgfx::PASS(1, "Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1, tex2, tex3")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;

    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();


	half3 src[4][4];
	$for(ii in Range(0, 2)) {
		$for(jj in Range(0, 2)) {
			uint i = ii * 2;
			uint j = jj * 2;
			float2 tpos = (gxy + uint2(i, j)) * inputPt;
			const half4 sr = half4(INPUT.GatherRed(sam, tpos));
			const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
			const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

			src[i][j] = half3(sr.w, sg.w, sb.w);
			src[i][j + 1] = half3(sr.x, sg.x, sb.x);
			src[i + 1][j] = half3(sr.z, sg.z, sb.z);
			src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
		}
	}

	$for(i in Range(1, 3)) {
		$for(j in Range(1, 3)) {
			uint2 destPos = gxy + uint2(i - 1, j - 1);

			bool shouldProcess = true;

			if (i != 1 || j != 1) {
				if (destPos.x >= inputSize.x || destPos.y >= inputSize.y) {
					shouldProcess = false;
				}
			}

			if (shouldProcess)
			{
			half4 result = half4(0.034235504h, 0.039522275h, -0.032817896h, -0.0031068379h);
			result = MulAdd(src[i - 1][j - 1], half3x4(-0.26345107h, 0.18636681h, 0.068192646h, 0.06335259h, -0.5026903h, -0.39884016h, -0.14562744h, -0.24653248h, -0.44533378h, 0.52169526h, -0.35453957h, 0.25303423h), result);
			result = MulAdd(src[i - 1][j], half3x4(-0.22396083h, 0.1324318h, 0.47152156h, -0.3061965h, -0.06026671h, -0.26795772h, 0.0081171375h, -0.32897332h, -0.16401465h, -0.1018444h, 0.48241594h, -0.09054633h), result);
			result = MulAdd(src[i - 1][j + 1], half3x4(0.25090155h, -0.15917313h, 0.028407926h, -0.24014995h, 0.4114972h, -0.45535553h, 0.08742311h, 0.16796699h, 0.0995656h, -0.4009339h, 0.21471445h, 0.2708967h), result);
			result = MulAdd(src[i][j - 1], half3x4(-0.16269766h, 0.16389379h, -0.12857921h, -0.1602467h, -0.16460834h, 0.15754342h, 0.46217716h, 0.20442651h, 0.0548621h, -0.018400457h, 0.38643107h, -0.29171357h), result);
			result = MulAdd(src[i][j], half3x4(-0.24035631h, -0.33344224h, -0.3904698h, -0.4168555h, -0.42237657h, 0.36649242h, 0.41396108h, -0.38945103h, -0.5806718h, 0.035621256h, 0.09171773h, -0.54301006h), result);
			result = MulAdd(src[i][j + 1], half3x4(0.15957133h, -0.035278857h, 0.1318051h, 0.6896821h, 0.18556473h, 0.16378926h, 0.32670698h, 0.2675555h, 0.08802092h, 0.41140598h, 0.05322177h, 0.5030955h), result);
			result = MulAdd(src[i + 1][j - 1], half3x4(-0.082798496h, 0.24381381h, -0.30908522h, 0.04553323h, 0.25664318h, 0.4123797h, -0.29377607h, 0.15920162h, 0.13717672h, 0.027625162h, 0.25476956h, 0.21843456h), result);
			result = MulAdd(src[i + 1][j], half3x4(0.14534818h, -0.239681h, 0.22961527h, 0.3814783h, 0.1233398h, 0.2449555h, 0.015051085h, 0.1661234h, -0.27740797h, -0.29109767h, -0.19438179h, -0.027439274h), result);
			result = MulAdd(src[i + 1][j + 1], half3x4(0.0011904882h, -0.01287622h, -0.1573707h, -0.13167281h, -0.12803882h, -0.079415865h, -0.04034391h, -0.09625339h, 0.23190106h, -0.26743674h, -0.48981485h, -0.2063946h), result);
			tex1_UAV[destPos] = result;
			
			result = half4(0.014904483h, -0.009271063h, 0.04884906h, 0.0106121525h);
			result = MulAdd(src[i - 1][j - 1], half3x4(-0.17155029h, -0.084075995h, 0.2281505h, 0.38326037h, 0.18672232h, -0.2562305h, 0.30811027h, 0.30188802h, -0.24588907h, 0.088734694h, 0.14092724h, -0.18793459h), result);
			result = MulAdd(src[i - 1][j], half3x4(-0.47514066h, 0.51882815h, 0.1561294h, -0.043147214h, -0.19554369h, 0.19514531h, -0.14636773h, 0.11425865h, -0.2772368h, 0.5388449h, 0.54875004h, -0.4526634h), result);
			result = MulAdd(src[i - 1][j + 1], half3x4(0.11270131h, 0.44642356h, -0.066219814h, 0.15781905h, 0.056682296h, 0.026522577h, 0.05600635h, -0.13799536h, 0.15637676h, -0.15661198h, 0.53794587h, 0.09693692h), result);
			result = MulAdd(src[i][j - 1], half3x4(-0.23679815h, 0.16397353h, 0.37343305h, 0.07477207h, -0.36061585h, 0.24027273h, 0.3222875h, 0.05577238h, -0.17547923h, 0.11737104h, 0.10193468h, -0.056727592h), result);
			result = MulAdd(src[i][j], half3x4(0.2335428h, -0.5571976h, 0.13586389h, -0.3443148h, 0.4537042h, -0.59349614h, -0.24114902h, 0.08669349h, 0.2881981h, -0.29106617h, -0.47775048h, 0.22723311h), result);
			result = MulAdd(src[i][j + 1], half3x4(0.006350133h, -0.28196353h, 0.22710627h, 0.30080464h, -0.3500525h, 0.09254133h, -0.48047104h, -0.30452347h, -0.077637784h, -0.11856046h, 0.07377078h, 0.44280833h), result);
			result = MulAdd(src[i + 1][j - 1], half3x4(0.2200762h, 0.3665277h, 0.043291833h, 0.21484855h, 0.15553318h, -0.035003938h, 0.14891839h, -0.29007155h, 0.23154758h, -0.2348225h, 0.48130423h, 0.00733271h), result);
			result = MulAdd(src[i + 1][j], half3x4(0.28228128h, 0.054867495h, 0.08010268h, -0.2980908h, 0.15146615h, -0.058449056h, -0.43990552h, -0.5963296h, 0.09321943h, 0.20146254h, -0.08043876h, 0.017381484h), result);
			result = MulAdd(src[i + 1][j + 1], half3x4(0.076894h, 0.16354772h, 0.25471574h, 0.24382424h, -0.15274979h, -0.19706573h, -0.30667382h, 0.523845h, 0.023073493h, 0.34462887h, -0.3384359h, 0.18867111h), result);
			tex2_UAV[destPos] = result;
			
			result = half4(-0.017981518h, -0.012223751h, -0.0033700857h, 0.013441364h);
			result = MulAdd(src[i - 1][j - 1], half3x4(-0.34360278h, -0.28731042h, -0.017787619h, 0.36802426h, 0.33655256h, -0.24784079h, 0.29148427h, 0.28857h, -0.3111454h, 0.0030706236h, -0.25914h, 0.5528963h), result);
			result = MulAdd(src[i - 1][j], half3x4(0.12459981h, -0.17094392h, -0.18776429h, 0.37819883h, 0.1320519h, 0.21927781h, -0.16188109h, 0.050895408h, -0.06871313h, 0.16754176h, 0.29934305h, 0.052247107h), result);
			result = MulAdd(src[i - 1][j + 1], half3x4(-0.016753385h, -0.0935026h, -0.3025131h, 0.029084548h, -0.17713268h, 0.23525053h, 0.015773006h, 0.5464473h, 0.49457568h, 0.03073306h, 0.18685353h, 0.28700578h), result);
			result = MulAdd(src[i][j - 1], half3x4(0.135332h, 0.07585244h, 0.05262212h, -0.15484884h, -0.13468477h, 0.5161883h, 0.10347934h, -0.37127933h, 0.12426171h, 0.48973167h, 0.19040361h, -0.24403319h), result);
			result = MulAdd(src[i][j], half3x4(-0.54557467h, 0.07250278h, 0.37912187h, 0.0044768555h, -0.47080016h, -0.4050018h, 0.64416456h, -0.58235925h, -0.28048036h, -0.32962233h, -0.28131053h, 0.022653949h), result);
			result = MulAdd(src[i][j + 1], half3x4(0.17059836h, 0.016603703h, 0.34638256h, 0.028987328h, 0.43271738h, -0.15030707h, 0.072848h, 0.1422675h, -0.23391044h, -0.12179815h, 0.37569857h, -0.056668952h), result);
			result = MulAdd(src[i + 1][j - 1], half3x4(-0.0428437h, 0.15237094h, -0.26750615h, 0.053740855h, -0.04772152h, -0.13561963h, -0.20043467h, -0.018060924h, 0.29031327h, -0.17592178h, -0.5016104h, -0.36639994h), result);
			result = MulAdd(src[i + 1][j], half3x4(0.39091983h, -0.257284h, -0.39293087h, -0.1182859h, -0.46328986h, -0.1585645h, -0.32158652h, 0.41519204h, 0.21179573h, -0.3613411h, -0.032484483h, -0.03755994h), result);
			result = MulAdd(src[i + 1][j + 1], half3x4(0.42772895h, 0.11436431h, -0.115817815h, -0.29173127h, 0.57807744h, -0.21997264h, -0.49362126h, 0.021626333h, 0.1258072h, -0.062251803h, -0.16541855h, 0.061321106h), result);
			tex3_UAV[destPos] = result;
			}
		}
	}
}

[bgfx::PASS(2, "Conv-4x3x3x24, Conv-4x1x1x40")]
[bgfx::PASS_IO("tex1, tex2, tex3", "tex4, tex5, tex6, tex7")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;

    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

	// [ a, d, g ]
	// [ b, e, h ]
	// [ c, f, i ]
	half4 a1 = half4(tex1.SampleLevel(sam, pos - inputPt, 0));
	half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
	half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
	half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
	half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
	half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
	half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
	half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
	half4 i1 = half4(tex1.SampleLevel(sam, pos + inputPt, 0));

	half4 na1 = max(-a1, half4(0));
	half4 nb1 = max(-b1, half4(0));
	half4 nc1 = max(-c1, half4(0));
	half4 nd1 = max(-d1, half4(0));
	half4 ne1 = max(-e1, half4(0));
	half4 nf1 = max(-f1, half4(0));
	half4 ng1 = max(-g1, half4(0));
	half4 nh1 = max(-h1, half4(0));
	half4 ni1 = max(-i1, half4(0));

	a1 = max(a1, half4(0));
	b1 = max(b1, half4(0));
	c1 = max(c1, half4(0));
	d1 = max(d1, half4(0));
	e1 = max(e1, half4(0));
	f1 = max(f1, half4(0));
	g1 = max(g1, half4(0));
	h1 = max(h1, half4(0));
	i1 = max(i1, half4(0));
	
	half4 a2 = half4(tex2.SampleLevel(sam, pos - inputPt, 0));
	half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
	half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
	half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
	half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
	half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
	half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
	half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
	half4 i2 = half4(tex2.SampleLevel(sam, pos + inputPt, 0));

	half4 na2 = max(-a2, half4(0));
	half4 nb2 = max(-b2, half4(0));
	half4 nc2 = max(-c2, half4(0));
	half4 nd2 = max(-d2, half4(0));
	half4 ne2 = max(-e2, half4(0));
	half4 nf2 = max(-f2, half4(0));
	half4 ng2 = max(-g2, half4(0));
	half4 nh2 = max(-h2, half4(0));
	half4 ni2 = max(-i2, half4(0));

	a2 = max(a2, half4(0));
	b2 = max(b2, half4(0));
	c2 = max(c2, half4(0));
	d2 = max(d2, half4(0));
	e2 = max(e2, half4(0));
	f2 = max(f2, half4(0));
	g2 = max(g2, half4(0));
	h2 = max(h2, half4(0));
	i2 = max(i2, half4(0));
	
	half4 a3 = half4(tex3.SampleLevel(sam, pos - inputPt, 0));
	half4 b3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
	half4 c3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
	half4 d3 = half4(tex3.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
	half4 e3 = half4(tex3.SampleLevel(sam, pos, 0));
	half4 f3 = half4(tex3.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
	half4 g3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
	half4 h3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
	half4 i3 = half4(tex3.SampleLevel(sam, pos + inputPt, 0));

	half4 na3 = max(-a3, half4(0));
	half4 nb3 = max(-b3, half4(0));
	half4 nc3 = max(-c3, half4(0));
	half4 nd3 = max(-d3, half4(0));
	half4 ne3 = max(-e3, half4(0));
	half4 nf3 = max(-f3, half4(0));
	half4 ng3 = max(-g3, half4(0));
	half4 nh3 = max(-h3, half4(0));
	half4 ni3 = max(-i3, half4(0));

	a3 = max(a3, half4(0));
	b3 = max(b3, half4(0));
	c3 = max(c3, half4(0));
	d3 = max(d3, half4(0));
	e3 = max(e3, half4(0));
	f3 = max(f3, half4(0));
	g3 = max(g3, half4(0));
	h3 = max(h3, half4(0));
	i3 = max(i3, half4(0));

	half4 conv2d_2_tf = half4(-0.077597156h, 0.024995416h, 0.0048880246h, -0.06210122h);
	conv2d_2_tf = MulAdd(a1, half4x4(0.1881249h, -0.14544061h, -0.022969106h, 0.088232316h, 0.0058642747h, -0.049336948h, -0.039974928h, 0.06410949h, -0.09211665h, -0.034005307h, -0.1095955h, 0.10930763h, -0.26397142h, 0.1384094h, 0.017342392h, -0.21376696h), conv2d_2_tf);
	conv2d_2_tf = MulAdd(b1, half4x4(-0.14526816h, -0.0639951h, 0.11742242h, -0.006982521h, -0.05208895h, 0.089485295h, -0.19564004h, -0.08121572h, -0.11621622h, 0.15375662h, -0.15378582h, 0.0596373h, 0.14132364h, -0.06385903h, 0.05449634h, -0.047440365h), conv2d_2_tf);
