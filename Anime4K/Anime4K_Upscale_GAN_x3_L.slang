[bgfx::PASS(8, "Conv-3x3x3x16")]
[bgfx::PASS_IO("INPUT, conv1ups, conv1ups1", "OUTPUT")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass8(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;

    const uint2 outputSize = GetOutputSize();
    if (gxy.x >= outputSize.x || gxy.y >= outputSize.y)
    {
        return;
    }

    float2 outputPt = GetOutputPt();
    float2 pos = (gxy + 0.5f) * outputPt;

	// [ a, d, g ]
	// [ b, e, h ]
	// [ c, f, i ]
	half4 a1 = half4(conv1ups.SampleLevel(sam, pos - outputPt, 0));
	half4 b1 = half4(conv1ups.SampleLevel(sam, pos + float2(-outputPt.x, 0), 0));
	half4 c1 = half4(conv1ups.SampleLevel(sam, pos + float2(-outputPt.x, outputPt.y), 0));
	half4 d1 = half4(conv1ups.SampleLevel(sam, pos + float2(0, -outputPt.y), 0));
	half4 e1 = half4(conv1ups.SampleLevel(sam, pos, 0));
	half4 f1 = half4(conv1ups.SampleLevel(sam, pos + float2(0, outputPt.y), 0));
	half4 g1 = half4(conv1ups.SampleLevel(sam, pos + float2(outputPt.x, -outputPt.y), 0));
	half4 h1 = half4(conv1ups.SampleLevel(sam, pos + float2(outputPt.x, 0), 0));
	half4 i1 = half4(conv1ups.SampleLevel(sam, pos + outputPt, 0));

	half4 na1 = max(-a1, half4(0));
	half4 nb1 = max(-b1, half4(0));
	half4 nc1 = max(-c1, half4(0));
	half4 nd1 = max(-d1, half4(0));
	half4 ne1 = max(-e1, half4(0));
	half4 nf1 = max(-f1, half4(0));
	half4 ng1 = max(-g1, half4(0));
	half4 nh1 = max(-h1, half4(0));
	half4 ni1 = max(-i1, half4(0));

	a1 = max(a1, half4(0));
	b1 = max(b1, half4(0));
	c1 = max(c1, half4(0));
	d1 = max(d1, half4(0));
	e1 = max(e1, half4(0));
	f1 = max(f1, half4(0));
	g1 = max(g1, half4(0));
	h1 = max(h1, half4(0));
	i1 = max(i1, half4(0));
	
	half4 a2 = half4(conv1ups1.SampleLevel(sam, pos - outputPt, 0));
	half4 b2 = half4(conv1ups1.SampleLevel(sam, pos + float2(-outputPt.x, 0), 0));
	half4 c2 = half4(conv1ups1.SampleLevel(sam, pos + float2(-outputPt.x, outputPt.y), 0));
	half4 d2 = half4(conv1ups1.SampleLevel(sam, pos + float2(0, -outputPt.y), 0));
