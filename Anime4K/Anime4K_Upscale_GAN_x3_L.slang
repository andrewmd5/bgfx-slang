[bgfx::PASS(6, "Conv-4x3x3x24, Conv-4x1x1x72")]
[bgfx::PASS_IO("tex1, tex2, tex3, tex10, tex4, tex8, tex9, tex11", "tex5, tex6, tex7")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass6(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;

    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

	// [ a, d, g ]
	// [ b, e, h ]
	// [ c, f, i ]
	half4 a1 = half4(tex1.SampleLevel(sam, pos - inputPt, 0));
	half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
	half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
	half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
	half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
	half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
	half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
	half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
	half4 i1 = half4(tex1.SampleLevel(sam, pos + inputPt, 0));

