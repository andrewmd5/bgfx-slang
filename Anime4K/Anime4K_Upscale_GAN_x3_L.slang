[shader("compute")]
[numthreads(8, 8, 1)]
void Pass3(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;

    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

	// [ a, d, g ]
	// [ b, e, h ]
	// [ c, f, i ]
	half4 a1 = half4(tex5.SampleLevel(sam, pos - inputPt, 0));
	half4 b1 = half4(tex5.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
	half4 c1 = half4(tex5.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
	half4 d1 = half4(tex5.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
