// Anime4K CNN x2 Upscaler (Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::EFFECT("Anime4K Upscale L", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("2x CNN upscaler for anime content. Large variant offers good quality with moderate performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(-0.0054077627h, -0.15644358h, 0.06612042h, 0.014728144h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.01802505h, -0.06508559h, 0.0017542128h, -0.25521114h, -0.024155967h, 0.07601142h, 0.07508073h, -0.69212615h, 0.06438325h, 0.07916419h, -0.07266247h, -0.17089996h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.18881685h, 0.063188724h, 0.08637344h, -0.20066689h, -0.22774473h, -0.10913083h, -0.048009537h, -0.27475306h, -0.15950447h, -0.027433012h, 0.030303264h, 0.018863251h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(0.19171959h, 0.028070524h, -0.09780952h, 0.057611514h, 0.26147488h, 0.07180017h, 0.09667393h, 0.008605127h, 0.011190245h, 0.040944707h, -0.025871381h, -0.011468774h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(-0.08601777h, 0.2180965h, -0.052060187h, -0.08091977h, 0.3995336h, 0.21213862h, 0.105202965h, 0.010929526h, -0.080743685h, -0.040439352h, -0.07998862h, 0.08096829h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.08608087h, -0.10902571h, 0.5245411h, 0.53331816h, -0.5507893h, 0.6141555h, 0.9744618h, 0.89056116h, 0.081408836h, 0.28096125h, 0.13647869h, 0.026274862h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(0.13985278h, -0.29691598h, -0.26792645h, -0.042485088h, 0.27941233h, -0.65306807h, -0.360506h, 0.03810829h, 0.09663724h, -0.26655033h, 0.04372338h, 0.063264176h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.18246013h, -0.070464276h, 0.04686214h, 0.059332885h, 0.16861221h, 0.022623831h, -0.09161491h, 0.07130491h, 0.15691474h, 0.095743366h, 0.059467375h, -0.009469478h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(-0.07830576h, 0.17082681h, -0.013175545h, -0.035535168h, 0.1573564h, -0.16532823h, -0.49614525h, -0.050994795h, 0.027053844h, -0.20359018h, 0.08111269h, 0.018715343h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(-0.060515754h, 0.13169582h, -0.15245132h, -0.045724656h, -0.50778043h, -0.11690067h, -0.08320143h, 0.01093529h, -0.1954136h, 0.07388989h, -0.1360143h, -0.023233788h), target1);

                half4 target2 = half4(-0.001029383h, 0.0058537456h, 0.38202196h, -0.028818231h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(0.12039797h, 0.04008252h, 0.073074624h, -0.11763173h, 0.091902h, -0.040129073h, 0.009170759h, -0.10760076h, -0.032387916h, 0.07807673h, -6.477932e-05h, 0.040181372h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(0.11585734h, -0.0078019407h, 0.063107856h, 0.09835168h, -0.029397847h, 0.12520139h, 0.078661725h, -0.12675259h, 0.05563671h, -0.058422342h, 0.01478436h, -0.08239175h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(-0.14991632h, -0.0134848505h, -0.38663143h, -0.10859369h, -0.012961176h, -0.09099144h, -0.19593886h, -0.08396245h, -0.02676463h, -0.0066295485h, 0.026225863h, -0.014788537h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(0.20830092h, -0.07655779h, 0.04518565h, 0.16015635h, 0.5536684h, 0.09759215h, -0.101477005h, -0.5042874h, 0.35608026h, -0.15335238h, 0.0796228h, -0.05107349h), target2);
                target2 = MulAdd(src[i][j], half3x4(-0.3968312h, 0.091579735h, -0.085623756h, -0.16367513h, -0.48967922h, -0.08557767h, 0.34444988h, 1.0766053h, -0.2158915h, 0.22244956h, -0.033804208h, 0.25898156h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.026278365h, 0.1678205h, -0.38981274h, 0.16932413h, -0.0146527905h, 0.65131354h, -0.08886725h, 0.07017853h, 0.012986331h, 0.029087646h, -0.034898676h, 0.040925268h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(0.07614263h, 0.015624113h, -0.054716587h, -0.04951801h, 0.016731577h, -0.08749623h, 0.07815944h, -0.015630174h, -0.08723511h, 0.077201165h, -0.12674089h, -0.08418575h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(-0.07938198h, -0.4056014h, 0.26949093h, 0.067213245h, -0.47538033h, -0.7786735h, -0.25821188h, 0.029314762h, -0.1799233h, -0.31132734h, 0.17210929h, -0.018579468h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(0.06732179h, 0.18373649h, -0.00039802346h, 0.006567155h, 0.36993378h, 0.20254396h, 0.12314272h, -0.07356931h, 0.12402926h, 0.122744165h, -0.07482636h, 0.011531308h), target2);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0)); half4 nb1 = max(-b1, half4(0)); half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0)); half4 ne1 = max(-e1, half4(0)); half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0)); half4 nh1 = max(-h1, half4(0)); half4 ni1 = max(-i1, half4(0));
    a1 = max(a1, half4(0)); b1 = max(b1, half4(0)); c1 = max(c1, half4(0));
    d1 = max(d1, half4(0)); e1 = max(e1, half4(0)); f1 = max(f1, half4(0));
    g1 = max(g1, half4(0)); h1 = max(h1, half4(0)); i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0)); half4 nb2 = max(-b2, half4(0)); half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0)); half4 ne2 = max(-e2, half4(0)); half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0)); half4 nh2 = max(-h2, half4(0)); half4 ni2 = max(-i2, half4(0));
    a2 = max(a2, half4(0)); b2 = max(b2, half4(0)); c2 = max(c2, half4(0));
    d2 = max(d2, half4(0)); e2 = max(e2, half4(0)); f2 = max(f2, half4(0));
    g2 = max(g2, half4(0)); h2 = max(h2, half4(0)); i2 = max(i2, half4(0));

    half4 target1 = half4(-0.021096209h, -0.016017085h, 0.009604813h, -0.023907887h);
    target1 = MulAdd(a1, half4x4(0.29632062h, 0.029882489h, -0.14098296h, -0.18291497h, 0.2815667h, -0.053558454h, 0.10369031h, -0.080831036h, 0.06955536h, -0.020830285h, -0.2950748h, -0.12086926h, -0.023612294h, -0.08531449h, 0.0390424h, 0.011767062h), target1);
    target1 = MulAdd(b1, half4x4(0.094862625h, 0.10448947h, -0.11741873h, 0.18871774h, 0.15733057h, 0.029140847h, 0.16012338h, 0.24601823h, -0.2918398h, 0.09956984h, 0.04739516h, 0.24494317h, -0.021442452h, 0.014309354h, -0.04935703h, 0.13617574h), target1);
    target1 = MulAdd(c1, half4x4(0.1303212h, -0.06284708h, -0.23948738h, -0.05782472h, -0.024363542h, -0.11251477h, -0.07354371h, -0.023819327h, 0.13228065h, 0.05485702h, -0.068491034h, 0.1938021h, -0.046649717h, -0.07752723h, 0.031408865h, 0.026424367h), target1);
    target1 = MulAdd(d1, half4x4(0.4484274h, 0.10068111h, -0.122855306h, -0.0649749h, 0.09444103h, 0.119198084h, -0.22159275h, 0.08555494h, -0.18764949h, -0.16276829h, 0.20377621h, 0.13764401h, -0.027324807h, 0.1294057h, 0.035147414h, 0.010751216h), target1);
    target1 = MulAdd(e1, half4x4(-0.23321865h, -0.029401073h, 0.064655h, 0.28420436h, 0.051707894h, -0.27915454h, 0.0037779005h, -0.18335588h, 0.2275033h, -0.25828046h, -0.005339017h, -0.4358691h, 0.30487007h, -0.044198595h, 0.08767978h, -0.04610031h), target1);
    target1 = MulAdd(f1, half4x4(-0.044556934h, -0.06692216h, -0.21124081h, -0.1394273h, -0.24693833h, -0.11292927h, -0.026020816h, 0.08460799h, -0.11183761h, -0.020012703h, 0.29486617h, 0.3726646h, -0.054298244h, 0.0045891847h, -0.23693855h, -0.02848257h), target1);
    target1 = MulAdd(g1, half4x4(0.04877764h, -0.011964396h, -0.08024895h, -0.12175299h, -0.015131821h, -0.048996765h, 0.10887477h, -0.053192h, 0.09514728h, 0.00918332h, -0.08621957h, -0.04674572h, -0.06000914h, -0.060330987h, 0.20702218h, -0.015094036h), target1);
    target1 = MulAdd(h1, half4x4(-0.1651207h, -0.024862131h, 0.37494823h, 0.10404018h, -0.2891288h, -0.38082635h, 0.3194514h, -0.055852838h, -0.073994h, -0.1566444h, 0.08473525h, 0.15672058h, -0.08205729h, 0.33623922h, 0.2524126h, 0.022668727h), target1);
    target1 = MulAdd(i1, half4x4(0.083043605h, -0.2989435h, -0.14887308h, 0.008989406h, 0.01214123h, -0.29387334h, 0.015363028h, -0.027485376h, 0.13046521h, 0.12814927h, -0.05615426h, -0.08612421h, -0.3833321h, 0.30930206h, 0.3397905h, 0.095533006h), target1);
    target1 = MulAdd(a2, half4x4(-0.24895187h, 0.033672538h, 0.024642626h, 0.049984645h, 0.09217451h, 0.14135426h, -0.36297384h, 0.10239864h, 0.14611131h, -0.022452299h, 0.009058074h, -0.18909958h, -0.0049156225h, 0.10530887h, -0.06942197h, -0.06450979h), target1);
    target1 = MulAdd(b2, half4x4(0.14025575h, 0.030043123h, 0.07131405h, -0.0675702h, 0.17274232h, 0.17896765h, -0.4741036h, 0.35670453h, 0.03911085h, 0.079387054h, 0.04420335h, -0.040182803h, 0.078871965h, 0.16641952h, -0.101532914h, -0.07683543h), target1);
    target1 = MulAdd(c2, half4x4(0.09527535h, -0.014889733h, 0.003928801h, -0.0144131305h, 0.16238941h, -0.073573746h, -0.18349837h, 0.057071213h, -0.056580186h, -0.048254594h, -0.02551881h, 0.13056543h, 0.15681924h, 0.11329136h, 0.026496707h, -0.15252273h), target1);
    target1 = MulAdd(d2, half4x4(-0.20110673h, -0.17727304h, 0.16747122h, -0.060028642h, -0.03426759h, 0.34928h, -0.16542526h, -0.03665969h, -0.11838656h, 0.050624777h, -0.11309917h, 0.17241085h, 0.07320429h, -0.19349192h, 0.36426768h, -0.09952723h), target1);
    target1 = MulAdd(e2, half4x4(-0.44797856h, 0.13166381h, 0.19358242h, -0.17328072h, 0.277866h, 0.2704677h, -0.3897292h, -0.09388379h, -0.11871803h, 0.059352446h, 0.02593061h, 0.1112078h, -0.44574997h, -0.20000082h, -0.06038736h, 0.11825317h), target1);
    target1 = MulAdd(f2, half4x4(0.035831098h, 0.03203473h, 0.007270905h, -0.2803515h, -0.07803025h, -0.044999845h, 0.05503914h, 0.02849373h, -0.019534718h, 0.109557584h, -0.057618562h, -0.22376212h, 0.037630744h, 0.07285683h, -0.10327242h, 0.15022281h), target1);
    target1 = MulAdd(g2, half4x4(-0.22891119h, -0.07055901h, -0.06924297h, 0.091851085h, 0.079149276h, 0.072282575h, 0.1054971h, -0.055115294h, 0.15652373h, -0.18508117h, -0.044487055h, -0.09513059h, -0.007512581h, 0.04595113h, -0.16729085h, -0.038352273h), target1);
    target1 = MulAdd(h2, half4x4(-0.33190495h, 0.024579005h, 0.3356564h, -0.24311046h, -0.12634008h, 0.08820384h, -0.028739989h, 0.0871991h, -0.011547642h, 0.07184339h, 0.098442815h, 0.13700496h, -0.0665544h, 0.18513693h, 0.0956979h, -0.15374076h), target1);
    target1 = MulAdd(i2, half4x4(0.18756114h, -0.21920492h, 0.06407122h, -0.24816798h, -0.061943263h, -0.054488074h, -0.081633896h, 0.0920547h, -0.08880129h, -0.18094197h, 0.006789256h, 0.094598h, 0.17799775h, -0.26764068h, -0.02588948h, 0.17095666h), target1);
    target1 = MulAdd(na1, half4x4(-0.17086025h, -0.035769157h, -0.11523461h, 0.20404252h, -0.0398533h, -0.19902702h, 0.0072308285h, -0.099984154h, -0.1378846h, -0.14236672h, 0.40502122h, 0.13498029h, 0.057273205h, -0.06250679h, 0.035283897h, 0.01703995h), target1);
    target1 = MulAdd(nb1, half4x4(0.12786144h, -0.23442458h, -0.047862124h, -0.12505807h, -0.23584808h, -0.064344h, 0.07848756h, 0.08764069h, 0.34468293h, -0.29927257h, -0.18664125h, -0.20938h, 0.07196786h, -0.0116679h, 0.16299239h, -0.076479614h), target1);
