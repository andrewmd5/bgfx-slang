[bgfx::EFFECT("Anime4K Upscale UL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("CNN-based upscaling filter for anime content. Ultra Large variant offers maximum quality with highest performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "conv2d_tf_UAV, conv2d_tf1_UAV, conv2d_tf2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    bool shouldProcess = true;
    $for(ii in Range(1, 3))
    {
        $for(jj in Range(1, 3))
        {
            uint i = ii;
            uint j = jj;
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            if (i != 1 || j != 1)
            {
                shouldProcess = destPos.x < inputSize.x && destPos.y < inputSize.y;
            }

            if (shouldProcess)
            {
                half4 target1 = {0.0357343h, 0.024812812h, 0.040654864h, -0.002103711h };
                target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.27576035h, -0.07072761h, -0.1630093h, -0.11306897h, 0.14765891h, -0.039999995h, 0.04671886h, -0.06138944h, 0.11445724h, 0.10989976h, 0.12772457h, 0.19654717h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.076798744h, -0.026944768h, -0.24994318h, 0.2515569h, -0.16839856h, 0.17563075h, 0.30983326h, -0.26057217h, -0.07267306h, -0.16690817h, -0.028771983h, -0.32779765h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(-0.22670166h, -0.08031973h, 0.1576897h, -0.09411961h, 0.10889907h, 0.09876773h, -0.12708376h, 0.20890583h, 0.13792023h, 0.046159253h, 0.008415701h, 0.028718324h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(0.123937644h, -0.0040695923h, 0.1577942h, -0.25086892h, -0.11906424h, 0.024612824h, 0.04019426h, -0.20309904h, -0.001790695h, -0.022292957h, -0.24705121h, -0.020513516h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.12275696h, 0.087533146h, 0.22975677h, 0.3249744h, -0.46705425h, 0.049937986h, -0.3746097h, 0.6908184h, -0.02694045h, 0.10467642h, 0.24765752h, 0.29053956h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(-0.085650265h, 0.06399875h, 0.16803174h, -0.000924935h, -0.012419805h, 0.3505107h, -0.013437306h, -0.37681264h, -0.06174721h, 0.3525594h, -0.7133205h, 0.16013019h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.2400495h, 0.08462758h, 0.025238732h, -0.019882765h, -0.09665332h, -0.030001955h, -0.10374011h, -0.2661804h, -0.1017717h, -0.04910443h, 0.102630705h, -0.01290848h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(0.13510828h, -0.09396734h, -0.30896646h, 0.13402982h, 0.7047196h, -0.09083812h, 0.29420912h, -0.30652946h, 0.089854665h, -0.04834406h, 0.017005004h, -0.22518355h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(0.28510967h, 0.04660653h, 0.24457681h, -0.21047631h, -0.12409636h, -0.5526988h, -0.1340479h, 0.2336875h, -0.048938934h, -0.31569406h, -0.021553513h, -0.084858574h), target1);
                half4 target2 = {-0.041260406h, 0.20480168h, -0.016556341h, 0.021896001h };
                target2 = MulAdd(src[i - 1][j - 1], half3x4(0.058698863h, -0.07291426h, 0.04927266h, 0.09258057h, -0.048297565h, 0.05610951h, 0.07047442h, -0.07120319h, -0.03516866h, 0.0076037147h, 0.07701455h, -0.059423756h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(-0.0055849426h, 0.26572028h, -0.21616961h, -0.042883366h, 0.04323887h, 0.04128688h, -0.1975783h, 0.15745145h, 0.017314252h, -0.26768935h, 0.080519766h, 0.021246549h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(-0.045365453h, 0.16887768h, -0.21514243h, -0.49443442h, 0.016238604h, -0.12318089h, 0.21210986h, 0.29339197h, 0.008509125h, -0.0120522h, 0.14660002h, 0.16444208h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(-0.18049234h, 0.27750164h, 0.48953623h, 0.32381085h, 0.13180427h, -0.19170003h, -0.042992454h, -0.24161138h, 0.02187773h, -0.052547548h, -0.23762631h, -0.17446616h), target2);
                target2 = MulAdd(src[i][j], half3x4(0.10295366h, -0.06758289h, 0.3209139h, -0.089126036h, 0.045649666h, 0.061549887h, -0.22704688h, 0.08373262h, 0.062346827h, -0.012463345h, -0.2679532h, -0.033193h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.028882261h, -0.41653237h, -0.55437064h, -0.23836315h, -0.10729088h, 0.056782994h, 0.2587744h, 0.3095401h, -0.057483524h, 0.2876223h, 0.21580297h, 0.07463114h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(0.014345448h, 0.05962805h, -0.2022189h, -0.08993287h, 0.070023656h, 0.08089038h, 0.114226155h, 0.0025734142h, -0.010230871h, -0.0990795h, 0.17906278h, 0.048965868h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(0.26569575h, -0.20329566h, 0.40301713h, 0.5406432h, 0.4320893h, 0.09291447h, -0.24186778h, -0.40646008h, 0.08337033h, 0.114029825h, -0.17575161h, -0.21976136h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.23839538h, -0.5789523h, -0.0655242h, -0.0007585647h, -0.58420926h, -0.0028022572h, 0.040551513h, -0.14223239h, -0.08617295h, 0.22481681h, -0.015953997h, 0.18862534h), target2);
                half4 target3 = {-0.32573584h, 0.02118458h, 0.06321103h, 0.01701115h };
                target3 = MulAdd(src[i - 1][j - 1], half3x4(0.07228457h, 0.007666297h, 0.0023270524h, -0.13672906h, -0.06545506h, -0.049757745h, 0.16956232h, 0.048654493h, 0.05838961h, 0.02529347h, -0.21557869h, -0.12801598h), target3);
                target3 = MulAdd(src[i - 1][j], half3x4(0.14399123h, 0.33404213h, 0.30544546h, -0.024566652h, -0.07515048h, -0.18194102h, -0.3067775h, -0.3386222h, -0.06924871h, 0.08277239h, 0.30782035h, 0.1812733h), target3);
                target3 = MulAdd(src[i - 1][j + 1], half3x4(-0.0034141026h, 0.03465326h, 0.13170029h, 0.19363083h, 0.07877697h, 0.12887354h, 0.31288412h, 0.039260264h, -0.14135145h, -0.21657607h, -0.08192631h, -0.016260598h), target3);
                target3 = MulAdd(src[i][j - 1], half3x4(0.2796338h, 0.3380564h, -0.2591034h, 0.053368755h, 0.017104708h, -0.18027966h, -0.083344355h, 0.29481766h, -0.088741906h, -0.03886714h, 0.15531075h, 0.34214082h), target3);
                target3 = MulAdd(src[i][j], half3x4(-0.35849893h, 0.39669302h, -0.4743166h, -0.30070198h, -0.04679741h, 0.029014967h, -0.11585943h, 0.547813h, 0.037943944h, -0.3137137h, -0.16505164h, 0.1461349h), target3);
                target3 = MulAdd(src[i][j + 1], half3x4(-0.19912307h, -0.69915354h, 0.12588218h, -0.25780293h, 0.06785873h, -0.06666295h, 0.21257555h, -0.30608517h, 0.22777h, 0.47556394h, 0.12453673h, -0.23966943h), target3);
                target3 = MulAdd(src[i + 1][j - 1], half3x4(-0.066451795h, 0.036735266h, 0.0883064h, 0.2535588h, 0.111621h, 0.026139118h, 0.02632312h, -0.37550557h, -0.026438652h, -0.042137396h, 0.026273955h, -0.24945815h), target3);
                target3 = MulAdd(src[i + 1][j], half3x4(0.550942h, -0.4508381h, 0.0018671635h, 0.21252398h, -0.10602345h, 0.13596801h, -0.0023862422h, 0.029529708h, -0.06045382h, 0.22975087h, -0.1594863h, -0.33607775h), target3);
                target3 = MulAdd(src[i + 1][j + 1], half3x4(-0.0114465775h, 0.011813566h, 0.09969644h, 0.055403743h, 0.02460606h, 0.13673273h, -0.22494976h, -0.24256726h, 0.024602994h, -0.1862818h, 0.015388349h, 0.39983493h), target3);
                conv2d_tf_UAV[destPos] = float4(target1);
                conv2d_tf1_UAV[destPos] = float4(target2);
                conv2d_tf2_UAV[destPos] = float4(target3);
            }
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x24")]
[bgfx::PASS_IO("conv2d_tf, conv2d_tf1, conv2d_tf2", "conv2d_1_tf_UAV, conv2d_1_tf1_UAV, conv2d_1_tf2_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = tid.xy;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(conv2d_tf.SampleLevel(sam, pos, 0));
    half4 f1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0)); half4 nb1 = max(-b1, half4(0)); half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0)); half4 ne1 = max(-e1, half4(0)); half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0)); half4 nh1 = max(-h1, half4(0)); half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0)); b1 = max(b1, half4(0)); c1 = max(c1, half4(0));
    d1 = max(d1, half4(0)); e1 = max(e1, half4(0)); f1 = max(f1, half4(0));
    g1 = max(g1, half4(0)); h1 = max(h1, half4(0)); i1 = max(i1, half4(0));

    half4 a2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(conv2d_tf1.SampleLevel(sam, pos, 0));
    half4 f2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0)); half4 nb2 = max(-b2, half4(0)); half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0)); half4 ne2 = max(-e2, half4(0)); half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0)); half4 nh2 = max(-h2, half4(0)); half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0)); b2 = max(b2, half4(0)); c2 = max(c2, half4(0));
    d2 = max(d2, half4(0)); e2 = max(e2, half4(0)); f2 = max(f2, half4(0));
    g2 = max(g2, half4(0)); h2 = max(h2, half4(0)); i2 = max(i2, half4(0));

    half4 a3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e3 = half4(conv2d_tf2.SampleLevel(sam, pos, 0));
    half4 f3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na3 = max(-a3, half4(0)); half4 nb3 = max(-b3, half4(0)); half4 nc3 = max(-c3, half4(0));
