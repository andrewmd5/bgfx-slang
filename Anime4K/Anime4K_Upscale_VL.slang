[bgfx::PASS(4, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("t4, t5", "t6_UAV, t7_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass4(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(t4.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(t4.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(t4.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
