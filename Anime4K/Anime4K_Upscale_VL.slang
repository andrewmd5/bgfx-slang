[bgfx::EFFECT("Anime4K Upscale VL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("2x CNN upscaler for anime content. Very Large variant offers high quality with significant performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "t0_UAV, t1_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(0.0072128535h, -0.05658625h, 0.052939568h, -0.1760861h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(0.3053028h, -0.037464816h, 0.113983095h, 0.12537485h, -0.18630321h, 0.084269725h, -0.01351514h, -0.20190673h, -0.12298384h, -0.037622184h, -0.070214555h, -0.19367279h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.41849324h, 0.099702746h, -0.04276645h, -0.047299717h, 0.20074473h, 0.14217933h, 0.15571699h, 0.19553481h, 0.21868695h, -0.053848714h, 0.016413521h, 0.14117444h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(0.030540446h, -0.052293833h, 0.0715466h, -0.31160545h, 0.07808315h, -0.16860045h, 0.032828577h, -0.2955024h, -0.110374965h, 0.04043687h, -0.014024628h, 0.058699366h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(-0.10727635h, 0.054200135h, 0.20853694h, 0.21086875h, 0.122690216h, -0.091823794h, 0.310609h, -0.01738923h, -0.0013488946h, 0.10835534h, -0.077265196h, 0.086751856h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.77150255h, 0.40530515h, -0.41257596h, -0.14367618h, 0.46888494h, 0.2650122h, -0.934199h, 0.40476102h, 0.32293493h, 0.20251967h, 0.19891106h, -0.29698747h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(-0.12505147h, -0.41904053h, -0.065798186h, 0.34075752h, 0.026240354h, -0.2977496h, 0.032647505h, -0.003566783h, 0.10290523h, -0.23417123h, -0.06014203h, 0.094735645h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.11207838h, -0.04062474h, 0.023897955h, 0.08605987h, -0.020888371h, 0.045541205h, -0.07231824h, -0.25884083h, -0.11796847h, -0.002691391h, 0.0050435597h, 0.02756291h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(0.4615728h, 0.041790638h, 0.08971143h, 0.20213957h, -0.38537467h, 0.19938901h, 0.08594364h, -0.08621994h, -0.08163473h, -0.133266h, -0.09561729h, -0.014209637h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(0.0787417h, -0.0483673h, 0.07621572h, -0.060169693h, -0.013465177h, -0.17152289h, 0.02515561h, 0.17675288h, -0.05173998h, 0.10768042h, -0.029858522h, -0.013957215h), target1);

                half4 target2 = half4(0.007717166h, -0.027800834h, 0.0795002h, 0.0053199283h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(-0.112743355h, 0.0422517h, 0.21350034h, -0.0967133h, 0.16265953h, 0.0022497h, 0.015078242h, 0.08204187h, 0.035236806h, -0.0468228h, -0.09464228h, -0.001864949h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(0.25631642h, -0.41485596h, -0.16662048h, 0.13201024h, 0.057921384h, 0.2240005h, -0.30038536h, -0.08305622h, 0.2228756h, 0.32263795h, 0.10608189h, -0.18616734h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(0.08997524h, 0.11516871h, 0.19212262h, -0.035154644h, 0.11612274h, -0.04056247h, 0.14974374h, 0.029173585h, -0.07629641h, -0.14353512h, 0.041081246h, 0.20230265h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(0.2262286h, 0.055954933h, -0.14499907h, 0.17314723h, 0.16590612h, -0.06688698h, -0.11118816h, -0.012938116h, -0.043101817h, 0.026133137h, 0.2958395h, 0.06543993h), target2);
                target2 = MulAdd(src[i][j], half3x4(-0.07311521h, -0.3041244h, -0.47978505h, -0.6350967h, -0.17432262h, 0.34965977h, 0.25399777h, -0.16590433h, -0.49957857h, 0.0549526h, -0.40869385h, -0.08780993h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(-0.3014447h, -0.00021343959h, -0.14953177h, 0.028001398h, -0.14931908h, -0.14910097h, -0.13287953h, -0.45026535h, 0.17378895h, 0.024704922h, -0.027308129h, -0.10292025h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.06732655h, -0.13119644h, 0.066014715h, 0.081011154h, -0.15154321h, 0.2407805h, 0.07733481h, 0.12312706h, 0.1741804h, 0.008495716h, -0.14125362h, -0.043644864h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(0.11465958h, 0.42001364h, 0.011069392h, 0.3203028h, -0.058801666h, -0.37830314h, -0.030540617h, 0.2245139h, -0.11310525h, -0.14845212h, 0.19957744h, 0.25789997h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.16037206h, 0.21326372h, 0.020099448h, 0.018666709h, 0.122083254h, -0.16033986h, -0.10725163h, 0.2556128h, 0.1650688h, -0.10475823h, 0.048623525h, -0.103755645h), target2);

                t0_UAV[destPos] = target1;
                t1_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("t0, t1", "t2_UAV, t3_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(t0.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(t0.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(t0.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(t0.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(t0.SampleLevel(sam, pos, 0));
    half4 f1 = half4(t0.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(t0.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(t0.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(t0.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0)); half4 nb1 = max(-b1, half4(0)); half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0)); half4 ne1 = max(-e1, half4(0)); half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0)); half4 nh1 = max(-h1, half4(0)); half4 ni1 = max(-i1, half4(0));
    a1 = max(a1, half4(0)); b1 = max(b1, half4(0)); c1 = max(c1, half4(0));
    d1 = max(d1, half4(0)); e1 = max(e1, half4(0)); f1 = max(f1, half4(0));
    g1 = max(g1, half4(0)); h1 = max(h1, half4(0)); i1 = max(i1, half4(0));

    half4 a2 = half4(t1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(t1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(t1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(t1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(t1.SampleLevel(sam, pos, 0));
    half4 f2 = half4(t1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(t1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(t1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(t1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0)); half4 nb2 = max(-b2, half4(0)); half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0)); half4 ne2 = max(-e2, half4(0)); half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0)); half4 nh2 = max(-h2, half4(0)); half4 ni2 = max(-i2, half4(0));
    a2 = max(a2, half4(0)); b2 = max(b2, half4(0)); c2 = max(c2, half4(0));
    d2 = max(d2, half4(0)); e2 = max(e2, half4(0)); f2 = max(f2, half4(0));
    g2 = max(g2, half4(0)); h2 = max(h2, half4(0)); i2 = max(i2, half4(0));

    half4 target1 = half4(-0.0216415h, 0.09015036h, -0.030761974h, -0.26541537h);
    target1 = MulAdd(a1, half4x4(-0.0056740534h, -0.21186607h, -0.18014967h, 0.118979976h, -0.0015611284h, -0.07708486h, 0.060131397h, 0.11653345h, 0.027150517h, 0.10837246h, 0.08583816h, -0.14032431h, 0.017552888h, 0.0035846964h, 0.03980114h, 0.064649396h), target1);
    target1 = MulAdd(b1, half4x4(-0.03289318h, -0.12004539h, 0.26514888h, -0.15079662h, 0.04214227h, -0.027273783h, -0.027950313h, 0.19614808h, 0.18510003h, -0.10346252h, -0.029836183h, 0.09174428h, -0.0088710375h, -0.18273513h, 0.06601674h, 0.009983851h), target1);
    target1 = MulAdd(c1, half4x4(0.08476211h, 0.043996535h, 0.056711517h, 0.009976895h, 0.07039107h, -0.024862664h, -0.059921104h, 0.046850603h, 0.04983447h, 0.04863198h, 0.21777405h, -0.0576961h, 0.045321796h, -0.0060038245h, 0.096396215h, -0.10842004h), target1);
    target1 = MulAdd(d1, half4x4(-0.15746164h, 0.041757874h, 0.035169285h, -0.1734288h, -0.24219254h, -0.13318908h, 0.2272079h, -0.02902605h, 0.07750601h, -0.1467191h, -0.12296749h, -0.07533314h, -0.07073083h, 0.17909113h, 0.04789308h, 0.17245363h), target1);
    target1 = MulAdd(e1, half4x4(0.057547905h, 0.1464685h, -0.33115456h, -0.26956198h, -0.26298407h, -0.059824817h, 0.022509675h, -0.09251868h, 0.36277944h, -0.2072429h, 0.21095088h, -0.45492023h, 0.07428653h, 0.1593302h, -0.2945834h, 0.12825087h), target1);
    target1 = MulAdd(f1, half4x4(-0.1318458h, 0.27804148h, 0.037600737h, 0.12047866h, 0.0065036337h, 0.0017241207h, 0.060497303h, -0.14786585h, -0.15149063h, 0.02731698h, 0.048886403h, -0.0025970868h, -0.026979815h, 0.07348884h, 0.015636757h, -0.107966796h), target1);
    target1 = MulAdd(g1, half4x4(-0.079988025h, -0.01626299h, 0.06517438h, 0.086406484h, -0.1484504h, 0.070595h, 0.20620634h, 0.09713373h, -0.13620836h, 0.012067949h, -0.00068703433h, -0.038030174h, 0.22300471h, -0.0012400965h, -0.014827909h, -0.08927486h), target1);
    target1 = MulAdd(h1, half4x4(0.15634936h, 0.052028038h, 0.038081627h, 0.12720168h, 0.07342066h, -0.04318368h, -0.0065998454h, 0.12109317h, -0.45398173h, 0.03666754h, -0.17773737h, 0.038516667h, -0.13009632h, -0.007457001h, -0.013938809h, 0.09776142h), target1);
    target1 = MulAdd(i1, half4x4(0.029636936h, 0.12864171h, 0.11347291h, -0.11812842h, -0.0870342h, 0.035678383h, 0.050338242h, 0.045754932h, -0.07072752h, 0.010447726h, 0.039642975h, -0.08795004h, -0.1191525h, 0.00967509h, 0.13485421h, -0.053204738h), target1);
    target1 = MulAdd(a2, half4x4(-0.011072695h, -0.09613245h, -0.09094804h, 0.028029291h, -0.04031162h, 0.15690295h, 0.25094184h, -0.21776834h, 0.06524669h, 0.06412185h, -0.052852992h, -0.08097702h, -0.039127756h, 0.036357917h, 0.104585476h, 0.25095442h), target1);
    target1 = MulAdd(b2, half4x4(-0.08328618h, -0.006246033h, 0.099708706h, -0.014916097h, 0.17727195h, 0.4369228h, 0.14760216h, 0.06707674h, 0.025167737h, -0.022487842h, -0.038962565h, 0.15380669h, 0.08125089h, 0.09844594h, 0.33538374h, -0.003161368h), target1);
    target1 = MulAdd(c2, half4x4(-0.0128195705h, -0.05475118h, -0.037705053h, -0.0012077648h, -0.17425515h, 0.091487505h, -0.12909423h, 0.0074876705h, 0.13438368h, 5.778033e-05h, 0.04563314h, -0.12185897h, -0.053612474h, -0.049824294h, -0.12851205h, 0.12856449h), target1);
    target1 = MulAdd(d2, half4x4(-0.025741795h, 0.01867236h, -0.00027440622h, 0.10502768h, 0.27042285h, -0.14947751h, 0.11143123h, 0.2575913h, -0.07414089h, -0.33919522h, -0.13194235h, -0.20088726h, 0.23121537h, -0.08197353h, 0.06693911h, 0.015411386h), target1);
    target1 = MulAdd(e2, half4x4(0.09143717h, 0.22842278h, 0.06501074h, -0.20009698h, -0.042117566h, -0.23452093h, -0.074082755h, -0.10612558h, 0.077631965h, 0.08343657h, -0.07657599h, -0.43297377h, 0.7092466h, -0.16272525h, 0.17222248h, -0.056038965h), target1);
