[bgfx::PASS(6, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("t8, t9", "t10_UAV, t11_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
