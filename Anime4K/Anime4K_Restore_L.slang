// Anime4K Restore CNN (Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::EFFECT("Anime4K Restore L", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("CNN-based image restoration filter for anime content. Large variant offers high quality with moderate performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(-0.44569078h, -0.084358215h, -0.014156722h, -0.0353374h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.27899465h, -0.14974926h, 0.6271667h, -0.04888494h, 0.2164516h, -0.47826648h, 0.09537477h, 0.16404815h, -0.009546488h, -0.24541017h, -0.20505093h, -0.11507772h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.22372562h, 0.046120282h, 0.44437107h, 0.54215515h, -0.10638798h, -0.010795577h, 0.19478157h, 0.5756847h, 0.24542068h, 0.11135218h, -0.27672207h, 0.09624475h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(0.1703517h, -0.17810228h, -0.34460765h, -0.40586865h, 0.2102622h, 0.08207581h, 0.17641851h, 0.23701222h, -0.32159516h, -0.017147528h, 0.41743183h, 0.19025058h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(0.4708481h, -0.1587934h, -0.15760423h, -0.11388875h, -0.36032093h, -0.044305246h, 0.19414884h, 0.31109568h, -0.09320259h, -0.23072109h, 0.0242641h, 0.040976923h), target1);
                target1 = MulAdd(src[i][j], half3x4(0.00951417h, 0.2746557h, -0.49743456h, 0.14564055h, 0.15047263h, 0.08832856h, -0.24360974h, -0.3517844h, -0.12219134h, 0.12957081h, 0.2876983h, 0.13303527h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(-0.12760738h, 0.16703783h, 0.04391735h, 0.34657615h, -0.26698044h, -0.096000046h, -0.46030682h, -0.38363042h, 0.3510441h, 0.2620507h, -0.30533043h, -0.32785h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.63138646h, -0.12703805h, 0.38107973h, -0.09134196h, -0.04012397h, -0.1390924h, 0.07578805h, -0.09274019h, -0.045394078h, 0.18203364h, 0.16900069h, 0.13399005h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(-0.13648264h, -0.13971807h, -0.32322997h, -0.08377875h, 0.40967095h, 0.19853555h, -0.26386982h, -0.50860924h, -0.00555831h, 0.06922444h, 0.034828495h, -0.08413197h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(0.21196735h, 0.24934316h, -0.27111465h, -0.19941513h, -0.30186844h, 0.44828892h, 0.35906994h, -0.35723612h, -0.074009515h, -0.34400147h, -0.22145566h, -0.15622428h), target1);

                half4 target2 = half4(-0.009787335h, 0.051148742h, -0.007458707h, -0.016416457h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(0.1953752h, -0.09707663h, 0.43315637h, 0.3862221h, 0.2346731h, 0.085327715h, 0.36244828h, 0.06630519h, -0.05342483h, 0.112148136h, 0.07938104h, 0.14795923h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(0.25197014h, 0.032906674h, 0.3392793h, 0.18099307h, -0.36539522h, 0.10986396h, 0.5440999h, 0.41803896h, -0.4117931h, 0.46616048h, 0.0827279h, 0.040264074h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(-0.060543116h, 0.34531194h, -0.3202978h, 0.32803985h, -0.08720925h, 0.63656414h, -0.052656054h, -0.076137036h, 0.15297869h, -0.11485237h, -0.21027736h, -0.24086118h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(-0.2044052h, 0.111065395h, -0.36082193h, -0.39179638h, 0.19812255h, -0.3797384h, 0.03176089h, -0.35085422h, 0.31697252h, -0.31267545h, -0.068170965h, -0.06266394h), target2);
                target2 = MulAdd(src[i][j], half3x4(0.0055682547h, 0.24352197h, 0.08972456h, -0.4340704h, -0.25253078h, -0.4218859h, 0.08408476h, -0.5052765h, 0.005511427h, -0.36491954h, 0.3825727h, 0.01774532h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.13323675h, -0.6641518h, -0.38277033h, 0.67553586h, -0.5879293h, -0.1286407h, 0.1355451h, 0.19463064h, -0.09206729h, 0.41892347h, 0.16736335h, -0.017109495h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(0.0627963h, 0.29361042h, 0.23339616h, -0.42217752h, 0.21872504h, -0.21531922h, -0.5016595h, 0.20158494h, 0.2814043h, -0.1474019h, 0.08778552h, 0.28085083h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(-0.009900911h, -0.42754972h, 0.02737237h, -0.17740859h, 0.541632h, -0.28397697h, -0.36375052h, -0.172693h, 0.1506882h, 0.15196925h, -0.30358136h, -0.29542333h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.3690586h, 0.19382606h, -0.040331036h, -0.14121497h, 0.121049926h, 0.54470515h, -0.23628974h, 0.20663929h, -0.34591553h, -0.14778244h, -0.23809184h, 0.12616424h), target2);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 target1 = half4(-0.02852779h, 0.027645616h, 0.06510905h, 0.029781172h);
    target1 = MulAdd(a1, half4x4(0.028458824h, 0.10831271h, 0.017246738h, 0.42066097h, 0.035127334h, 0.14161696h, 0.3893337h, 0.18358134h, -0.26446894h, -0.053199783h, 0.053528484h, -0.3486933h, -0.10270838h, -0.3593573h, 0.049874853h, 0.08600247h), target1);
    target1 = MulAdd(b1, half4x4(-0.15829772h, -0.31038332h, 0.0423391h, -0.11978196h, -0.29878524h, 0.10245719h, 0.004307728h, 0.052934717h, -0.049366333h, -0.03277819h, -0.062031534h, -0.004734159h, 0.029009456h, -0.18138678h, 0.17342477h, -0.1632741h), target1);
    target1 = MulAdd(c1, half4x4(-0.14941882h, -0.3337916h, -0.07740701h, -0.8221198h, -0.014216013h, -0.34028724h, 0.06367363h, -0.19704603h, -0.20317195h, 0.17806017h, -0.14011545h, 0.05067841h, 0.08515265h, 0.092163175h, -0.036603887h, -0.2528259h), target1);
    target1 = MulAdd(d1, half4x4(0.044333473h, 0.10871938h, -0.12288588h, 0.0077913217h, 0.013970764h, -0.21189599h, -0.0757029h, 0.055366833h, 0.04531751h, -0.20269018h, 0.038650505h, -0.09677452h, 0.0565207h, 0.073703125h, -0.10746413h, 0.22798601h), target1);
    target1 = MulAdd(e1, half4x4(0.33476707h, 0.22631067h, 0.10190012h, 0.25268495h, -0.14572862h, -0.21331434h, 0.024614803h, -0.26254398h, 0.18070522h, 0.34974626h, 0.028480766h, -0.07855834h, 0.16165797h, 0.28470036h, 0.23497322h, -0.15804033h), target1);
    target1 = MulAdd(f1, half4x4(-0.09853942h, -0.21105993h, 0.27787793h, 0.24688315h, -0.16078049h, 0.08541815h, 0.16101131h, -0.0005086922h, -0.13042259h, 0.0253011h, -0.05298311h, 0.16506846h, -0.099300735h, 0.07577514h, 0.041623414h, -0.18045023h), target1);
    target1 = MulAdd(g1, half4x4(-0.015007392h, 0.0720429h, -0.018456718h, 0.012792885h, 0.2049891h, -0.061911974h, -0.10679284h, 0.2530616h, -0.1651912h, 0.1125125h, 0.55918777h, 0.1414716h, 0.025189033h, 0.061680123h, -0.13096866h, -0.035809774h), target1);
    target1 = MulAdd(h1, half4x4(0.037606955h, 0.05987735h, -0.09903669h, 0.09681222h, 0.31857902h, -0.058445334h, 0.10280441h, -0.0018247474h, 0.051491242h, 0.12321206h, 0.14069863h, -0.013259678h, -0.198442h, 0.093920216h, -0.015952505h, -0.3040559h), target1);
    target1 = MulAdd(i1, half4x4(0.044491854h, 0.079992026h, -0.07424999h, 0.064774506h, 0.36708844h, -0.14958903h, -0.060033463h, -0.5950615h, -0.101501055h, -0.05275797h, -0.0099711865h, 0.075409986h, -0.19508216h, -0.088995665h, -0.025926083h, 0.023040347h), target1);
    target1 = MulAdd(a2, half4x4(-0.00168658h, 0.1879708h, -0.08964568h, 0.124567054h, -0.027147152h, 0.0013266837h, 0.043110568h, -0.16238526h, 0.18404783h, -0.088930264h, -0.0841814h, -0.06812457h, -0.022954177h, 0.15315148h, 0.00096489635h, 0.21262483h), target1);
    target1 = MulAdd(b2, half4x4(0.03728663h, 0.16259944h, 0.2534931h, -0.10620075h, -0.032217886h, -0.043085426h, -0.37875995h, 0.16151664h, -0.15136409h, -0.21990341h, 0.0043716h, 0.1293011h, 0.20516208h, 0.32518774h, -0.15583529h, 0.20054214h), target1);
    target1 = MulAdd(c2, half4x4(0.05088376h, -0.21300486h, 0.30702966h, 0.09044539h, 0.020740725h, 0.028916309h, 0.14391874h, 0.15526149h, 0.011289051h, -0.24014536h, -0.2176207h, 0.09995701h, 0.06747376h, -0.3315815h, 0.07900332h, -0.26542482h), target1);
    target1 = MulAdd(d2, half4x4(0.15973654h, 0.2114867h, -0.19423203h, -0.1529657h, -0.24198112h, -0.10985252h, 0.056409992h, 0.111373484h, 0.05717073h, 0.019566689h, -0.12794583h, 0.006978016h, -0.2708247h, 0.2845983h, -0.048893075h, -0.09198705h), target1);
    target1 = MulAdd(e2, half4x4(0.07690064h, 0.038431194h, 0.1205243h, 0.1320201h, -0.122893825h, -0.022761922h, -0.10097431h, 0.022808496h, -0.0431315h, 0.19884229h, -0.053464055h, -0.08487898h, 0.049651224h, 0.3001686h, -0.05545239h, 0.48026356h), target1);
    target1 = MulAdd(f2, half4x4(0.04079296h, 0.052179057h, 0.08785134h, 0.17674746h, 0.06027275h, -0.083381295h, -0.29543424h, -0.10703248h, 0.14123397h, 0.12711276h, 0.08260646h, 0.23608543h, 0.10914477h, -0.22596069h, -0.15743312h, 0.103631504h), target1);
    target1 = MulAdd(g2, half4x4(0.038997833h, -0.14136268h, -0.31973416h, 0.11666723h, -0.20137171h, 0.0115205245h, 0.22825807h, -0.14853193h, 0.25628343h, 0.06598252h, -0.003479285h, -0.12315031h, -0.07446986h, 0.29977h, 0.08878428h, 0.15130284h), target1);
    target1 = MulAdd(h2, half4x4(-0.04147214h, -0.050535224h, -0.21205503h, -0.07425368h, -0.06448227h, -0.086743675h, 0.029389668h, -0.07494379h, -0.17228132h, -0.18035689h, -0.09757749h, 0.13929781h, 0.21867155h, 0.02585289h, 0.13752261h, 0.17800835h), target1);
    target1 = MulAdd(i2, half4x4(0.20552272h, -0.03113836h, -0.201244h, -0.07602455h, 0.08278268h, -0.17029381h, -0.0008433311h, -0.11591232h, 0.087584734h, -0.026447749h, 0.09185437h, 0.15650395h, 0.29423076h, 0.016036067h, -0.17132477h, 0.09271113h), target1);
    target1 = MulAdd(na1, half4x4(0.09120441h, 0.1345777h, 0.0468555h, 0.2635145h, 0.04248785h, -0.14849417h, -0.013588658h, -0.12794739h, -0.0109574385h, -0.15350367h, 0.1872175h, -0.17311442h, 0.2740676h, 0.1931403h, 0.049231507h, -0.17728893h), target1);
    target1 = MulAdd(nb1, half4x4(0.0265621h, 0.10291274h, -0.0884961h, -0.086093664h, 0.25218308h, -0.027579704h, 0.044006765h, -0.05947863h, -0.17352693h, -0.16788955h, -0.1829588h, -0.19120377h, -0.19486824h, 0.035516337h, -0.04287895h, -0.059360266h), target1);
