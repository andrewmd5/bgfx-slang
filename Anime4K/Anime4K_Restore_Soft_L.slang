// Anime4K Restore Soft L
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::EFFECT("Anime4K Restore Soft L", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("Soft detail restoration for anime content. Large variant offers higher quality at increased cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(-0.55533427h, -0.05231614h, -0.032685343h, -0.027457517h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.2676983h, -0.1694746h, 0.7231928h, -0.050193843h, 0.1850188h, -0.4749505h, 0.07632266h, 0.17824799h, 0.026348969h, -0.213702h, -0.16420218h, -0.066780016h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.09888135h, -0.079641104h, 0.51160043h, 0.53629893h, -0.1368544h, -0.07092336h, 0.18622977h, 0.6388427h, 0.19499005h, 0.06811229h, -0.31991923h, 0.088302985h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(0.06487055h, -0.1591197h, -0.29304126h, -0.428903h, 0.1966732h, 0.11229865h, 0.089009434h, 0.23463708h, -0.22231965h, -0.008649182h, 0.3317394h, 0.10976113h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(0.40386826h, -0.09486362h, -0.058931742h, -0.1341693h, -0.28993917h, -0.09050739h, 0.28094417h, 0.31630108h, -0.02661985h, -0.24368657h, 0.096867286h, 0.05391612h), target1);
                target1 = MulAdd(src[i][j], half3x4(0.05631564h, 0.34576723h, -0.5587978h, 0.16213721h, 0.12679785h, 0.18991663h, -0.24762277h, -0.33682153h, -0.22863568h, 0.20517963h, 0.20418519h, 0.12087338h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(-0.17579688h, 0.18395603h, -0.014987654h, 0.30243605h, -0.12778279h, -0.07003458h, -0.5353068h, -0.39372426h, 0.2676877h, 0.255503h, -0.29737592h, -0.30513638h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.799834h, -0.023603538h, 0.19820727h, -0.11204286h, -0.1566225h, -0.1937577h, -0.030266436h, -0.10107911h, 0.023661222h, 0.16879195h, 0.046644643h, 0.09485681h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(-0.014675849h, -0.110290475h, -0.28381273h, -0.06814732h, 0.2067597h, 0.20925248h, -0.24068354h, -0.5096708h, -0.09384791h, 0.10593733h, 0.0672362h, -0.06924161h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(0.05908883h, 0.099426664h, -0.20916614h, -0.17044452h, -0.091960385h, 0.3218613h, 0.41635308h, -0.36125022h, -0.012630896h, -0.37540653h, 0.018497325h, -0.100674420h), target1);

                half4 target2 = half4(0.029685514h, 0.066621915h, 0.03600017h, -0.03497038h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(0.09844753h, -0.19389127h, 0.029695928h, 0.3805915h, 0.1353029h, 0.027786473h, 0.15621242h, 0.09383762h, -0.1097243h, 0.021245124h, -0.016402386h, 0.09129394h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(0.3038283h, 0.03778846h, 0.1898852h, 0.23949303h, -0.34829387h, 0.20485392h, 0.60560244h, 0.4089768h, -0.260066h, 0.42611003h, 0.19227165h, 0.03948586h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(-0.033990905h, 0.17583308h, -0.2235879h, 0.47376296h, -0.1001787h, 0.72851896h, -0.056391567h, -0.056544185h, 0.0966166h, -0.016663829h, -0.15151545h, -0.14227313h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(-0.16544957h, 0.05889452h, -0.3277256h, -0.42792717h, 0.32491356h, -0.39113912h, 0.16600312h, -0.3097514h, 0.27907088h, -0.22553465h, 0.048548058h, -0.08310438h), target2);
                target2 = MulAdd(src[i][j], half3x4(0.03992136h, 0.17895368h, 0.16562924h, -0.536188h, -0.25868654h, -0.4869832h, 0.2591772h, -0.5191932h, 0.020162001h, -0.41568524h, 0.4776641h, 0.019298514h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.14911795h, -0.5984171h, -0.18241958h, 0.5472136h, -0.69194865h, 0.033839397h, 0.13408412h, 0.09503547h, -0.21318413h, 0.53743845h, 0.080091774h, -0.1369053h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.038978565h, 0.40742934h, 0.20107205h, -0.3550106h, 0.227634h, -0.16101603h, -0.45037574h, 0.23192371h, 0.17923234h, -0.13692904h, 0.10395048h, 0.3124129h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(-0.059144646h, -0.22531863h, -0.024704054h, -0.20749553h, 0.58086175h, -0.32206532h, -0.5130457h, -0.14057957h, 0.24317528h, 0.088735096h, -0.44098017h, -0.16980846h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.30321437h, 0.17502202h, 0.1910563h, -0.10118702h, 0.1465326h, 0.3852395h, -0.31210947h, 0.18236226h, -0.23306467h, -0.28551704h, -0.2982589h, 0.072740674h), target2);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 target1 = half4(-0.045150407h, -0.034128085h, 0.10230384h, 0.074793644h);
    target1 = MulAdd(a1, half4x4(0.20989326h, 0.020975577h, -0.005522964h, -0.10013134h, 0.013517254h, -0.03347422h, 0.40903455h, 0.013940953h, 0.01066957h, 0.2569982h, -0.018764338h, -0.37931216h, -0.20921241h, -0.3565134h, 0.1776639h, 0.081515394h), target1);
    target1 = MulAdd(b1, half4x4(-0.2555968h, -0.05024504h, 0.046776827h, 0.38626888h, -0.21787676h, 0.0013136056h, -0.13391882h, 0.00022813173h, -0.042842478h, -0.10413157h, -0.008385445h, -0.11843704h, 0.062092766h, -0.40029097h, 0.31873867h, -0.19030346h), target1);
    target1 = MulAdd(c1, half4x4(-0.19435422h, -0.56006145h, 0.050693467h, -0.8857939h, -0.0677575h, -0.30498h, 0.012069988h, 0.026757652h, -0.16890685h, 0.04575225h, -0.08477036h, -0.018015383h, 0.0002810964h, 0.0772843h, 0.00017034424h, -0.228497h), target1);
    target1 = MulAdd(d1, half4x4(0.092564344h, 0.061863884h, -0.13135873h, 0.10290956h, 0.1670116h, -0.08312144h, -0.020718448h, 0.06729496h, -0.06338295h, -0.09972319h, 0.18505506h, -0.2622095h, 0.045575716h, 0.12836345h, -0.22356766h, 0.28924033h), target1);
    target1 = MulAdd(e1, half4x4(0.23605964h, 0.46831363h, 0.21037713h, 0.3901851h, -0.122640595h, -0.29213053h, 0.14194407h, -0.3353137h, 0.07847812h, 0.3094049h, -0.050705243h, -0.23498294h, 0.24583417h, 0.3703223h, 0.1121086h, 0.20645288h), target1);
    target1 = MulAdd(f1, half4x4(-0.08616125h, -0.13809866h, 0.27488732h, 0.19573413h, -0.20682202h, 0.01106275h, -0.018731792h, 0.048580807h, -0.097444884h, -0.03766069h, -0.12636039h, 0.3133589h, -0.12802023h, 0.1988174h, 0.19551867h, -0.2720954h), target1);
    target1 = MulAdd(g1, half4x4(0.03484159h, 0.05830728h, 0.028816089h, 0.27173883h, 0.15579484h, -0.07751753h, -0.033748254h, 0.22559631h, -0.35857964h, 0.1043378h, 0.5031367h, 0.031042032h, 0.071555324h, -0.24148308h, -0.24156207h, 0.104249395h), target1);
    target1 = MulAdd(h1, half4x4(0.04002337h, -0.17350379h, -0.1802324h, -0.23008482h, 0.2917599h, 0.1801853h, 0.041955303h, 0.015545025h, 0.069034904h, 0.19370675h, 0.097300164h, 0.11832116h, -0.23043779h, 0.33832225h, -0.029885143h, -0.022836795h), target1);
    target1 = MulAdd(i1, half4x4(0.040476788h, 0.3176767h, -0.2372066h, 0.24106048h, 0.28147677h, -0.06513699h, -0.22784042h, -0.46840426h, -0.23415963h, -0.067057185h, -0.013863767h, 0.30710638h, 0.06337683h, -0.1774192h, 0.05082387h, -0.02581459h), target1);
    target1 = MulAdd(a2, half4x4(-0.13767451h, 0.26832962h, 0.018361554h, 0.2665501h, -0.22070843h, 0.10799693h, 0.09780551h, 0.042999722h, 0.3302224h, 0.10916339h, -0.22705203h, 0.040675506h, -0.049211837h, 0.19487813h, 0.051528033h, 0.20227027h), target1);
    target1 = MulAdd(b2, half4x4(0.1279485h, 0.14895418h, 0.40570346h, -0.008809808h, 0.09898892h, 0.035774715h, -0.28405192h, 0.26836014h, -0.096799396h, -0.12336552h, -0.24413097h, 0.12693845h, 0.12410443h, 0.27200332h, -0.18279982h, -0.032115027h), target1);
    target1 = MulAdd(c2, half4x4(0.14698029h, -0.31720948h, 0.24974433h, 0.14444488h, 0.09503049h, -0.02618792h, 0.15163966h, 0.22923012h, -0.004227005h, -0.2564904h, -0.06648419h, -0.07868524h, -0.14852846h, -0.3513046h, -0.1374295h, -0.09808154h), target1);
    target1 = MulAdd(d2, half4x4(0.1275583h, 0.1875862h, -0.15939887h, -0.1029876h, -0.25886494h, -0.07434281h, -0.018779758h, -0.008408217h, 0.06420735h, 0.0025367932h, 0.073679835h, 0.1369152h, -0.2256255h, 0.26216295h, -0.052095387h, 0.04673847h), target1);
    target1 = MulAdd(e2, half4x4(0.1147465h, 0.14129257h, -0.036377613h, 0.041968875h, 0.031286925h, -0.00013609273h, -0.248227h, 0.10412182h, -0.00039004904h, 0.01673792h, 0.056068443h, -0.16470632h, -0.042392768h, 0.23993582h, -0.22915693h, 0.36430097h), target1);
    target1 = MulAdd(f2, half4x4(0.23650797h, 0.12200628h, 0.057768486h, 0.23353462h, 0.04389849h, -0.11567954h, -0.12633252h, -0.1884369h, -0.10636852h, -0.115114085h, -0.0022040834h, 0.041720822h, 0.20775628h, -0.1127031h, -0.060805347h, -0.10988217h), target1);
    target1 = MulAdd(g2, half4x4(0.0401325h, -0.271267h, -0.3003843h, 0.010670003h, -0.12597936h, -0.059235968h, 0.08256807h, -0.22041298h, 0.14655456h, 0.07416407h, -0.03940599h, -0.25057787h, -0.043001004h, 0.2124355h, 0.19165096h, 0.077120975h), target1);
    target1 = MulAdd(h2, half4x4(0.01693656h, -0.057261657h, -0.13366276h, -0.15589137h, -0.07157646h, -0.12266521h, 0.24651442h, -0.079142615h, -0.113005005h, -0.15769142h, -0.017285366h, 0.08821278h, 0.28891653h, 0.06013908h, 0.0038421913h, 0.106700204h), target1);
    target1 = MulAdd(i2, half4x4(0.16187043h, -0.059908718h, -0.050456535h, -0.027998367h, 0.12749411h, -0.07558445h, 0.05249467h, 0.02001542h, 0.03188715h, 0.056223337h, 0.06117334h, 0.022764465h, 0.1051409h, 0.0011876151h, -0.07030176h, -0.015487096h), target1);
    target1 = MulAdd(na1, half4x4(0.047084607h, 0.06401777h, 0.15585798h, 0.16639893h, 0.025441h, -0.020858578h, -0.07795479h, -0.0045188745h, -0.09186016h, -0.16865493h, 0.02187216h, 0.02241868h, 0.3175809h, 0.25483596h, 0.046578035h, -0.09617824h), target1);
    target1 = MulAdd(nb1, half4x4(0.08622112h, 0.124111585h, -0.15246506h, -0.072898194h, 0.26907462h, -0.15550381h, 0.036907334h, -0.16388376h, -0.10869113h, 0.113909826h, -0.118678264h, 0.013610441h, -0.1307433h, 0.044969033h, -0.053201765h, -0.058903012h), target1);
