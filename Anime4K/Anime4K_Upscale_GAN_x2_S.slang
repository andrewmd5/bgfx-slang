// Anime4K GAN Upscaler x2 (Small)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif


Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex7;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex7_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex8;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex8_UAV;

[bgfx::EFFECT("Anime4K Upscale GAN x2 S", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("2x GAN upscaler for anime content. Small variant offers good performance with moderate quality.")]
[bgfx::FP16]
[bgfx::PASS(1, "Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 result = half4(-0.035786826h, -3.2876174e-05h, -0.029245647h, 0.0141837h);
                result = MulAdd(src[i - 1][j - 1], half3x4(0.21797048h, -0.212819h, 0.04459435h, -0.04423212h, 0.33138385h, -0.17247623h, -0.120917134h, 0.23732775h, 0.19597639h, -0.33451796h, -0.021611832h, -0.017377583h), result);
                result = MulAdd(src[i - 1][j], half3x4(-0.12904494h, -0.01359655h, -0.40096298h, 0.32336384h, 0.25585845h, 0.23335338h, -0.4461792h, 0.6704216h, -0.13310009h, 0.05402756h, -0.5437191h, 0.32286412h), result);
                result = MulAdd(src[i - 1][j + 1], half3x4(0.062060427h, 0.07804567h, -0.016457668h, 0.25662076h, -0.1567372h, -0.04152728h, 0.15387323h, -0.12621297h, 0.097600766h, 0.023655256h, 0.052513056h, 0.30542207h), result);
                result = MulAdd(src[i][j - 1], half3x4(-0.18701962h, -0.4233291h, -0.086120665h, -0.16739355h, -0.63525766h, -0.6932253h, -0.1777197h, -0.5140771h, -0.19856504h, -0.4475936h, 0.12013144h, -0.11179723h), result);
                result = MulAdd(src[i][j], half3x4(-0.21761869h, 0.65340257h, 0.25189772h, -0.20664653h, 0.05614669h, 0.81569123h, 0.26439375h, -0.22282092h, -0.20241423h, 0.71137106h, 0.041106064h, -0.558707h), result);
                result = MulAdd(src[i][j + 1], half3x4(0.014729233h, -0.09996152h, 0.22300848h, -0.04927536h, -0.08988005h, -0.12005097h, -0.04899431h, -0.18048033h, -0.17237821h, -0.03483246h, 0.33783346h, 0.22711775h), result);
                result = MulAdd(src[i + 1][j - 1], half3x4(-0.010091276h, -0.11388358h, 0.15959989h, 0.16021152h, 0.353214h, -0.3420636h, 0.39659426h, 0.14725044h, 0.048077144h, -0.06667417h, 0.047712438h, 0.1991372h), result);
                result = MulAdd(src[i + 1][j], half3x4(-0.17764397h, 0.014430492h, -0.009073561h, 0.052957222h, -0.26687172h, 0.21589288h, 0.29830712h, 0.15975259h, -0.3100123h, -0.03535766h, 0.18167259h, 0.07284526h), result);
                result = MulAdd(src[i + 1][j + 1], half3x4(0.22984034h, 0.11556983h, -0.26964244h, -0.31616172h, 0.059412085h, 0.10849835h, -0.3704685h, -0.16312528h, 0.3656624h, 0.11611945h, -0.3790553h, -0.4223729h), result);

                tex1_UAV[destPos] = result;
            }
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x8, Conv-4x1x1x24")]
[bgfx::PASS_IO("tex1", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a = half4(tex1.SampleLevel(sam, pos - inputPt, 0));
    half4 b = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i = half4(tex1.SampleLevel(sam, pos + inputPt, 0));

    half4 na = max(-a, half4(0));
    half4 nb = max(-b, half4(0));
    half4 nc = max(-c, half4(0));
    half4 nd = max(-d, half4(0));
    half4 ne = max(-e, half4(0));
    half4 nf = max(-f, half4(0));
    half4 ng = max(-g, half4(0));
    half4 nh = max(-h, half4(0));
    half4 ni = max(-i, half4(0));

    a = max(a, half4(0));
    b = max(b, half4(0));
    c = max(c, half4(0));
    d = max(d, half4(0));
    e = max(e, half4(0));
    f = max(f, half4(0));
    g = max(g, half4(0));
    h = max(h, half4(0));
    i = max(i, half4(0));

    half4 conv2d_2_tf = half4(-0.041068032h, 0.02181786h, -0.02366552h, 0.07215206h);
    conv2d_2_tf = MulAdd(a, half4x4(0.02899383h, 0.12331602h, 0.1755303h, 0.14228395h, -0.23719487h, 0.28783783h, -0.15755224h, 0.16501419h, 0.09971766h, -0.112085044h, 0.15989542h, 0.013457646h, -0.21386063h, -0.10184436h, 0.2920392h, 0.11544854h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(b, half4x4(-0.09577094h, 0.052495796h, 0.5072853h, -0.16720837h, -0.030821526h, -0.13200149h, 0.061197h, 0.09785798h, 0.097248554h, -0.056709435h, -0.12684566h, 0.25153175h, 0.12550084h, 0.5723225h, -0.061046973h, 0.2737185h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(c, half4x4(0.14275773h, 0.3116807h, 0.020866666h, -0.029567914h, 0.054051064h, -0.018836629h, 0.16237853h, 0.23302408h, 0.23014219h, -0.20245266h, -0.040263597h, 0.10550008h, -0.1419676h, -0.07544839h, -0.04724355h, 0.06713984h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(d, half4x4(-0.36056906h, 0.21647012h, -0.21559654h, -0.1321654h, 0.26311335h, -0.35098836h, 0.08977303h, -0.2912846h, -0.03221502h, -0.33539286h, 0.55078757h, 0.14826211h, 0.12334663h, 0.031169238h, 0.0626983h, 0.13543329h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(e, half4x4(0.032711882h, 0.53162986h, 0.1736962h, 0.22126123h, 0.13229683h, 0.12998195h, -0.08843839h, 0.3830243h, -0.29015037h, -0.13158421h, 0.2987182h, 0.0039998284h, -0.4924434h, -0.34931743h, 0.3501415h, -0.015819922h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(f, half4x4(0.039777573h, -0.039639533h, -0.27015024h, -0.33144557h, -0.11338446h, -0.19242573h, 0.48813564h, -0.24602202h, 0.120988116h, -0.12362437h, 0.23984735h, -0.33717445h, 0.14359151h, -0.09583342h, -0.015998919h, -0.19725454h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(g, half4x4(0.17751572h, -0.14914338h, -0.24518701h, 0.22713365h, 0.10613938h, 0.12027283h, 0.1582502h, 0.011725502h, -0.02418084h, 0.106176965h, 0.10111444h, 0.07009088h, 0.017611375h, 0.369643h, -0.21788761h, -0.15093188h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(h, half4x4(0.0863035h, -0.43148708h, 0.0994751h, 0.17801163h, -0.42566994h, -0.2744198h, -0.028655952h, -0.2481176h, -0.26144302h, -0.26753834h, 0.11043684h, -0.48341632h, 0.41320416h, 0.25118062h, -0.31461874h, 0.36563694h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(i, half4x4(-0.04845539h, -0.2790916h, -0.1626853h, 0.18036526h, 0.2368911h, -0.5688802h, 0.05240968h, -0.034105603h, -0.14011742h, -0.37861058h, -0.096871816h, -0.27824572h, 0.41195226h, 0.23514003h, 0.12282304h, 0.28447765h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(na, half4x4(-0.13261828h, -0.13148594h, 0.05470859h, -0.114724025h, 0.17642413h, -0.05585294h, 0.44086194h, -0.10915775h, -0.23456413h, -0.18385538h, -0.4193869h, 0.2708079h, 0.03720121h, 0.15744475h, 0.092449814h, -0.0922205h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(nb, half4x4(-0.14146912h, 0.386554h, -0.15197717h, 0.1682067h, -0.33229175h, 0.18661757h, 0.142476h, -0.05811066h, -0.12433686h, 0.20817612h, 0.17710523h, 0.24227881h, -0.3699883h, -0.14644128h, -0.066485085h, -0.010829679h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(nc, half4x4(-0.02267665h, -0.21349631h, 0.05916224h, 0.07111888h, -0.3317847h, -0.044436328h, -0.08067249h, -0.13602455h, -0.2652356h, -0.13666181h, 0.022768881h, -0.21616152h, 0.10042784h, 0.13159652h, -0.062913835h, -0.12882891h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(nd, half4x4(-0.21270499h, 0.14776433h, 0.26771793h, 0.41242316h, -0.22445452h, 0.3885536h, -0.36809587h, 0.09838256h, 0.030300573h, -0.016225152h, -0.41985163h, -0.32797396h, 0.3021247h, -0.2566993h, 0.24282119h, 0.071926266h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(ne, half4x4(-0.14173156h, 0.10360139h, 0.03603846h, 0.23004h, -0.37078354h, -0.7556456h, 0.43359467h, -0.42839774h, -0.08143208h, -0.061868757h, -0.017048405h, -0.1806454h, 0.07700074h, -0.028751602h, -0.49057922h, -0.07150736h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(nf, half4x4(-0.21411006h, -0.039522924h, -0.11006789h, 0.30172586h, -0.019509817h, 0.34646508h, 0.03348711h, 0.3949624h, 0.09367525h, 0.11841692h, 0.064099714h, 0.30587056h, 0.00071666663h, 0.09569139h, 0.07905173h, -0.043038815h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(ng, half4x4(-0.1082019h, -0.081530154h, 0.1997084h, 0.0064345463h, -0.002075576h, 0.0122295255h, -0.21594198h, -0.20039533h, 0.023058774h, 0.061136324h, -0.043233447h, 0.018114857h, -0.12538326h, -0.008044748h, 0.08879177h, 0.29855737h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(nh, half4x4(0.06425974h, -0.162355h, -0.07716668h, -0.1783711h, 0.08560717h, 0.42500424h, 0.15796345h, 0.25115898h, 0.39673963h, 0.24484198h, -0.16364126h, 0.45589596h, -0.54474986h, -0.41130677h, 0.15731613h, -0.13945425h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(ni, half4x4(-0.4015527h, -0.22220162h, 0.088239804h, -0.16343592h, -0.05973259h, -0.053600565h, -0.11719207h, 0.340347h, 0.07810557h, 0.06943392h, 0.07088433h, 0.36863637h, -0.16925047h, -0.09059371h, -0.086145744h, -0.26417965h), conv2d_2_tf);

    half4 target1 = half4(0.022193057h, 0.0031918385h, 0.04232464h, -0.0056721596h);
    target1 = MulAdd(a, half4x4(-0.016554115h, 0.41586095h, -0.11134646h, 0.041401796h, -0.032285847h, 0.07744446h, 0.012422875h, 0.08027069h, -0.11944374h, -0.4644861h, -0.1625419h, 0.09757052h, 0.08459575h, -0.32677624h, -0.15526624h, 0.13285875h), target1);
    target1 = MulAdd(b, half4x4(-0.05147117h, -0.31841335h, -0.07968151h, -0.037866592h, -0.1438723h, 0.21164599h, 0.042448167h, 0.1660907h, -0.03240849h, 0.2866945h, -0.123190455h, -0.2005157h, -0.100519955h, -0.04109891h, -0.14908177h, -0.20055951h), target1);
    target1 = MulAdd(c, half4x4(-0.33594802h, 0.17970876h, -0.08458461h, 0.22198248h, 0.041744266h, 0.053618595h, -0.64927346h, 0.43071616h, -0.042823542h, 0.36384553h, 0.13817975h, -0.23117469h, -0.009722301h, 0.043797005h, -0.006320899h, -0.056160737h), target1);
    target1 = MulAdd(d, half4x4(0.020939048h, 0.15744017h, -0.18557346h, 0.2221421h, 0.13683408h, -0.17577636h, -0.1028824h, -0.05909411h, -0.11116942h, -0.23898265h, 0.013275228h, -0.10834194h, -0.23541391h, -0.045599524h, 0.13663499h, -0.061863456h), target1);
    target1 = MulAdd(e, half4x4(-0.9347821h, -1.0879762h, 0.029261602h, 0.0058627487h, 0.37568024h, 0.07800278h, 0.22918043h, -0.22581682h, -0.24621771h, 0.0565432h, -0.01175261h, 0.20289935h, -0.18791674h, -0.34127015h, -0.20261073h, 0.24382167h), target1);
    target1 = MulAdd(f, half4x4(-0.42576772h, -0.9465751h, 0.36503372h, 0.047452617h, -0.03021601h, 0.19896118h, -0.9916106h, 0.68441176h, -0.097055614h, -0.039465737h, -0.3072724h, 0.3834049h, 0.044579748h, 0.10185175h, -0.07127564h, 0.053964186h), target1);
    target1 = MulAdd(g, half4x4(-0.12718496h, -0.20010719h, -0.13560185h, -0.28841987h, -0.18198563h, 0.06924996h, 0.15375975h, 0.007953754h, -0.03143177h, 0.24778824h, -0.41971257h, -0.15984616h, 0.06914517h, -0.15320878h, -0.058414314h, -0.1829401h), target1);
    target1 = MulAdd(h, half4x4(-0.05676951h, -0.39852038h, -0.0008664457h, 0.073233515h, -0.110736564h, -0.12950265h, -0.32641715h, 0.05254214h, -0.0013476483h, 0.04590487h, -0.6886247h, -0.029103741h, 0.13570555h, -0.06356145h, 0.26564398h, 0.16304392h), target1);
    target1 = MulAdd(i, half4x4(-0.14373688h, 0.2627747h, 0.19523594h, -0.04094942h, -0.027800431h, 0.080428846h, -0.21676755h, 0.22764h, -0.08686052h, -0.14352795h, 0.012905041h, 0.12002593h, 0.096998215h, -0.0822731h, 0.25796455h, 0.3244333h), target1);
    target1 = MulAdd(na, half4x4(0.13717347h, -0.2534293h, -0.08265135h, 0.02238695h, 0.061414074h, -0.12315743h, -0.105848454h, -0.0324352h, -0.019163579h, 0.5106144h, 0.111571215h, -0.17051223h, 0.14541212h, 0.26512033h, 0.17036803h, -0.05180038h), target1);
