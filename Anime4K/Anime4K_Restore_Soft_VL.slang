[bgfx::PASS(6, "Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2, tex5", "tex3_UAV, tex4_UAV, tex6_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
