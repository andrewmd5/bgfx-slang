// Anime4K Restore Soft VL
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::EFFECT("Anime4K Restore Soft VL", 3)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("Soft detail restoration for anime content. Very Large variant offers the highest quality at significant cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(-0.040999945h, 0.075765304h, -0.0911532h, -0.10705836h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(0.14361712h, -0.16690509h, 0.37253398h, -0.45202538h, -0.21331833h, -0.32675815h, -0.33971128h, 0.20261937h, -0.20606318h, -0.215143h, -0.079716705h, 0.15640882h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.17360486h, -0.3435545h, 0.08199117h, 0.56259036h, -0.120246716h, 0.24312893h, -0.021436244h, -0.11864853h, 0.19452724h, 0.106943935h, -0.077393375h, -0.3503661h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(-0.072465785h, 0.2772823h, 0.25493625h, 0.3098145h, -0.115831695h, 0.072458096h, -0.014782132h, -0.15310249h, 0.12178311h, -0.015555423h, -0.2229811h, 0.16469522h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(-0.18652022h, -0.30702665h, -0.59921896h, 0.079824045h, 0.4426619h, 0.049343713h, 0.44902903h, -0.2711445h, 0.20470268h, -0.029203767h, 0.29092675h, 0.15562426h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.21041247h, 0.48450592h, -0.110547826h, 0.3842122h, 0.5303875h, -0.26512837h, 0.19846216h, 0.045673862h, 0.12773214h, -0.05117536h, -0.03510946h, -0.30123934h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(0.3186735h, 0.052702922h, -0.12499774h, 0.055628903h, -0.16476867h, 0.12642322h, -0.18314636h, 0.018323101h, -0.3609603h, 0.25649396h, 0.3185421h, -0.0057759956h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.16603558h, -0.09259665h, -0.28760567h, -0.14319661h, 0.12511417h, -0.12551902h, -0.00070228375h, 0.20914114h, -0.22466865h, 0.1064727h, 0.32598525h, -0.08596318h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(-0.03163653h, 0.026722813h, -0.4361858h, -0.21164834h, 0.4176763h, 0.08203146h, 0.35289326h, -0.06128859h, 0.20506798h, -0.07098943h, 0.1807802h, 0.2658414h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(-0.09821681h, 0.058886815h, 0.39192092h, -0.06791861h, -0.15682612h, 0.09503328h, -0.23400265h, 0.026475023h, -0.08800713h, -0.043749645h, -0.18024494h, -0.08045564h), target1);

                half4 target2 = half4(-0.029148052h, -0.03215124h, -0.6175828h, 0.057135154h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(-0.16406488h, -0.2506693h, -0.15592022h, -0.05529256h, -0.3997277h, -0.229681h, -0.07762124h, 0.1843808h, 0.07895815h, 0.14437248h, 0.219114h, -0.048090722h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(-0.2150676h, 0.09080163h, 0.19598733h, -0.40578827h, -0.33846557h, -0.02518622h, 0.037079208h, 0.20188439h, -0.013777575h, -0.2369007h, -0.30985412h, 0.0411912h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(0.119948365h, 0.23014452h, -0.14962277h, -0.096262485h, 0.09625151h, 0.2025487h, 0.03933539h, 0.12268028h, -0.24373281h, 0.19730613h, 0.11634144h, 0.12293635h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(0.08030697h, -0.40114692h, 0.21532272h, 0.20222071h, 0.073098h, -0.004463858h, 0.02820587h, -0.18861918h, -0.20994501h, -0.12444653h, -0.23178193h, -0.13965288h), target2);
                target2 = MulAdd(src[i][j], half3x4(0.14150894h, 0.14563078h, 0.697704h, 0.20918849h, 0.26776335h, -0.34291518h, 0.06394055h, 0.17925078h, 0.4165139h, -0.042595536h, 0.105312675h, 0.231854h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.024318576h, 0.16668217h, 0.0729521h, -0.7071404h, 0.3121693h, 0.37295797h, -0.015632952h, 0.33763757h, 0.00706697h, 0.10836652h, -0.11132417h, 0.292844h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.14489831h, 0.0027769986h, -0.24509215h, 0.5557927h, -0.1104541h, 0.005070684h, -0.020032275h, -0.5642205h, 0.16048644h, 0.07248175h, 0.20387374h, -0.38145426h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(0.33140838h, -0.007438425h, 0.26074782h, 0.15947102h, 0.219755h, -0.14690271h, -0.07412696h, -0.24176367h, -0.2230114h, 0.027256912h, -0.11255796h, -0.05882673h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.19712369h, 0.003842208h, -0.10893768h, 0.09047115h, -0.10260409h, 0.18662766h, 0.009733428h, 0.0039940844h, -0.006444674h, -0.15196493h, 0.06641555h, -0.06169452h), target2);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 target1 = half4(0.012687187h, -0.11876551h, -0.041985378h, -0.10110911h);
    target1 = MulAdd(a1, half4x4(0.05195995h, 0.15220909h, -0.24354807h, -0.109075695h, 0.020483498h, -0.14830725h, 0.0018816335h, -0.0072673927h, 0.0649385h, 0.046050787h, -0.10789607h, -0.046609525h, -0.11455093h, -0.009358115h, 0.11280759h, 0.18053898h), target1);
    target1 = MulAdd(b1, half4x4(-0.08619698h, 0.091353096h, -0.16379662h, 0.07822936h, 0.072919995h, 0.1482446h, 0.17846228h, 0.04639898h, -0.18998149h, 0.1653338h, -0.44187957h, -0.010017503h, -0.069953404h, 0.08784785h, -0.16391355h, 0.35095468h), target1);
    target1 = MulAdd(c1, half4x4(0.088297926h, 0.27259287h, 0.013088447h, 0.023461785h, 0.10037149h, -0.017414214h, 0.08559885h, -0.10822335h, 0.10591637h, 0.17240539h, 0.15749931h, 0.026641782h, 0.11889612h, -0.018095117h, -0.08736018h, 0.09934933h), target1);
    target1 = MulAdd(d1, half4x4(0.21426749h, 0.0800268h, -0.19816414h, 0.07693414h, 0.026270509h, -0.11724047h, 0.026078718h, 0.13080709h, 0.12207936h, 0.056103867h, -0.323923h, -0.111454345h, 0.059245165h, 0.07257926h, 0.032195322h, 0.27225617h), target1);
    target1 = MulAdd(e1, half4x4(-0.20130268h, 0.026809234h, -0.0020803472h, -0.04394057h, -0.1982125h, -0.033678252h, -0.12881789h, 0.0025656687h, 0.14193355h, -0.2541802h, -0.13239717h, -0.05983356h, -0.029376393h, 0.33187667h, 0.14438996h, -0.21993925h), target1);
    target1 = MulAdd(f1, half4x4(-0.12772562h, 0.022498213h, 0.24753313h, 0.07440761h, -0.17564529h, 0.09971503h, -0.013372h, 0.09459552h, -0.21597451h, -0.40116546h, 0.23446435h, 0.1515452h, 0.050813515h, 0.19662157h, -0.10604596h, -0.24638489h), target1);
    target1 = MulAdd(g1, half4x4(0.23866327h, -0.2706382h, -0.07480157h, 0.03789501h, 0.117716484h, -0.095995456h, -0.0435066h, 0.013025061h, -0.029759895h, -0.036287807h, 0.08570493h, 0.030151363h, 0.18863682h, -0.27228612h, 0.020479294h, -0.07058746h), target1);
    target1 = MulAdd(h1, half4x4(0.0026758043h, -0.20750894h, 0.2802277h, -0.07761428h, -0.012089615h, -0.112726666h, -0.03867965h, -0.085082226h, 0.034227375h, 0.19662802h, 0.26272395h, 0.036822405h, -0.23040786h, -0.20173554h, 0.07110236h, -0.26939383h), target1);
    target1 = MulAdd(i1, half4x4(-0.14012688h, -0.067249745h, 0.14726773h, -0.0070919944h, 0.19275497h, 0.04460783h, 0.18776374h, -0.019941995h, -0.076159865h, 0.002261728h, 0.238768h, 0.039375026h, 0.13200568h, -0.023286859h, 0.034387972h, -0.01827453h), target1);
    target1 = MulAdd(a2, half4x4(-0.0107542025h, -0.13001555h, 0.06596806h, -0.03370635h, -0.024291076h, 0.10367739h, -0.03396605h, 0.041960735h, 0.16230568h, 0.024845246h, -0.016806586h, 0.22547007h, -0.025378102h, 0.064547986h, -0.2113137h, 0.042272836h), target1);
    target1 = MulAdd(b2, half4x4(-0.2219356h, -0.049535394h, 0.10289468h, 0.14175911h, 0.013058568h, -0.15909089h, -0.02546921h, 0.11721571h, 0.13020545h, 0.39660174h, -0.07601573h, -0.16366366h, -0.023935124h, 0.06681424h, -0.26143414h, -0.07485668h), target1);
    target1 = MulAdd(c2, half4x4(0.1405031h, -0.0645044h, -0.15865614h, 0.1829069h, -0.22526503h, 0.08991175h, 0.041972812h, -0.012462953h, 0.3022753h, 0.19457603h, 0.022607598h, -0.25460255h, 0.028327515h, 0.14420614h, -0.077984214h, 0.09278112h), target1);
    target1 = MulAdd(d2, half4x4(0.13224132h, 0.13115089h, -0.188987h, -0.19428022h, -0.080641985h, 0.20909777h, 0.067079h, -0.19832124h, 0.13150498h, 0.04450851h, -0.2770351h, -0.010381239h, 0.32295567h, 0.04445836h, 0.030657565h, 0.020271502h), target1);
    target1 = MulAdd(e2, half4x4(-0.08188993h, 0.039709873h, 0.16059989h, -0.13279189h, 0.11389818h, -0.071865685h, 0.09312801h, -0.08816363h, -0.65844774h, -0.6854379h, 0.21431407h, 0.597198h, -0.3734657h, -0.116027676h, 0.015932929h, -0.0653176h), target1);
    target1 = MulAdd(f2, half4x4(0.24136105h, 0.21444799h, -0.14235207h, 0.08445492h, 0.017335927h, -0.49877876h, -0.06224622h, 0.1571534h, 0.035594277h, 0.059829034h, 0.087631516h, -0.17090686h, -0.005452869h, 0.13786094h, 0.27586326h, 0.046760406h), target1);
    target1 = MulAdd(g2, half4x4(0.095078h, 0.30310658h, 0.010268592h, 0.18540539h, -0.20722823h, -0.0005848572h, -0.06464327h, -0.111019135h, -0.07837157h, -0.12183798h, -0.09187498h, -0.3368629h, -0.08216629h, -0.20095807h, 0.009563313h, 0.024838416h), target1);
    target1 = MulAdd(h2, half4x4(0.28712475h, 0.0641969h, -0.034764312h, 0.13600683h, -0.09211094h, 0.009699817h, -0.001104855h, -0.026146285h, 0.33425868h, -0.16132632h, 0.18051304h, -0.104004376h, 0.20768233h, 0.0888418h, 0.050057285h, -0.020228952h), target1);
    target1 = MulAdd(i2, half4x4(0.11642946h, -0.021900529h, -0.08910504h, 0.15492517h, -0.19726521h, 0.1434987h, -0.24708387h, 0.006737377h, 0.11353539h, -0.15897587h, -0.029491093h, 0.06002862h, -0.09640613h, -0.11342702h, 0.21375169h, 0.0062719737h), target1);
    target1 = MulAdd(na1, half4x4(-0.15513068h, -0.3151456h, 0.20799752h, -0.07449935h, -0.09226967h, 0.112302735h, -0.16211908h, -0.37986508h, -0.27418482h, -0.10445544h, 0.21112369h, -0.06780466h, -0.062341h, 0.07758948h, -0.012719117h, -0.16481343h), target1);
