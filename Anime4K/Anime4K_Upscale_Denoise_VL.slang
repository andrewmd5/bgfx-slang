Texture2D conv2d_6_tf1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> conv2d_6_tf1_UAV;

[bgfx::EFFECT("Anime4K Upscale Denoise VL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("2x upscaler with denoising for anime content. Very Large variant offers high quality at higher performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "conv2d_tf_UAV, conv2d_tf1_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    bool shouldProcess = true;
    $for(ii in Range(1, 3))
    {
        $for(jj in Range(1, 3))
        {
            uint i = ii;
            uint j = jj;
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            if (i != 1 || j != 1)
            {
                shouldProcess = destPos.x < inputSize.x && destPos.y < inputSize.y;
            }

            if (shouldProcess)
            {
                half4 target1 = { 0.007907974h, -0.035503313h, 0.057224784h, -0.19763541h };
                target1 = MulAdd(src[i - 1][j - 1], half3x4(0.28296316h, -0.020139743h, 0.1038232h, 0.09352482h, -0.16964972h, 0.07910997h, -0.049914766h, -0.10661066h, -0.121037185h, -0.029087039h, -0.02511847h, -0.078911744h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.3927183h, 0.01805193h, -0.031168332h, -0.13300525h, 0.20814548h, 0.118818566h, 0.1655351h, 0.095023684h, 0.17600809h, -0.03928444h, -0.014350658h, 0.08458312h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(0.079089314h, -0.0421829h, 0.05452305h, -0.22055493h, 0.013279097h, -0.12875281h, 0.02452735h, -0.101503745h, -0.085946664h, 0.05539176h, 0.022408713h, 0.14837204h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(-0.102643915h, -0.011254746h, 0.1478563h, 0.1030208h, 0.12396588h, 0.0016621432h, 0.2551224h, -0.10399001h, -0.01068436h, 0.07155532h, -0.104522154h, 0.026937222h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.8789423h, 0.35707328h, -0.29964274h, -0.064913996h, 0.4962815h, 0.26001287h, -0.9511284h, 0.49574667h, 0.39539725h, 0.16308042h, 0.119878456h, -0.30259115h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(-0.08852938h, -0.32612664h, -0.006712046h, 0.28693515h, 0.06320871h, -0.3322611h, 0.04651086h, -0.11020996h, 0.01821082h, -0.22851005h, -0.07803438h, 0.021527015h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.12295851h, -0.011285535h, 0.015859747h, 0.04005441h, -0.018136669h, 0.03171969h, -0.0406123h, -0.10731229h, -0.12117574h, 0.005033036h, 0.047838476h, 0.026843475h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(0.4655988h, 0.05519082h, 0.039515793h, 0.28410903h, -0.36144528h, 0.13039446h, 0.11338478h, -0.2141387h, -0.10026682h, -0.07903024h, -0.09410254h, 0.043833878h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(0.110124744h, -0.024725702h, 0.028102143h, -0.09493807h, -0.06455328h, -0.15164614h, 0.04425987h, 0.15483347h, -0.045039337h, 0.07210396h, -0.005390788h, -0.03832707h), target1);

                half4 target2 = { 0.019286277h, -0.033644073h, 0.08196311h, 0.0054393094h };
                target2 = MulAdd(src[i - 1][j - 1], half3x4(-0.012326053h, 0.050769784h, 0.1278702h, -0.100782245h, 0.14329414h, -0.054558773h, 0.023473471h, 0.056829426h, 0.048292916h, 0.0046510273h, -0.11478287h, 0.0011030561h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(0.29542983h, -0.55061895h, -0.068554066h, 0.1433222h, -0.072878316h, 0.30201668h, -0.2223378h, -0.06704077h, 0.16955832h, 0.3279914h, 0.17619601h, -0.1276919h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(0.09623417h, 0.30559412h, 0.094622105h, -0.076706685h, 0.07943858h, -0.084815115h, 0.12472551h, 0.079850115h, -0.13044213h, -0.21300878h, -0.095747225h, 0.13412355h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(0.21291664h, 0.17195296h, -0.20080926h, 0.1064855h, 0.10228669h, -0.09580175h, -0.11217631h, -0.09740562h, -0.0033135475h, -0.053094357h, 0.2983595h, 0.035281878h), target2);
                target2 = MulAdd(src[i][j], half3x4(-0.08955812h, -0.45707774h, -0.4606922h, -0.5754473h, -0.11395895h, 0.33530128h, 0.29705846h, -0.18877256h, -0.43502945h, 0.114171304h, -0.3750776h, -0.081597246h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(-0.26109028h, 0.02662961h, -0.10441071h, 0.11199392h, -0.12038989h, -0.09642296h, -0.061320662h, -0.33058178h, 0.20212512h, 0.00840794h, 0.14357455h, -0.038080238h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.09533881h, -0.13644339h, 0.068756215h, 0.079305276h, -0.053370547h, 0.19572955h, 0.0682981h, 0.14469264h, 0.15582883h, -0.057183057h, -0.13919263h, -0.016394936h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(-0.041189935h, 0.39878023h, 0.028704925h, 0.30194348h, -0.04486593h, -0.33899093h, -0.103968106h, 0.21802065h, -0.077099144h, -0.07389541h, 0.18069103h, 0.18894517h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.12399862h, 0.19246885h, 0.034825478h, -0.0044787163h, 0.13121822h, -0.13573012h, -0.030162754h, 0.1899518h, 0.102326415h, -0.061512686h, -0.005647928h, -0.0937634h), target2);

                conv2d_tf_UAV[destPos] = float4(target1);
                conv2d_tf1_UAV[destPos] = float4(target2);
            }
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x16")]
[bgfx::PASS_IO("conv2d_tf, conv2d_tf1", "conv2d_1_tf_UAV, conv2d_1_tf1_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = tid.xy;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(conv2d_tf.SampleLevel(sam, pos, 0));
    half4 f1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0)); half4 nb1 = max(-b1, half4(0)); half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0)); half4 ne1 = max(-e1, half4(0)); half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0)); half4 nh1 = max(-h1, half4(0)); half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0)); b1 = max(b1, half4(0)); c1 = max(c1, half4(0));
    d1 = max(d1, half4(0)); e1 = max(e1, half4(0)); f1 = max(f1, half4(0));
    g1 = max(g1, half4(0)); h1 = max(h1, half4(0)); i1 = max(i1, half4(0));

    half4 a2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(conv2d_tf1.SampleLevel(sam, pos, 0));
    half4 f2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0)); half4 nb2 = max(-b2, half4(0)); half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0)); half4 ne2 = max(-e2, half4(0)); half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0)); half4 nh2 = max(-h2, half4(0)); half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0)); b2 = max(b2, half4(0)); c2 = max(c2, half4(0));
    d2 = max(d2, half4(0)); e2 = max(e2, half4(0)); f2 = max(f2, half4(0));
    g2 = max(g2, half4(0)); h2 = max(h2, half4(0)); i2 = max(i2, half4(0));

    half4 target1 = { -0.044073943h, 0.12072677h, -0.0022342638h, -0.24414532h };
    target1 = MulAdd(a1, half4x4(-0.04088509h, -0.06585775h, -0.3094732h, 0.12059048h, 0.041417453h, -0.06144871h, -0.06655134h, 0.03308842h, 0.09287731h, 0.010969216h, 0.10343026h, -0.11185897h, 0.05685865h, -0.09490512h, 0.040908635h, 0.03501189h), target1);
    target1 = MulAdd(b1, half4x4(-0.04854754h, -0.098667145h, 0.67147833h, -0.11299351h, -0.022114437h, -0.029202767h, 0.014179382h, 0.26027945h, 0.22076549h, -0.16490546h, -0.0010764733h, 0.08405975h, 0.11849154h, -0.19072372h, -0.35719597h, -0.059621073h), target1);
    target1 = MulAdd(c1, half4x4(0.079224996h, 0.0669873h, -0.1718969h, -0.05002573h, 0.044926763h, -0.02904369h, 0.017489236h, 0.01144465h, 0.059109706h, 0.064998455h, 0.14725484h, -0.23879208h, 0.039234288h, -0.027365638h, 0.26172164h, -0.094598554h), target1);
    target1 = MulAdd(d1, half4x4(-0.07159218h, -0.03181544h, 0.113837324h, -0.053089984h, -0.098298974h, -0.29500297h, 0.1608509h, -0.044355504h, 0.050882854h, -0.19417204h, -0.080487266h, -0.00879743h, 0.0007914453h, 0.16640955h, 0.21786706h, 0.16398212h), target1);
    target1 = MulAdd(e1, half4x4(0.16324541h, 0.19753313h, -0.46597233h, -0.2593132h, -0.2781038h, -0.21973547h, -0.024623038h, -0.16348499h, 0.3628299h, 0.044888914h, 0.04054647h, -0.63605887h, 0.02099492h, 0.060544077h, -0.49359834h, 0.36336297h), target1);
    target1 = MulAdd(f1, half4x4(-0.16885692h, 0.31907207h, 0.020906802h, 0.13290039h, -0.037330728h, -0.022859452h, -0.020451576h, -0.113437995h, -0.085683934h, 0.054102756h, -0.044824492h, 0.061346747h, -0.038684413h, 0.098444365h, -0.06734984h, -0.17084897h), target1);
    target1 = MulAdd(g1, half4x4(-0.015821548h, -0.119599186h, 0.1614827h, 0.08383641h, -0.07933593h, 0.12528986h, -0.06300182h, 0.09286327h, -0.10199266h, 0.02419403h, 0.0028411683h, -0.09028338h, 0.07962534h, -0.08676035h, -0.19237737h, -0.115502626h), target1);
    target1 = MulAdd(h1, half4x4(0.09471972h, 0.21153462h, -0.14393018h, 0.055180002h, 0.1817461h, 0.016607309h, -0.0771979h, 0.11181317h, -0.5491086h, -0.102757886h, -0.20952754h, 0.022466583h, -0.075119644h, -0.14725658h, 0.38451517h, 0.12920731h), target1);
    target1 = MulAdd(i1, half4x4(0.0867803h, 0.114654355h, 0.21199988h, -0.15367955h, -0.01803536h, 0.056378633h, 0.0018388306h, 0.024613786h, -0.13306658h, 0.017211098h, 0.073351346h, -0.12064064h, -0.10484361h, -0.067748636h, 0.033206712h, -0.13061953h), target1);
    target1 = MulAdd(a2, half4x4(-0.002236411h, -0.022144757h, -0.04586377h, 0.101181075h, -0.03511624h, 0.08440529h, 0.18544284h, -0.22786349h, -0.042184375h, 0.015734851h, -0.038622506h, 0.038529944h, -0.09170703h, 0.034527462h, -0.07817406h, 0.10547265h), target1);
    target1 = MulAdd(b2, half4x4(-0.12135524h, -0.07412039h, -0.04979351h, -0.082267545h, 0.13343571h, 0.29196215h, -0.4364121h, -0.10226428h, 0.060835477h, -0.23307934h, -0.018231759h, 0.15550235h, 0.09095689h, 0.18164484h, 0.1322021h, -0.022567045h), target1);
    target1 = MulAdd(c2, half4x4(-0.0054531163h, -0.039762255h, -0.030490747h, 0.04779882h, -0.15290286h, 0.056712102h, -0.0776974h, 0.04114215h, 0.15946816h, -0.03882117h, 0.16770308h, -0.026126247h, -0.027203865h, -0.064107865h, -0.13670811h, 0.1556276h), target1);
    target1 = MulAdd(d2, half4x4(-0.092548385h, -0.027285473h, 0.084179096h, 0.014961629h, 0.2564254h, 0.07626849h, 0.28534448h, 0.2588713h, -0.018600503h, -0.2433456h, 0.041392803h, -0.045712482h, 0.26388907h, -0.053502295h, 0.14522223h, 0.032808404h), target1);
