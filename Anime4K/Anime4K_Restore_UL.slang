// Anime4K Restore CNN (Ultra Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex7;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex7_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex8;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex8_UAV;

[bgfx::EFFECT("Anime4K Restore UL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("CNN-based image restoration filter for anime content. Ultra Large variant offers maximum quality with highest performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV, tex3_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {

            half4 target1 = half4(-0.02313247h, 0.016216148h, -0.053347506h, -0.023317637h);
            target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.28293434h, -0.10095658h, -0.013867814h, 0.08509398h, -0.31489053h, -0.26828897h, 0.01152665h, 0.18905516h, -0.23013242h, -0.18878274h, -0.17923735h, -0.32707638h), target1);
            target1 = MulAdd(src[i - 1][j], half3x4(-0.3519405h, -0.12639853h, 0.0981044h, -0.23800656h, -0.1666394h, 0.2548722h, -0.09458217h, 0.17642984h, -0.0016840132h, -0.12355663h, -0.13711694h, 0.25234836h), target1);
            target1 = MulAdd(src[i - 1][j + 1], half3x4(-0.14581299h, -0.060752276h, 0.06813433h, 0.32616982h, -0.29410994h, 0.28217724h, -0.2221963h, -0.051627193h, 0.10754401h, 0.31993762h, 0.25542948h, -0.4268778h), target1);
            target1 = MulAdd(src[i][j - 1], half3x4(0.2716687h, -0.13160354h, -0.056812827h, -0.00881874h, 0.3249303h, 0.05037425h, -0.117648534h, -0.26370025h, 0.032854702h, -0.14214379h, 0.10036965h, 0.17808898h), target1);
            target1 = MulAdd(src[i][j], half3x4(0.004323515h, 0.37651265h, -0.39865002h, -0.18153298h, 0.5224921h, -0.11810103h, 0.56151056h, -0.063698344h, -0.17272837h, -0.053013492h, 0.062254835h, 0.28695017h), target1);
            target1 = MulAdd(src[i][j + 1], half3x4(0.2776938h, 0.22578415h, 0.110299006h, 0.27424663h, 0.012712999h, -0.22353122h, -0.0010140019h, 0.08163494h, 0.3611274h, 0.014346184h, -0.26426178h, -0.26777005h), target1);
            target1 = MulAdd(src[i + 1][j - 1], half3x4(-0.09010997h, 0.19958799h, 0.22421049h, 0.054506898h, -0.11822318h, 0.23656984h, 0.11197124h, -0.4646639h, 0.17118955h, 0.33748102h, 0.20479581h, 0.6810799h), target1);
            target1 = MulAdd(src[i + 1][j], half3x4(0.2121316h, -0.08664465h, 0.2507115h, -0.223455h, 0.22042283h, -0.20352642h, 0.42714027h, -0.5048447h, -0.10270271h, 0.11400399h, -0.019575266h, 0.40490857h), target1);
            target1 = MulAdd(src[i + 1][j + 1], half3x4(0.091496244h, -0.24679382h, -0.3801941h, -0.08482344h, -0.17183328h, -0.09308921h, -0.059639163h, 0.3321586h, -0.19797249h, -0.17941834h, 0.015049101h, -0.13793056h), target1);

            half4 target2 = half4(0.42778614h, 0.054881692h, -0.23388587h, -0.031204376h);
            target2 = MulAdd(src[i - 1][j - 1], half3x4(-0.44157687h, 0.1715858h, -0.11000502h, 0.062367063h, 0.21790773h, 0.15507151h, 0.14760862h, -0.2598815h, 0.14098467h, 0.14019097h, -0.26298222h, 0.10975315h), target2);
            target2 = MulAdd(src[i - 1][j], half3x4(0.15774319h, -0.16769339h, -0.49734345h, -0.3935963h, 0.115124024h, -0.08045373h, 0.55867237h, 0.48593813h, 0.058544844h, -0.2705686h, 0.3303555h, 0.4181385h), target2);
            target2 = MulAdd(src[i - 1][j + 1], half3x4(0.16588609h, -0.013389144h, 0.06600297h, -0.09309111h, -0.36321074h, -0.13877828h, 0.4099233h, 0.20805255h, 0.31892648h, 0.16856939h, -0.23898357h, 0.11751563h), target2);
            target2 = MulAdd(src[i][j - 1], half3x4(0.39999864h, 0.46407622h, -0.12249342h, -0.09798957h, 0.122675434h, 0.18265116h, 0.030651823h, 0.14682484h, -0.42969155h, 0.2486042h, 0.13566706h, -0.13458017h), target2);
            target2 = MulAdd(src[i][j], half3x4(-0.12757893h, -0.19025628h, -0.16728874h, -0.10162156h, -0.1577721h, -0.174548h, 0.29329458h, 0.17963637h, -0.43279588h, 0.088979766h, 0.06334896h, -0.047701746h), target2);
            target2 = MulAdd(src[i][j + 1], half3x4(-0.14359929h, -0.12800618h, -0.15429202h, 0.034745168h, 0.15794043h, -0.086441815h, -0.06520017h, 0.26176664h, -0.022253495h, -0.34480432h, -0.009120493h, 0.08706416h), target2);
            target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.1994137h, 0.070990525h, 0.3388379h, 0.37502727h, -0.116911314h, 0.2160554h, -0.1831974h, -0.04184975h, 0.2545874h, -0.083908126h, -0.19057468h, -0.13382773h), target2);
            target2 = MulAdd(src[i + 1][j], half3x4(-0.46475947h, -0.23414738h, -0.036689937h, 0.018558737h, -0.32609373h, 0.15265512h, -0.055894423h, -0.3676328h, 0.24501368h, 0.12390915h, 0.13458043h, -0.30162823h), target2);
            target2 = MulAdd(src[i + 1][j + 1], half3x4(0.12621075h, 0.046852987h, 0.17333286h, 0.18997045h, 0.3245911h, -0.28809196h, -0.3660882h, -0.5916272h, -0.11456223h, -0.030912774h, 0.17037971h, -0.12640971h), target2);

            half4 target3 = half4(-0.032911904h, -0.0050934837h, 0.021853646h, -0.17256187h);
            target3 = MulAdd(src[i - 1][j - 1], half3x4(0.18228084h, 0.25933146h, 0.1764313h, 0.23183075h, -0.061067093h, 0.34710985h, -0.1785006h, -0.06471029h, -0.23235676h, -0.43409523h, -0.06639704h, 0.30396065h), target3);
            target3 = MulAdd(src[i - 1][j], half3x4(0.31676784h, 0.21897513h, 0.06466065h, 0.42289257h, 0.12306216h, -0.3928633h, 0.09720577h, -0.10426061h, -0.030383142h, 0.03775265h, 0.34221298h, 0.3827705h), target3);
            target3 = MulAdd(src[i - 1][j + 1], half3x4(-0.13229136h, 0.37214845h, -0.07046923h, -0.17644346h, 0.5591967h, -0.5409525h, 0.08944645h, -0.047717415h, 0.3754216h, 0.2979604h, -0.14149979h, -0.1743562h), target3);
            target3 = MulAdd(src[i][j - 1], half3x4(0.07603316h, 0.10389099h, 0.07042061h, 0.24759614h, 0.05822713h, 0.29799607h, -0.21219468h, 0.3884128h, -0.010661014h, -0.5209726h, 0.20311587h, -0.39393h), target3);
            target3 = MulAdd(src[i][j], half3x4(-0.17486575h, -0.22572622h, -0.13514778h, 0.12839775h, -0.25754005h, 0.13090849h, -0.16364887h, 0.37675568h, -0.05928962h, 0.049174402h, -0.37935108h, -0.14333783h), target3);
            target3 = MulAdd(src[i][j + 1], half3x4(0.15858985h, -0.47485206h, 0.4509964h, 0.3877553h, -0.04848657h, 0.22396515h, 0.33325925h, -0.20703658h, 0.14929648h, 0.25580746h, 0.2795224h, -0.0158565h), target3);
            target3 = MulAdd(src[i + 1][j - 1], half3x4(0.030926622h, 0.16219522h, -0.26666775h, -0.27920142h, -0.2693319h, -0.29130983h, -0.2795281h, 0.22597994h, 0.32512712h, 0.16784063h, -0.0113234315h, -0.10118217h), target3);
            target3 = MulAdd(src[i + 1][j], half3x4(-0.32426193h, 0.0072339224h, 0.08070994h, -0.07735796h, -0.09247539h, 0.23327915h, 0.09039661h, -0.11836084h, -0.2726992h, -0.16031814h, -0.28027415h, -0.029263943h), target3);
            target3 = MulAdd(src[i + 1][j + 1], half3x4(-0.20109104h, -0.43383566h, -0.33850962h, -0.13422257h, 0.040343326h, -0.0819253h, 0.26943803h, -0.46652415h, -0.3474102h, 0.41198114h, 0.14404535h, 0.076806836h), target3);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
                tex3_UAV[destPos] = target3;
            }
        }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x24")]
[bgfx::PASS_IO("tex1, tex2, tex3", "tex4_UAV, tex5_UAV, tex6_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 a3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d3 = half4(tex3.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e3 = half4(tex3.SampleLevel(sam, pos, 0));
    half4 f3 = half4(tex3.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na3 = max(-a3, half4(0));
    half4 nb3 = max(-b3, half4(0));
    half4 nc3 = max(-c3, half4(0));
    half4 nd3 = max(-d3, half4(0));
    half4 ne3 = max(-e3, half4(0));
    half4 nf3 = max(-f3, half4(0));
    half4 ng3 = max(-g3, half4(0));
    half4 nh3 = max(-h3, half4(0));
    half4 ni3 = max(-i3, half4(0));

    a3 = max(a3, half4(0));
    b3 = max(b3, half4(0));
    c3 = max(c3, half4(0));
    d3 = max(d3, half4(0));
    e3 = max(e3, half4(0));
    f3 = max(f3, half4(0));
    g3 = max(g3, half4(0));
    h3 = max(h3, half4(0));
    i3 = max(i3, half4(0));

    half4 target1 = half4(-0.08736043h, 0.2861529h, -0.005863071h, -0.004482026h);
    target1 = MulAdd(a1, half4x4(0.08648221h, 0.012940912h, 0.0694797h, 0.021795172h, 0.19547985h, 0.019256733h, -0.099714816h, 0.08773751h, 0.06443286h, 0.08462334h, 0.02924696h, -0.07673487h, 0.061156925h, 0.12037308h, -0.04778231h, 0.010492923h), target1);
    target1 = MulAdd(b1, half4x4(0.00033161003h, -0.19050376h, -0.14713565h, -0.20729654h, -0.122199036h, 0.0044957534h, 0.19240627h, -0.1515226h, 0.05051369h, -0.08790857h, -0.05331543h, -0.13356556h, -0.019020412h, 0.06989371h, -0.07270814h, 0.06541199h), target1);
    target1 = MulAdd(c1, half4x4(0.086689815h, 0.08965917h, 0.38167384h, 0.31010604h, 0.04204608h, 0.095588356h, -0.22810745h, 0.112243816h, 0.016992478h, -0.16491304h, -0.08901814h, -0.038421903h, -0.00041658967h, -0.03551529h, 0.097966395h, -0.06240607h), target1);
    target1 = MulAdd(d1, half4x4(0.13955353h, -0.27422932h, 0.14655617h, -0.07651906h, -0.07335902h, -0.05214342h, 0.35741827h, 0.043639295h, 0.041774176h, -0.08277867h, -0.028840896h, -0.14434154h, 0.029840615h, -0.1444494h, 0.0417388h, -0.05095746h), target1);
    target1 = MulAdd(e1, half4x4(-0.06985613h, 0.036354948h, -0.22372876h, -0.268865h, -0.07852222h, -0.20930836h, 0.06419149h, 0.19363879h, -0.00020227236h, 0.04876036h, 0.16503128h, -0.05324255h, 0.06806321h, 0.2646995h, -0.04032264h, 0.06421368h), target1);
