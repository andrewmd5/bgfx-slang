// Anime4K Restore CNN Soft (Ultra Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex7;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex7_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex8;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex8_UAV;

[bgfx::EFFECT("Anime4K Restore Soft UL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("Soft CNN-based image restoration filter for anime content. Ultra Large variant offers maximum quality with highest performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV, tex3_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
    return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
    uint i = ii * 2;
    $for(jj in Range(0, 2))
    {
    uint j = jj * 2;
    float2 tpos = (gxy + uint2(i, j)) * inputPt;
    const half4 sr = half4(INPUT.GatherRed(sam, tpos));
    const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
    const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

    src[i][j] = half3(sr.w, sg.w, sb.w);
    src[i][j + 1] = half3(sr.x, sg.x, sb.x);
    src[i + 1][j] = half3(sr.z, sg.z, sb.z);
    src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
    }
    }

    $for(i in Range(1, 3))
    {
    $for(j in Range(1, 3))
    {
    uint2 destPos = gxy + uint2(i - 1, j - 1);

    bool shouldProcess = true;
    if (i != 1 || j != 1)
    {
    if (destPos.x >= inputSize.x || destPos.y >= inputSize.y) {
    shouldProcess = false;
    }
    }

    half4 target1 = half4(-0.03509807h, 0.029998481h, -0.08691994h, -0.017055636h);
    target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.23234928h, -0.070085905h, 0.0040122913h, 0.21575761h, -0.25936925h, -0.20185155h, 0.022299573h, 0.2812235h, -0.11045535h, -0.11106335h, -0.12113332h, -0.49919847h), target1);
    target1 = MulAdd(src[i - 1][j], half3x4(-0.48585954h, -0.058959674h, 0.11114158h, -0.1971666h, -0.24872562h, 0.2667282h, -0.107163996h, 0.12475151h, -0.027792914h, -0.06700173h, -0.10966316h, 0.09399147h), target1);
    target1 = MulAdd(src[i - 1][j + 1], half3x4(-0.16666615h, -0.15644506h, 0.048309084h, 0.19122206h, -0.1522582h, 0.15417537h, -0.23017146h, 0.09460856h, 0.074704535h, 0.2168164h, 0.2077189h, -0.29264635h), target1);
    target1 = MulAdd(src[i][j - 1], half3x4(0.3167284h, -0.20522436h, -0.050071932h, -0.036290437h, 0.20206359h, 0.012589764h, -0.1251284h, -0.2911492h, -0.0006390347h, -0.09853893h, 0.14406726h, 0.33612582h), target1);
    target1 = MulAdd(src[i][j], half3x4(0.13786903h, 0.51342535h, -0.44004235h, -0.23918492h, 0.5614157h, 0.011565876h, 0.5419984h, -0.15937872h, -0.075360805h, 0.018496322h, 0.12582661h, 0.40117717h), target1);
    target1 = MulAdd(src[i][j + 1], half3x4(0.19644158h, 0.12697817h, 0.15092115h, 0.1963961h, -0.03395398h, -0.17465135h, -0.04086773h, 0.09187623h, 0.18238129h, -0.0063141263h, -0.26402372h, -0.28761682h), target1);
    target1 = MulAdd(src[i + 1][j - 1], half3x4(-0.010849395h, 0.15082607h, 0.095264904h, -0.038952388h, -0.1121466h, 0.21590506h, 0.029462064h, -0.65400773h, 0.18295552h, 0.2425088h, 0.121624336h, 0.7189011h), target1);
    target1 = MulAdd(src[i + 1][j], half3x4(0.17197245h, -0.04397748h, 0.18232836h, -0.04471754h, 0.071163684h, -0.20590816h, 0.39706057h, -0.5452873h, -0.11754515h, 0.006909551h, 0.018450081h, 0.5686299h), target1);
    target1 = MulAdd(src[i + 1][j + 1], half3x4(0.077441245h, -0.25645187h, -0.19979256h, -0.010363122h, -0.04312338h, -0.08810754h, -0.059999906h, 0.38630447h, -0.11017497h, -0.16309647h, 0.026156282h, -0.35432625h), target1);

    half4 target2 = half4(0.6537504h, 0.07195351h, -0.38729003h, -0.0374416h);
    target2 = MulAdd(src[i - 1][j - 1], half3x4(-0.34123975h, 0.06927292h, 0.12252625h, 0.1038146h, 0.15979475h, 0.24436772h, -0.016088272h, -0.22664197h, 0.16932374h, 0.10719134h, -0.16895153h, 0.100098394h), target2);
    target2 = MulAdd(src[i - 1][j], half3x4(0.11094869h, -0.1379463h, -0.53625333h, -0.42690855h, 0.12101115h, -0.004709155h, 0.6293494h, 0.4763549h, 0.030926082h, -0.20099613h, 0.39174548h, 0.31219363h), target2);
    target2 = MulAdd(src[i - 1][j + 1], half3x4(0.08731028h, -0.010540878h, 0.0757335h, -0.1466203h, -0.23115048h, -0.17813745h, 0.17698573h, 0.18787299h, 0.16219892h, 0.10475756h, -0.23984352h, 0.025724094h), target2);
    target2 = MulAdd(src[i][j - 1], half3x4(0.27665043h, 0.4118298h, -0.08762915h, -0.07885308h, 0.05053698h, 0.28148478h, -0.005842398h, 0.15139125h, -0.3791668h, 0.24871133h, 0.18160823h, -0.10384939h), target2);
    target2 = MulAdd(src[i][j], half3x4(-0.3206045h, -0.22038852h, -0.3038138h, -0.0482595h, -0.26852164h, -0.23278148h, 0.30639926h, 0.2578657h, -0.3874695h, 0.06441954h, 0.00026220892h, 0.04361178h), target2);
    target2 = MulAdd(src[i][j + 1], half3x4(-0.17908047h, -0.0900835h, 0.00652168h, -0.038639892h, 0.1520494h, -0.13204975h, -0.020355739h, 0.26766944h, 0.021308672h, -0.31918222h, 0.050667368h, 0.10367864h), target2);
    target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.112388864h, 0.053321466h, 0.2691917h, 0.26902813h, 0.010105532h, 0.24898581h, -0.13757521h, -0.10214595h, 0.23615286h, -0.09560994h, -0.15046176h, -0.08853913h), target2);
    target2 = MulAdd(src[i + 1][j], half3x4(-0.36796987h, -0.2124952h, -0.07535088h, 0.13065732h, -0.21852261h, 0.06934692h, -0.013749303h, -0.44900006h, 0.3352218h, 0.090437174h, 0.08993535h, -0.3050165h), target2);
    target2 = MulAdd(src[i + 1][j + 1], half3x4(0.11873657h, 0.13483031h, 0.22352207h, 0.23666611h, 0.18977334h, -0.32066482h, -0.31396368h, -0.5615055h, -0.14588253h, 0.0121516865h, 0.0614425h, -0.079611346h), target2);

    half4 target3 = half4(-0.04453386h, 0.06632044h, 0.061607827h, -0.19856223h);
    target3 = MulAdd(src[i - 1][j - 1], half3x4(0.16112354h, 0.3756035h, 0.09619928h, 0.17283864h, 0.054338567h, -0.061197184h, -0.10173672h, -0.032733057h, -0.111913994h, -0.28940153h, -0.062114924h, 0.20520677h), target3);
    target3 = MulAdd(src[i - 1][j], half3x4(0.3500745h, 0.467141h, -0.101748556h, 0.43384346h, 0.06712478h, -0.43235737h, 0.014446082h, -0.12634972h, -0.07507498h, 0.025314584h, 0.22664048h, 0.22121347h), target3);
    target3 = MulAdd(src[i - 1][j + 1], half3x4(-0.089320965h, 0.319314h, -0.06869195h, -0.2465581h, 0.449762h, -0.38919032h, 0.1562217h, 0.05368933h, 0.20758076h, 0.0659555h, -0.109858744h, -0.114917934h), target3);
    target3 = MulAdd(src[i][j - 1], half3x4(-0.07451217h, 0.2239877h, -0.009071173h, 0.21869898h, 0.042301223h, 0.13635477h, -0.20052543h, 0.26130545h, -0.051627826h, -0.3429969h, 0.093028575h, -0.35710186h), target3);
    target3 = MulAdd(src[i][j], half3x4(-0.16129561h, -0.31247056h, -0.123016216h, 0.2122524h, -0.2972285h, 0.2718142h, -0.17284301h, 0.44368207h, -0.032497104h, 0.18240568h, -0.28283152h, -0.10045272h), target3);
    target3 = MulAdd(src[i][j + 1], half3x4(0.15945031h, -0.6797371h, 0.3974546h, 0.24741851h, -0.1340806h, 0.41666976h, 0.27850744h, -0.21406768h, 0.096567124h, 0.23366652h, 0.15648519h, -0.07626781h), target3);
    target3 = MulAdd(src[i + 1][j - 1], half3x4(-0.053246673h, 0.14282355h, -0.114118166h, -0.3172004h, -0.18055372h, -0.3400759h, -0.19622837h, 0.076828666h, 0.29225305h, 0.14866155h, 0.07959014h, -0.041400358h), target3);
    target3 = MulAdd(src[i + 1][j], half3x4(-0.25331625h, -0.14193451h, 0.04879846h, -0.077393495h, 0.0104558095h, 0.37905747h, -0.07880302h, -0.09453499h, -0.1426901h, -0.19738746h, -0.28036812h, 0.03675319h), target3);
    target3 = MulAdd(src[i + 1][j + 1], half3x4(-0.08954212h, -0.47161737h, -0.12388452h, -0.08005436h, 0.04682568h, 0.048485547h, 0.31411946h, -0.31375095h, -0.22892538h, 0.16906887h, 0.16802602h, 0.18711087h), target3);

    tex1_UAV[destPos] = target1;
    tex2_UAV[destPos] = target2;
    tex3_UAV[destPos] = target3;
    }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x24")]
[bgfx::PASS_IO("tex1, tex2, tex3", "tex4_UAV, tex5_UAV, tex6_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
    return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 a3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c3 = half4(tex3.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d3 = half4(tex3.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e3 = half4(tex3.SampleLevel(sam, pos, 0));
    half4 f3 = half4(tex3.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i3 = half4(tex3.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na3 = max(-a3, half4(0));
    half4 nb3 = max(-b3, half4(0));
    half4 nc3 = max(-c3, half4(0));
    half4 nd3 = max(-d3, half4(0));
    half4 ne3 = max(-e3, half4(0));
    half4 nf3 = max(-f3, half4(0));
    half4 ng3 = max(-g3, half4(0));
    half4 nh3 = max(-h3, half4(0));
    half4 ni3 = max(-i3, half4(0));

    a3 = max(a3, half4(0));
    b3 = max(b3, half4(0));
    c3 = max(c3, half4(0));
    d3 = max(d3, half4(0));
    e3 = max(e3, half4(0));
    f3 = max(f3, half4(0));
    g3 = max(g3, half4(0));
    h3 = max(h3, half4(0));
    i3 = max(i3, half4(0));

    half4 target1 = half4(-0.17880301h, 0.20980668h, -0.013683405h, -0.015587634h);
    target1 = MulAdd(a1, half4x4(-0.09962672h, -0.09808486h, 0.14167309h, 0.050132442h, 0.10861549h, -0.03472704h, -0.13705672h, -0.029933043h, 0.09841877h, 0.07278074h, -0.017292077h, -0.027848938h, 0.07552298h, 0.076578915h, -0.023463586h, 0.052939452h), target1);
    target1 = MulAdd(b1, half4x4(0.0010984733h, -0.17330085h, -0.08229318h, -0.2175911h, 0.08144593h, 0.059445348h, -0.15086831h, -0.10372944h, 0.117648594h, -0.12558225h, -0.11103407h, -0.0701386h, -0.05065664h, -0.07396901h, -0.11938091h, 0.039866682h), target1);
    target1 = MulAdd(c1, half4x4(0.15428792h, 0.23440446h, 0.21962269h, 0.2650896h, -0.03476033h, 0.15719226h, -0.12486064h, 0.2167058h, -0.023046771h, -0.20562397h, 0.10107006h, -0.01569021h, 0.16730824h, -0.01259593h, 0.053364236h, -0.04500823h), target1);
    target1 = MulAdd(d1, half4x4(0.030429626h, -0.13110232h, 0.057990804h, 0.011675255h, -0.05295247h, -0.15326303h, 0.22707884h, -0.07973966h, 0.0439027h, -0.13198115h, 0.07837125h, -0.07131822h, 0.05269012h, -0.2104038h, 0.048907652h, -0.020645073h), target1);
    target1 = MulAdd(e1, half4x4(0.0031781355h, -0.021097122h, -0.26952672h, -0.3207644h, 0.08375256h, -0.14136748h, 0.18542029h, 0.15215854h, 0.091964215h, 0.26967737h, 0.0587766h, -0.07700872h, 0.16575423h, 0.35469708h, -0.0051588053h, -0.0006740279h), target1);
    target1 = MulAdd(f1, half4x4(-0.08884001h, 0.14041351h, 0.17474355h, 0.4161406h, 0.023943432h, 0.003970282h, 0.29985484h, 0.10266973h, -0.25273883h, -0.14029191h, 0.11345857h, 0.31820163h, -0.38953283h, 0.2583901h, 0.009964725h, 0.058217626h), target1);
