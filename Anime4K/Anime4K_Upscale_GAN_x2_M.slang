// Anime4K GAN Upscaler x2 (Medium)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex7;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex7_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex8;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex8_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex9;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex9_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex10;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex10_UAV;

[bgfx::EFFECT("Anime4K Upscale GAN x2 M", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("Anime4K GAN-based upscaler x2 (Medium variant)")]
[bgfx::FP16]

[bgfx::PASS(1, "Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1, tex2")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;


    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
        return;
    }
    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2)) {
        $for(jj in Range(0, 2)) {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3)) {
        $for(j in Range(1, 3)) {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1) {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y) {
                    shouldProcess = false;
                }
            }

            if (shouldProcess) {
                half4 result = half4(0.010385515h, 0.011541315h, -0.002942497h, -0.00020902864h);
                result = MulAdd(src[i - 1][j - 1], half3x4(-0.17498326h, -0.14677401h, -0.43065637h, 0.10841958h, 0.24096319h, -0.008683959h, -0.29844064h, 0.3567803h, 0.43360776h, 0.11304715h, -0.0802437h, 0.190904h), result);
                result = MulAdd(src[i - 1][j], half3x4(0.24688073h, 0.086462855h, 0.05716678h, -0.1739644h, 0.3236298h, 0.23382919h, 0.20481811h, -0.022618154h, -0.336325h, -0.21624258h, -0.18736486h, -0.14936537h), result);
                result = MulAdd(src[i - 1][j + 1], half3x4(0.38230455h, 0.410552h, 0.34809712h, 0.2510045h, 0.30689523h, 0.09889703h, -0.26991332h, 0.1108426h, 0.5083409h, 0.2854462h, -0.1912902h, 0.40354714h), result);
                result = MulAdd(src[i][j - 1], half3x4(0.46870667h, -0.03530456h, 0.13705169h, -0.11884997h, -0.0772201h, 0.17073877h, 0.03287621h, -0.14975251h, -0.18155691h, 0.14545092h, -0.1584816h, 0.051269397h), result);
                result = MulAdd(src[i][j], half3x4(-0.5830986h, -0.009166566h, 0.54358304h, -0.4545001h, -0.27541155h, 0.6697277h, -0.29205534h, -0.61038095h, -0.64781004h, 0.32052672h, 0.14704794h, -0.6479083h), result);
                result = MulAdd(src[i][j + 1], half3x4(-0.04402336h, 0.05461938h, -0.18035333h, 0.5464947h, 0.21475682h, -0.6899343h, 0.49390903h, 0.62440956h, 0.75365967h, -0.26500008h, 0.59187347h, 0.10037025h), result);
                result = MulAdd(src[i + 1][j - 1], half3x4(-0.25319895h, -0.1764162h, -0.22574338h, 0.03075524h, -0.29618785h, -0.491323h, 0.008427114h, -0.363144h, -0.17214127h, -0.11891048h, -0.19321653h, -0.13424487h), result);
                result = MulAdd(src[i + 1][j], half3x4(0.17425235h, 0.07049646h, -0.1759216h, 0.05697634h, -0.39496303h, 0.35450256h, -0.09984144h, 0.15470548h, -0.03375828h, 0.06442114h, 0.14598753h, 0.46114844h), result);
                result = MulAdd(src[i + 1][j + 1], half3x4(-0.19262458h, -0.17141157h, -0.11393742h, -0.07778959h, -0.006366565h, -0.16713034h, 0.2135569h, 0.23494779h, -0.37996295h, -0.2767951h, -0.1515432h, -0.110363424h), result);
                tex1_UAV[destPos] = result;

                result = half4(0.02648044h, -0.0017647704h, -0.016136197h, 0.0011179475h);
                result = MulAdd(src[i - 1][j - 1], half3x4(0.8031736h, -0.1500194h, -0.23398483h, -0.060760673h, 0.5049785h, -0.099199474h, -0.035531044h, 0.0310586h, -0.0310334h, 0.15932913h, 0.08973915h, 0.08766925h), result);
                result = MulAdd(src[i - 1][j], half3x4(-0.2187303h, 0.20974335h, 0.016500302h, 0.15386087h, 0.2381243h, -0.176845h, -0.003643712h, 0.08195259h, 0.18417378h, -0.18228108h, 0.19170114h, -0.3758241h), result);
                result = MulAdd(src[i - 1][j + 1], half3x4(0.4429508h, -0.025832538h, -0.021855514h, 0.11322045h, -0.08459551h, -0.17815724h, -0.19924322h, -0.03736318h, -0.22390507h, -0.50430673h, -0.13770194h, 0.03014482h), result);
                result = MulAdd(src[i][j - 1], half3x4(-0.15976174h, 0.31052437h, 0.2498092h, -0.29137832h, -0.10121105h, 0.35164458h, 0.4901633h, -0.35297948h, -0.2569739h, -0.14258477h, 0.12585007h, -0.2552164h), result);
                result = MulAdd(src[i][j], half3x4(-0.5260107h, -0.8547037h, 0.92173797h, 0.37817466h, -0.4162576h, 0.10989847h, 0.26875922h, 0.8614761h, 0.069195434h, 0.045593478h, 0.03790176h, 0.7332446h), result);
                result = MulAdd(src[i][j + 1], half3x4(0.14287843h, -0.283008h, -0.28487602h, -0.13313514h, -0.019538656h, -0.02361782h, 0.28037757h, -0.10543745h, 0.1586713h, 0.12037641h, 0.24249536h, 0.2524637h), result);
                result = MulAdd(src[i + 1][j - 1], half3x4(-0.037178896h, 0.23858358h, -0.18704462h, -0.13747689h, 0.07629898h, 0.2710832h, -0.71619016h, -0.09074896h, 0.30446374h, -0.0052702115h, -0.27990812h, -0.1392364h), result);
                result = MulAdd(src[i + 1][j], half3x4(-0.086045384h, 0.695562h, -0.23519892h, -0.23438415h, 0.16208446h, 0.2172693h, -0.16647956h, -0.3718635h, 0.024940055h, 0.5650778h, 0.20409326h, -0.13530363h), result);
                result = MulAdd(src[i + 1][j + 1], half3x4(-0.19389555h, -0.028506106h, -0.35060602h, 0.22244014h, 0.055054635h, -0.17651209h, -0.19871834h, -0.02667603h, -0.1402023h, -0.02455308h, -0.57856905h, -0.2174221h), result);
                tex2_UAV[destPos] = result;
            }
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x16, Conv-4x1x1x32")]
[bgfx::PASS_IO("tex1, tex2", "tex3, tex4, tex5")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;


    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos - inputPt, 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + inputPt, 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos - inputPt, 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + inputPt, 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 conv2d_2_tf = half4(0.051319666h, 0.019196881h, 0.0759832h, 0.050857317h);
    conv2d_2_tf = MulAdd(a1, half4x4(-0.14656883h, -0.044076134h, -0.40314636h, -0.08023388h, 0.12564746h, -0.21633625h, -0.0210282h, -0.19231434h, -0.019945038h, 0.020343186h, -0.007134301h, 0.013607319h, 0.07334655h, -0.050848506h, 0.0011201366h, 0.26975143h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(b1, half4x4(-0.043205153h, -0.13764456h, -0.5368405h, -0.04096279h, 0.009450832h, 0.23953767h, -0.022408254h, -0.124040656h, 0.53450584h, 0.02690831h, 0.39857075h, 0.42423433h, 0.014167992h, 0.055189077h, -0.038074926h, 0.12800713h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(c1, half4x4(-0.05354771h, -0.06626498h, 0.0092389295h, 0.100637995h, 0.05051714h, -0.0033487207h, -0.0076860636h, 0.013058279h, 0.10727092h, -0.31131467h, 0.058990292h, 0.46365786h, 0.08736531h, 0.038865663h, -0.008022449h, -0.067517675h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(d1, half4x4(-0.25327486h, -0.0041089035h, 0.04877498h, -0.36375836h, 0.0003920389h, -0.09273049h, 0.016388323h, 0.11530572h, -0.14216854h, 0.07370458h, -0.27584067h, -0.34536567h, 0.0848517h, -0.1954229h, -0.22656868h, -0.13531597h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(e1, half4x4(0.7035245h, 0.1131446h, 0.1833189h, 0.63726306h, -0.20649737h, 0.14149575h, -0.084267326h, 0.020898562h, -0.026810758h, -0.17932594h, -0.08032681h, 0.07790513h, -0.01148237h, -0.19930641h, 0.33902612h, -0.013703277h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(f1, half4x4(-0.2862842h, 0.01491211h, -0.30474076h, 0.19604082h, 0.21565811h, 0.29193363h, 0.024934597h, -0.17113955h, 0.26136434h, -0.12819171h, 0.3874644h, -0.30533502h, 0.004006889h, -0.07340657h, -0.04817435h, -0.013651047h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(g1, half4x4(-0.14331155h, -0.09605764h, -0.06941299h, -0.09740676h, 0.0059936745h, -0.27215815h, -0.31393203h, 0.17594862h, 0.045626156h, 0.060231503h, 0.10607796h, -0.030635068h, 0.15021041h, -0.19662435h, -0.14648037h, 0.028361326h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(h1, half4x4(0.25090003h, -0.2845429h, -0.30109838h, -0.070956856h, -0.08051349h, -0.07526823h, 0.13524723h, 0.14151429h, -0.1232367h, 0.08824123h, 0.28804728h, 0.31701297h, 0.014839836h, -0.09193038h, 0.30188346h, -0.07903937h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(i1, half4x4(0.21150468h, 0.13863595h, -0.2624825h, 0.1652623h, -0.026336774h, -0.45599234h, 0.015901498h, 0.23009071h, 0.19700526h, -0.11013044h, 0.19850798h, -0.19702299h, 0.060643747h, -0.03162518h, -0.18272553h, 0.24863112h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(a2, half4x4(0.16361383h, 0.0028921412h, 0.18107067h, 0.0720563h, 0.06378758h, -0.09442821h, -0.3054202h, 0.06843394h, 0.20913927h, -0.17700543h, 0.14682317h, 0.21683829h, 0.02948067h, -0.34866366h, -0.04474257h, -0.011365872h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(b2, half4x4(0.008512374h, 0.19717449h, 0.4456541h, -0.15356806h, -0.24209222h, 0.12543896h, -0.18232138h, 0.012759448h, 0.052473016h, 0.17268041h, 0.25826934h, -0.16848944h, 0.10150518h, -0.30244592h, 0.38495708h, -0.2090818h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(c2, half4x4(-0.07227807h, -0.10066125h, -0.1090768h, 0.13579647h, 0.023154313h, 0.079166815h, -0.20014893h, -0.21884407h, 0.09634875h, -0.22551452h, 0.20771019h, 0.16381831h, -0.23455033h, 0.12578821h, -0.43342614h, -0.23609087h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(d2, half4x4(-0.11084086h, -0.03875876h, -0.17912252h, -0.24158017h, 0.070904315h, 0.21862641h, 0.02659038h, -0.36572614h, 0.06265698h, 0.32029516h, 0.12044166h, 0.18424052h, 0.050192874h, 0.15095103h, 0.13794746h, -0.111053675h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(e2, half4x4(-0.11362966h, 0.5249116h, 0.27814335h, -0.023295242h, 0.022581467h, 0.3195408h, -0.06865207h, -0.13818301h, 0.18826036h, 0.21182717h, -0.30241874h, 0.02916674h, -0.19999875h, 0.8222055h, -0.2981789h, -0.31122693h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(f2, half4x4(0.058648925h, -0.39456168h, -0.36158726h, 0.4050607h, 0.0609484h, 0.01624418h, -0.2699451h, 0.25976416h, 0.31131884h, 0.18382475h, 0.12856431h, 0.3285595h, 0.4798488h, -0.26074353h, 0.78901637h, -0.071622506h), conv2d_2_tf);
    conv2d_2_tf = MulAdd(g2, half4x4(-0.038631868h, -0.20723929h, 0.045573164h, 0.10398485h, 0.20236868h, 0.14958549h, 0.18842755h, -0.23352885h, 0.18624173h, 0.2800279h, 0.23280786h, -0.12909916h, -0.037398554h, 0.1557195h, -0.04866289h, -0.13633357h), conv2d_2_tf);
