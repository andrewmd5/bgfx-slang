// Anime4K Restore CNN (Very Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex5;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex5_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex6;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex6_UAV;

[bgfx::EFFECT("Anime4K Restore VL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("CNN-based image restoration filter for anime content. Very Large variant offers highest quality with significant performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(-0.046043985h, 0.055581126h, -0.08791638h, -0.13022089h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(0.1690102h, -0.2560719h, 0.39658326h, -0.3679659h, -0.27616683h, -0.35619372h, -0.3748396h, 0.08430813h, -0.29574734h, -0.31511316h, -0.09773105h, 0.13616018h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(-0.1326393h, -0.259433h, 0.025070239h, 0.58914864h, -0.036478516h, 0.30723435h, 0.007458902h, 0.012962684h, 0.2493056h, 0.13007334h, -0.08448256h, -0.38414413h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(-0.11539356h, 0.35253766h, 0.26143202h, 0.2760807h, -0.09371543h, -0.028165473h, -0.028452158h, -0.27050856h, 0.06718067h, -0.0056619495h, -0.17654495h, 0.17288211h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(-0.16145481h, -0.3204927h, -0.54317135h, 0.11830119h, 0.49315026h, 0.12008072h, 0.50857407h, -0.30382085h, 0.25807253h, 0.020755528h, 0.29388228h, 0.106109895h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.22728722h, 0.50484747h, -0.07904469h, 0.33114597h, 0.50306976h, -0.22760947h, 0.14773269h, 0.17628263h, 0.14788547h, -0.08223464h, -0.10880935h, -0.3151985h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(0.3414351h, 0.057279214h, -0.14419858h, 0.09761111h, -0.11794496h, 0.021717256h, -0.22750235h, 0.13986664h, -0.38932344h, 0.28996095h, 0.3773904h, 0.13175532h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.1376552h, -0.19587159h, -0.35147396h, -0.097646296h, 0.1686707h, -0.14385861h, 0.031198h, 0.12383533h, -0.23089902h, 0.08707301h, 0.3362293h, -0.100579016h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(-0.056774966h, 0.047585852h, -0.36395878h, -0.20211312h, 0.4077735h, 0.12631284h, 0.39813092h, -0.033365678h, 0.2307249h, -0.09131807h, 0.20823865h, 0.31084216h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(-0.12456089h, 0.09755632h, 0.31490886h, -0.06579996h, -0.13386595h, 0.07564795h, -0.26605195h, -0.075180635h, -0.11182657h, 0.06757017h, -0.14351276h, -0.16828312h), target1);

                half4 target2 = half4(-0.0022791293h, -0.024132347h, -0.57621074h, 0.028573977h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(-0.15485518h, -0.29363206h, -0.22610365h, -0.14291525h, -0.45240572h, -0.18319772h, -0.12209436h, 0.15031648h, 0.09878383h, 0.06711082h, 0.25763842h, -0.084633484h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(-0.10204406h, 0.16167697h, 0.22371867h, -0.37947702h, -0.24476196h, -0.038824454h, 0.060157117h, 0.15764871h, -0.08072927h, -0.2210841h, -0.31835055h, 0.009979876h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(0.20506924h, 0.21132155h, -0.0922578h, -0.07430473h, 0.14529926h, 0.20549752h, 0.0077948375h, 0.13246094h, -0.32353187h, 0.21074104h, 0.092629515h, 0.17590871h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(0.04125819h, -0.44050243h, 0.23729716h, 0.3218237h, 0.12943116h, -0.011674174h, 0.10390632h, 0.027775545h, -0.20308031h, -0.16904089h, -0.2121676h, -0.022515794h), target2);
                target2 = MulAdd(src[i][j], half3x4(0.09664124h, 0.20127031h, 0.60345304h, 0.16697013h, 0.23093723h, -0.38116834h, 0.109695725h, 0.0007595324h, 0.4092646h, 0.009624758h, 0.11229678h, 0.25326383h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.014879592h, 0.19204311h, 0.07102085h, -0.7312604h, 0.34860876h, 0.3429918h, -0.027331594h, 0.27636307h, 0.1342437h, 0.107820466h, -0.12645108h, 0.21081445h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.12687613h, -0.09247973h, -0.25973785h, 0.4350873h, -0.18987224h, 0.028678741h, -0.0903819h, -0.63974863h, 0.205591h, 0.11308998h, 0.18458389h, -0.4149041h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(0.34691808h, -0.025498383h, 0.3428986h, 0.21663484h, 0.23404741h, -0.1725327h, -0.0036315925h, -0.13299675h, -0.1873967h, 0.031331502h, -0.08785591h, -0.0013278709h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.35846514h, 0.048703704h, -0.104165934h, 0.16529736h, -0.15378916h, 0.26030356h, -0.07134151h, 0.03692383h, -0.15807101h, -0.18885155h, 0.044707954h, -0.11444462h), target2);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 target1 = half4(0.018166734h, -0.11002478h, -0.05554318h, -0.0988193h);
    target1 = MulAdd(a1, half4x4(0.010346764h, 0.07230188h, -0.24734616h, -0.09937907h, 0.02228549h, -0.19550583h, -0.019540425h, -0.1037373h, 0.033996485h, -0.075554h, -0.20228972h, 0.07090153h, -0.09194035h, -0.058972966h, 0.1768268h, 0.27517542h), target1);
    target1 = MulAdd(b1, half4x4(0.020078976h, 0.12433655h, -0.1620775h, 0.036401592h, 0.079748705h, 0.11660013h, 0.17917652h, -0.017513236h, -0.18936846h, 0.24478136h, -0.45726213h, -0.045004416h, -0.08295188h, 0.067733586h, -0.080548316h, 0.2744211h), target1);
    target1 = MulAdd(c1, half4x4(0.024916803h, 0.27562472h, 0.043771956h, -0.012240604h, 0.0786355h, 0.042651594h, 0.16049327h, -0.14577515h, -0.032735053h, 0.17658092h, 0.16382934h, -0.02337374h, 0.11551492h, 0.056343183h, -0.17930213h, 0.14259394h), target1);
    target1 = MulAdd(d1, half4x4(0.20010485h, 0.06747722h, -0.19026905h, 0.11013709h, 0.13062745h, -0.044626113h, -0.0062261797h, 0.2189639h, 0.1403497h, -0.022713251h, -0.19452858h, -0.010305412h, -0.06407589h, 0.09836748h, 0.025805516h, 0.23430973h), target1);
    target1 = MulAdd(e1, half4x4(-0.14664203h, 0.034910418h, 0.024714258h, -0.066872925h, -0.15717538h, -0.14179383h, -0.14091893h, 0.05859166h, 0.18919097h, -0.18544437h, -0.09068573h, -0.08615929h, -0.051434122h, 0.2170678h, 0.18409058h, -0.17461225h), target1);
    target1 = MulAdd(f1, half4x4(-0.11354446h, 0.10745854h, 0.2682663h, 0.05949201h, -0.10695986h, 0.1407851h, -0.03551388h, 0.10691649h, -0.17148238h, -0.38287184h, 0.2074456h, 0.11828914h, 0.048535194h, 0.1464864h, -0.18169662h, -0.14074169h), target1);
    target1 = MulAdd(g1, half4x4(0.22160622h, -0.1513045h, -0.053284165h, 0.033202525h, 0.15574448h, -0.043640967h, -0.0093824165h, -0.0019965349h, -0.097964935h, -0.08289824h, 0.08239996h, 0.07868361h, 0.05731752h, -0.20441617h, -0.013016076h, -0.253108h), target1);
    target1 = MulAdd(h1, half4x4(-0.031249097h, -0.2272863h, 0.23573665h, 0.03357689h, 0.011395065h, -0.10885564h, -0.06287508h, -0.031719524h, 0.10331069h, 0.17560169h, 0.18303394h, 0.022961004h, -0.17011635h, -0.24371737h, 0.10678694h, -0.3222825h), target1);
    target1 = MulAdd(i1, half4x4(-0.1275465h, -0.08844758h, 0.10994917h, -0.00910273h, 0.09393154h, 0.03894992h, 0.14367905h, -0.11811715h, -0.09077633h, -0.015776094h, 0.27427456h, -0.13283503h, 0.18724327h, -0.08139094h, 0.04933602h, -0.051852766h), target1);
    target1 = MulAdd(a2, half4x4(-0.06764611h, -0.27426586h, 0.12045272h, 0.09410856h, -0.14258035h, 0.11802992h, -0.09093882h, 0.0022018093h, 0.4590643h, 0.046258576h, -0.07827223h, 0.448011h, -0.103631735h, -0.016930219h, -0.15421398h, 0.11045997h), target1);
    target1 = MulAdd(b2, half4x4(-0.17295076h, 0.00151352h, 0.14938255h, 0.08336512h, -0.07496541h, -0.07561223h, -0.0846474h, 0.14979269h, -0.09142163h, 0.23925088h, -0.015199518h, -0.37749895h, -0.20636298h, -0.022585187h, -0.20371509h, 0.0745308h), target1);
    target1 = MulAdd(c2, half4x4(0.06458832h, -0.009722021h, -0.123604394h, 0.06548835h, -0.3039139h, -0.022024399h, 0.05297587h, -0.0626883h, 0.23556642h, 0.1516464h, -0.07004877h, -0.1845364h, -0.05918428h, 0.19158973h, -0.14983447h, 0.030489758h), target1);
    target1 = MulAdd(d2, half4x4(0.36604697h, 0.17516142h, -0.10853731h, -0.22694224h, -0.107650936h, 0.23013335h, 0.094055794h, -0.17047717h, -0.3006048h, -0.08621717h, -0.18815655h, -0.03570218h, 0.09676118h, -0.017718751h, 0.059138596h, 0.073388465h), target1);
    target1 = MulAdd(e2, half4x4(-0.12791575h, 0.101956226h, 0.13091874h, -0.046373338h, 0.04955811h, -0.04030444h, 0.13869923h, -0.046699073h, -0.42611042h, -0.7173929h, 0.052184317h, 0.6178025h, -0.02929954h, -0.07638965h, -0.15000828h, 0.030710017h), target1);
    target1 = MulAdd(f2, half4x4(0.057806686h, 0.20842272h, -0.20148766h, 0.006666912h, 0.13356528h, -0.45265228h, -0.07354092h, 0.21447696h, 0.019552143h, -0.13645506h, 0.14643854h, -0.0071413796h, -0.15487236h, -0.002250615h, 0.30622452h, 0.0033902125h), target1);
    target1 = MulAdd(g2, half4x4(0.06896002h, 0.24397352h, -0.06479052h, 0.20676947h, -0.24259068h, 0.055320013h, -0.09032122h, -0.11222854h, -0.08982342h, -0.114818625h, -0.06399291h, -0.3024516h, -0.06302166h, -0.1925528h, 0.03458982h, 0.028828239h), target1);
    target1 = MulAdd(h2, half4x4(0.09764086h, 0.09599894h, -0.0073313303h, 0.14418933h, -0.045712367h, 0.12657364h, 0.04620374h, -0.069778584h, 0.30047333h, -0.012418192h, 0.15516461h, -0.18087754h, 0.08178273h, 0.14262857h, -0.01741533h, -0.12509112h), target1);
    target1 = MulAdd(i2, half4x4(0.04697884h, -0.1506804h, 0.031823065h, 0.13397239h, -0.18396698h, 0.10681781h, -0.29586303h, -0.0039136545h, 0.17560847h, -0.12486726h, -0.018646788h, -0.20688744h, -0.030614454h, -0.0527634h, 0.23593572h, -0.10542146h), target1);
