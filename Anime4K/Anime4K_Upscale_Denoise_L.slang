// Anime4K Upscale Denoise CNN x2 (Large)
// Based on Anime4K project by bloc97

import bgfx;

#ifdef BG_FP16
#pragma warning(disable: 3557)
#endif

Texture2D INPUT;

[bgfx::SIZE("INPUT_WIDTH * 2", "INPUT_HEIGHT * 2")]
[format("rgba8")]
RWTexture2D<float4> OUTPUT;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex2_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex3;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex3_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::EFFECT("Anime4K Upscale Denoise L", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("2x upscaler with denoising for anime content. Large variant offers good quality with moderate performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Extraction Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "tex1_UAV, tex2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        $for(jj in Range(0, 2))
        {
            uint i = ii * 2;
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(i in Range(1, 3))
    {
        $for(j in Range(1, 3))
        {
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            bool shouldProcess = true;
            if (i != 1 || j != 1)
            {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
                {
                    shouldProcess = false;
                }
            }

            if (shouldProcess)
            {
                half4 target1 = half4(-0.012922576h, -0.11982956h, 0.021963459h, 0.019259451h);
                target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.050913796h, -0.05115213h, -0.0205767h, -0.26266688h, -0.12883802h, 0.107968464h, 0.03389763h, -0.70179373h, 0.0030511466h, 0.07718592h, -0.06562523h, -0.060305536h), target1);
                target1 = MulAdd(src[i - 1][j], half3x4(0.009235469h, -0.018979615h, 0.10033019h, -0.20307243h, 0.040932532h, -0.10095427h, 0.038843542h, -0.28774044h, -0.07829864h, -0.04317961h, 0.032555006h, -0.05584433h), target1);
                target1 = MulAdd(src[i - 1][j + 1], half3x4(0.23774138h, 0.04701499h, -0.16824278h, 0.025335955h, 0.30246395h, -0.037289508h, 0.070405066h, 0.03094164h, -0.0075012813h, 0.06881163h, -0.03157643h, -0.032394916h), target1);
                target1 = MulAdd(src[i][j - 1], half3x4(-0.12524955h, 0.18535072h, -0.05323482h, 0.004486272h, 0.15295836h, 0.3050709h, 0.081431866h, 0.09352846h, -0.059866652h, -0.029570978h, 0.019920588h, 0.121749535h), target1);
                target1 = MulAdd(src[i][j], half3x4(-0.2111615h, -0.1268416h, 0.45642895h, 0.47401953h, -0.7580866h, 0.5514855h, 0.96250856h, 0.7827129h, 0.0003978912h, 0.17167407h, -0.04423575h, -0.04569368h), target1);
                target1 = MulAdd(src[i][j + 1], half3x4(0.17050457h, -0.18697786h, -0.11608587h, -0.038065948h, 0.26542h, -0.7021022h, -0.33751717h, 0.053689335h, 0.10030526h, -0.19492362h, 0.069387496h, 0.07228368h), target1);
                target1 = MulAdd(src[i + 1][j - 1], half3x4(0.15900351h, -0.017636139h, 0.01917807h, 0.05584281h, 0.28530255h, 0.04795445h, -0.104170926h, 0.1192509h, 0.09859251h, 0.057123564h, 0.025724344h, -0.07723904h), target1);
                target1 = MulAdd(src[i + 1][j], half3x4(-0.06581913h, 0.07548721h, -0.054552317h, -0.08317343h, 0.32851526h, -0.2362575h, -0.39470714h, -0.073999345h, 0.07246812h, -0.04103072h, 0.06058696h, 0.09532553h), target1);
                target1 = MulAdd(src[i + 1][j + 1], half3x4(-0.12524493h, 0.095179625h, -0.0918538h, 0.016793616h, -0.48433152h, 0.03702525h, -0.100864686h, -0.0018861603h, -0.14784335h, -0.048320837h, -0.057494648h, -0.024096634h), target1);

                half4 target2 = half4(-0.0018859988h, 0.004285429h, 0.5060845h, -0.030093472h);
                target2 = MulAdd(src[i - 1][j - 1], half3x4(0.04816902h, 0.030087546h, 0.019183155h, -0.08234757h, 0.09378316h, -0.047217257h, -0.04757087h, -0.16541782h, -0.043394983h, 0.05779227h, 0.018105166h, 0.03222583h), target2);
                target2 = MulAdd(src[i - 1][j], half3x4(0.13639967h, -0.001877575h, 0.049495522h, 0.060094353h, 0.015303669h, 0.059043188h, 0.090356335h, -0.12654372h, 0.06469071h, -0.054733396h, -0.013548386h, -0.093697555h), target2);
                target2 = MulAdd(src[i - 1][j + 1], half3x4(-0.13214277h, 0.00062924915h, -0.640379h, -0.052121993h, -0.022532608h, 0.01077454h, -0.057074178h, -0.103670195h, -0.0017062012h, 0.0035225085h, -0.044859786h, -0.020764757h), target2);
                target2 = MulAdd(src[i][j - 1], half3x4(0.2553945h, -0.08126201h, 0.055215932h, 0.10690791h, 0.6771195h, 0.09377514h, -0.09488318h, -0.43969935h, 0.35444704h, -0.10392259h, 0.07595239h, 0.021814484h), target2);
                target2 = MulAdd(src[i][j], half3x4(-0.37628967h, 0.026895085h, 0.035044484h, -0.16414654h, -0.5694931h, -0.20123884h, 0.14891861h, 1.1822934h, -0.25648627h, 0.14110301h, -0.057699542h, 0.17731132h), target2);
                target2 = MulAdd(src[i][j + 1], half3x4(0.023089241h, 0.14888923h, -0.2730167h, 0.1330048h, -0.039043408h, 0.75768983h, 0.07385114h, 0.0138615575h, -0.06565686h, 0.10451973h, 0.037489507h, 0.021156311h), target2);
                target2 = MulAdd(src[i + 1][j - 1], half3x4(0.03965048h, 0.040422294h, -0.0662493h, -0.043219455h, 0.00834316h, -0.08315282h, 0.13010995h, -0.11822414h, -0.06811034h, 0.029744523h, -0.098641835h, -0.063671604h), target2);
                target2 = MulAdd(src[i + 1][j], half3x4(-0.077282995h, -0.29400682h, 0.116103284h, 0.096747644h, -0.47398612h, -0.77101594h, -0.20683232h, 0.111703634h, -0.08370965h, -0.24218678h, 0.13780457h, -0.017660126h), target2);
                target2 = MulAdd(src[i + 1][j + 1], half3x4(0.08542605h, 0.13080615h, 0.081582755h, -0.00024888176h, 0.31160986h, 0.17787197h, -0.019935975h, -0.09658498h, 0.096656196h, 0.064402744h, -0.033331197h, 0.027531069h), target2);

                tex1_UAV[destPos] = target1;
                tex2_UAV[destPos] = target2;
            }
        }
    }
}

[bgfx::PASS(2, "Feature Processing Conv-4x3x3x16")]
[bgfx::PASS_IO("tex1, tex2", "tex3_UAV, tex4_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = tid.xy;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 a1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(tex1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(tex1.SampleLevel(sam, pos, 0));
    half4 f1 = half4(tex1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(tex1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(tex2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(tex2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(tex2.SampleLevel(sam, pos, 0));
    half4 f2 = half4(tex2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(tex2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 target1 = half4(0.03144068h, -0.027781913h, 0.04483475h, 0.037489943h);
    target1 = MulAdd(a1, half4x4(0.34559122h, 0.052896723h, -0.27492252h, -0.1604473h, 0.4791457h, 0.17956258h, 0.0076199574h, -0.16324736h, -0.075430416h, 0.019434236h, -0.275363h, -0.16502565h, 0.05507322h, -0.046572465h, 0.08130956h, 0.009380191h), target1);
    target1 = MulAdd(b1, half4x4(0.1754505h, 0.10862336h, -0.14956018h, 0.20161937h, 0.16598102h, -0.0033441933h, 0.19303258h, 0.3278992h, -0.31819978h, 0.14614153h, 0.08434212h, 0.21208692h, -0.0014794758h, -0.06754758h, -0.06314527h, 0.023496931h), target1);
    target1 = MulAdd(c1, half4x4(0.13594365h, -0.06382366h, -0.40069854h, -0.087743916h, 0.022426397h, -0.073364444h, -0.19371308h, 0.09916138h, -0.044016927h, 0.0018689828h, -0.07705671h, 0.15398589h, -0.069929935h, -0.01874144h, 0.050793763h, 0.06565281h), target1);
    target1 = MulAdd(d1, half4x4(0.56292456h, 0.25537506h, -0.16147509h, 0.029484648h, 0.11898947h, 0.19103922h, -0.2387553h, 0.13659279h, -0.044804625h, -0.10285909h, 0.12958583h, 0.21526133h, 0.02727471h, 0.21990417h, 0.0009558564h, 0.12372512h), target1);
    target1 = MulAdd(e1, half4x4(-0.10264466h, -0.13103753h, -0.069214605h, 0.43234769h, 0.25947884h, -0.18333039h, -0.15585582h, -0.2406589h, 0.33275372h, -0.19497354h, -0.09758474h, -0.4531396h, 0.41932744h, -0.043746196h, 0.08315102h, -0.085604236h), target1);
    target1 = MulAdd(f1, half4x4(0.15380725h, -0.06311845h, -0.28896615h, -0.059237756h, -0.078456834h, -0.11623796h, 0.017248835h, 0.098803006h, -0.13643564h, -0.0029720776h, 0.425954h, 0.36920592h, -0.06980546h, 0.05205535h, -0.15787347h, -0.094921984h), target1);
    target1 = MulAdd(g1, half4x4(0.009595518h, -0.12598279h, -0.04322495h, -0.08838463h, 0.11729769h, -0.062454883h, 0.19743776h, -0.08590505h, -0.022744715h, 0.00457582h, -0.06070008h, 0.045312855h, -0.010845991h, -0.02241941h, 0.07252932h, 0.05525124h), target1);
    target1 = MulAdd(h1, half4x4(-0.119069465h, 0.08782395h, 0.17878884h, 0.0068233046h, -0.36698806h, -0.46077076h, 0.37470114h, 0.006550318h, 0.08622002h, -0.10081386h, 0.1754186h, 0.078841425h, 0.060330488h, 0.39436886h, 0.1688179h, -0.10113108h), target1);
    target1 = MulAdd(i1, half4x4(0.17160045h, -0.18541232h, -0.093926296h, 0.0053854887h, -0.07649591h, -0.3053692h, 0.15255369h, 0.06183564h, 0.105131835h, 0.076607525h, -0.17482935h, -0.104579754h, -0.4795174h, 0.30223432h, 0.4728322h, 0.106419675h), target1);
    target1 = MulAdd(a2, half4x4(-0.068794325h, -0.019651407h, 0.048906703h, 0.10097784h, 0.014003637h, 0.08358555h, -0.34008583h, 0.1677446h, 0.12863056h, 0.010167976h, 0.10771957h, -0.14823496h, -0.11855097h, 0.024728613h, -0.06394353h, 0.07123295h), target1);
    target1 = MulAdd(b2, half4x4(0.1652107h, -0.056815207h, 0.26562792h, -0.02586732h, 0.13812682h, 0.3791579h, -0.40067768h, 0.19901459h, -0.055583958h, 0.06673556h, -0.16258197h, 0.0014027074h, 0.13844898h, 0.17588624h, 0.0061608437h, 0.014889389h), target1);
    target1 = MulAdd(c2, half4x4(0.023591522h, -0.06255483h, -0.04512753h, -0.07939918h, 0.17603582h, -0.06219873h, -0.10907254h, 0.012348696h, -0.053350568h, 0.023741387h, 0.05215983h, 0.117241465h, 0.28173143h, 0.11200327h, -0.11672438h, -0.13278063h), target1);
    target1 = MulAdd(d2, half4x4(-0.15015969h, -0.1145909h, 0.08583166h, 0.0386507h, -0.17788467h, 0.29311427h, 0.03577728h, -0.006737705h, -0.020426478h, 0.065881886h, -0.10966947h, -0.016716056h, -0.0027577002h, -0.20769168h, 0.4357363h, -0.13179652h), target1);
    target1 = MulAdd(e2, half4x4(-0.44572783h, 0.08870803h, 0.42933974h, -0.16602941h, 0.23271243h, 0.29478154h, -0.53973556h, -0.042550746h, -0.13157314h, -0.0413034h, 0.12679552h, 0.11579286h, -0.5161936h, -0.24292113h, -0.10862491h, 0.13528119h), target1);
    target1 = MulAdd(f2, half4x4(-0.043000877h, 0.08458555h, 0.11260604h, -0.5589381h, -0.16010836h, -0.019429926h, 0.04731505h, -0.12212733h, 0.05655828h, 0.0107375225h, -0.10067243h, -0.06904067h, 0.07476142h, -0.043922618h, -0.13811466h, 0.008697587h), target1);
    target1 = MulAdd(g2, half4x4(-0.3281664h, -0.104251154h, 0.07188181h, 0.06720938h, 0.028879764h, 0.07302547h, 0.18261562h, -0.08896491h, 0.11240943h, -0.1919612h, -0.13059135h, -0.07057044h, 0.053953633h, 0.17297988h, -0.20344415h, 0.050276734h), target1);
    target1 = MulAdd(h2, half4x4(-0.41925356h, 0.020309223h, 0.2246313h, -0.3418901h, -0.20863962h, 0.18653068h, -0.04616101h, 0.1236236h, -0.062179156h, 0.1437903h, 0.1314142h, 0.0699381h, 0.029918872h, 0.23033592h, 0.09302733h, -0.20570321h), target1);
    target1 = MulAdd(i2, half4x4(0.07847491h, -0.18251555h, 0.0678772h, -0.29089385h, -0.03632992h, -0.17132603h, -0.04896196h, 0.09839614h, -0.10377483h, -0.11817732h, 0.03477946h, 0.050376516h, 0.17791937h, -0.34359503h, 0.030756304h, 0.025246387h), target1);
    target1 = MulAdd(na1, half4x4(-0.12972409h, 0.032459006h, -0.20415276h, 0.31407776h, -0.1743501h, -0.26177478h, -0.07577315h, -0.104599h, -0.025548192h, -0.23483936h, 0.40139225h, 0.12898883h, 0.06533049h, -0.09545806h, -0.032093894h, 0.0032956926h), target1);
    target1 = MulAdd(nb1, half4x4(0.22749326h, -0.20613275h, -0.23030083h, -0.29994026h, -0.18482473h, -0.038720988h, -0.13339107h, -0.1394514h, 0.36952803h, -0.2709558h, -0.14104684h, -0.17859542h, 0.09873891h, 0.04330318h, 0.15205383h, 0.115995236h), target1);
