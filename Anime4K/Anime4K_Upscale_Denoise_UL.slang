[bgfx::PASS(6, "Conv-4x3x3x24")]
[bgfx::PASS_IO("conv2d_4_tf, conv2d_4_tf1, conv2d_4_tf2", "conv2d_5_tf_UAV, conv2d_5_tf1_UAV, conv2d_5_tf2_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass6(uint3 tid: SV_DispatchThreadID)
{

    uint2 gxy = tid.xy;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    // [ a, d, g ]
    // [ b, e, h ]
    // [ c, f, i ]
    half4 a1 = half4(conv2d_4_tf.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(conv2d_4_tf.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(conv2d_4_tf.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(conv2d_4_tf.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(conv2d_4_tf.SampleLevel(sam, pos, 0));
