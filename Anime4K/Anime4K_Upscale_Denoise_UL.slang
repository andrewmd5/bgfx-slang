[format("rgba16f")]
Texture2D conv2d_6_tf;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> conv2d_6_tf_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D conv2d_6_tf1;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> conv2d_6_tf1_UAV;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
Texture2D conv2d_6_tf2;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> conv2d_6_tf2_UAV;

[bgfx::EFFECT("Anime4K Upscale Denoise UL", 2)]
[bgfx::CATEGORY("Anime4K")]
[bgfx::DESCRIPTION("CNN-based upscaling with denoising for anime content. Ultra Large variant offers maximum quality with highest performance cost.")]
[bgfx::FP16]
[bgfx::PASS(1, "Conv-4x3x3x3")]
[bgfx::PASS_IO("INPUT", "conv2d_tf_UAV, conv2d_tf1_UAV, conv2d_tf2_UAV")]
[bgfx::BLOCK_SIZE(16, 16)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID)
{

    uint2 gxy = (Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) << 1) + (tid.xy / 8) * 16;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
        return;
    }

    float2 inputPt = GetInputPt();

    half3 src[4][4];
    $for(ii in Range(0, 2))
    {
        uint i = ii * 2;
        $for(jj in Range(0, 2))
        {
            uint j = jj * 2;
            float2 tpos = (gxy + uint2(i, j)) * inputPt;
            const half4 sr = half4(INPUT.GatherRed(sam, tpos));
            const half4 sg = half4(INPUT.GatherGreen(sam, tpos));
            const half4 sb = half4(INPUT.GatherBlue(sam, tpos));

            // w z
            // x y
            src[i][j] = half3(sr.w, sg.w, sb.w);
            src[i][j + 1] = half3(sr.x, sg.x, sb.x);
            src[i + 1][j] = half3(sr.z, sg.z, sb.z);
            src[i + 1][j + 1] = half3(sr.y, sg.y, sb.y);
        }
    }

    $for(ii in Range(1, 3))
    {
        uint i = ii;
        $for(jj in Range(1, 3))
        {
            uint j = jj;
            uint2 destPos = gxy + uint2(i - 1, j - 1);

            if (i != 1 || j != 1) {
                if (destPos.x >= inputSize.x || destPos.y >= inputSize.y) {
                }
            }

            half4 target1 = { 0.0366252, 0.028346894, 0.033923555, 0.00025824012 };
            target1 = MulAdd(src[i - 1][j - 1], half3x4(-0.21481565h, -0.0914136h, -0.067639425h, -0.13521406h, 0.14386347h, -0.007917821h, -0.0018606511h, -0.07272963h, 0.09651574h, 0.09874618h, 0.06434639h, 0.1787858h), target1);
            target1 = MulAdd(src[i - 1][j], half3x4(-0.06402414h, -0.014693245h, -0.25395226h, 0.2960157h, -0.12494867h, 0.17711689h, 0.31812787h, -0.22346497h, -0.1172598h, -0.17087954h, -0.031076867h, -0.26865217h), target1);
            target1 = MulAdd(src[i - 1][j + 1], half3x4(-0.19254248h, -0.049369957h, 0.08171505h, -0.12660322h, 0.11544268h, 0.15840095h, -0.11473022h, 0.144489h, 0.07068809h, 0.041438796h, 0.10749463h, -0.057156503h), target1);
            target1 = MulAdd(src[i][j - 1], half3x4(0.040826935h, 0.0030781324h, 0.094986334h, -0.2573781h, -0.11649985h, 0.018165307h, 0.039985053h, -0.15652324h, -0.014886749h, -0.00988401h, -0.15025067h, -0.0031970344h), target1);
            target1 = MulAdd(src[i][j], half3x4(-0.15658751h, 0.08227927h, 0.23491348h, 0.29900867h, -0.45667845h, 0.0438649h, -0.39066258h, 0.6590342h, 0.009331404h, 0.097770594h, 0.21618316h, 0.25005254h), target1);
            target1 = MulAdd(src[i][j + 1], half3x4(-0.16455166h, 0.013149855h, 0.21515559h, 0.03110101h, -0.008973558h, 0.33310282h, -0.03276024h, -0.3356557h, 0.007899698h, 0.295166h, -0.73289853h, 0.16696596h), target1);
            target1 = MulAdd(src[i + 1][j - 1], half3x4(0.2691608h, 0.09478436h, 0.006536417h, -0.04095308h, -0.10942356h, -0.0481289h, -0.039660163h, -0.20591366h, -0.08013109h, -0.052268907h, 0.046878606h, -0.024840442h), target1);
            target1 = MulAdd(src[i + 1][j], half3x4(0.17120434h, -0.06828329h, -0.23515487h, 0.11830264h, 0.67815524h, -0.10693793h, 0.2392081h, -0.3192851h, 0.06719006h, -0.03441811h, 0.020009553h, -0.21328516h), target1);
            target1 = MulAdd(src[i + 1][j + 1], half3x4(0.30072933h, 0.0348702h, 0.15155697h, -0.15580897h, -0.12755825h, -0.57249874h, -0.10091004h, 0.22914392h, -0.017671h, -0.26088336h, -0.00079997425h, -0.022365946h), target1);

            half4 target2 = { -0.043337345, 0.16099554, -0.030338328, 0.0074565704 };
            target2 = MulAdd(src[i - 1][j - 1], half3x4(0.042849753h, -0.11642484h, 0.073895186h, 0.15186316h, -0.024499241h, 0.056690346h, 0.05013788h, -0.10182528h, -0.024302427h, 0.06578479h, -0.028199008h, -0.070577h), target2);
            target2 = MulAdd(src[i - 1][j], half3x4(-0.040659044h, 0.22913207h, -0.1847038h, -0.11781796h, 0.044752445h, 0.009552658h, -0.11374249h, 0.12798874h, 0.056919675h, -0.20839268h, 0.11021251h, 0.044297826h), target2);
            target2 = MulAdd(src[i - 1][j + 1], half3x4(-0.009999239h, 0.1996945h, -0.29797587h, -0.4280957h, -0.008521183h, -0.10773894h, 0.22186345h, 0.254737h, -0.003993275h, -0.07186837h, 0.16690473h, 0.19043307h), target2);
            target2 = MulAdd(src[i][j - 1], half3x4(-0.16174923h, 0.26882383h, 0.50559163h, 0.38955548h, 0.14091976h, -0.15637094h, -0.11826545h, -0.23424837h, 0.01674066h, -0.08578336h, -0.16907434h, -0.19845173h), target2);
            target2 = MulAdd(src[i][j], half3x4(0.10735882h, -0.016069679h, 0.42237386h, -0.19937111h, 0.07271503h, 0.07596921h, -0.24035113h, 0.12406044h, 0.059160866h, -0.051063746h, -0.36897844h, 0.061272774h), target2);
            target2 = MulAdd(src[i][j + 1], half3x4(0.015712388h, -0.34878746h, -0.66418105h, -0.35441992h, -0.12208571h, 0.042238027h, 0.30143425h, 0.3610614h, -0.09538538h, 0.25334427h, 0.24629802h, 0.030739667h), target2);
            target2 = MulAdd(src[i + 1][j - 1], half3x4(-0.0035519397h, 0.07191882h, -0.20775351h, -0.15425798h, 0.07919461h, 0.07578178h, 0.12668823h, 0.0011835548h, 0.03245292h, -0.105801836h, 0.24585879h, 0.13730717h), target2);
            target2 = MulAdd(src[i + 1][j], half3x4(0.2415042h, -0.16800308h, 0.48690978h, 0.75166744h, 0.3876131h, 0.038878918h, -0.3293806h, -0.47433355h, 0.057803743h, 0.09533431h, -0.1342232h, -0.2982094h), target2);
            target2 = MulAdd(src[i + 1][j + 1], half3x4(-0.18697992h, -0.60250723h, -0.11149202h, -0.015566043h, -0.57483697h, 0.07203411h, 0.050863862h, -0.078300595h, -0.09433572h, 0.27099958h, -0.03195694h, 0.10535165h), target2);

            half4 target3 = { -0.51499516, 0.026265146, 0.05636954, 0.03170462 };
            target3 = MulAdd(src[i - 1][j - 1], half3x4(-0.05112635h, -0.09334158h, -0.031148188h, -0.041258592h, -0.04633252h, 0.022155467h, 0.16979018h, 0.06819186h, 0.094320215h, 0.02111737h, -0.15604521h, -0.15083192h), target3);
            target3 = MulAdd(src[i - 1][j], half3x4(0.10213034h, 0.41852444h, 0.32454407h, -0.058512308h, -0.054484565h, -0.24399261h, -0.26164648h, -0.34274867h, -0.06912002h, 0.02257528h, 0.2588075h, 0.24375258h), target3);
            target3 = MulAdd(src[i - 1][j + 1], half3x4(0.019957408h, 0.06354756h, 0.10109863h, 0.16890836h, 0.06791468h, 0.1259216h, 0.3096521h, 0.07912831h, -0.08293642h, -0.16565439h, -0.050881315h, -0.0576009h), target3);
            target3 = MulAdd(src[i][j - 1], half3x4(0.19822149h, 0.34747612h, -0.20176221h, 0.042434175h, -0.029007072h, -0.1637076h, -0.09433387h, 0.32732537h, -0.12577844h, -0.049755163h, 0.091352955h, 0.27023584h), target3);
            target3 = MulAdd(src[i][j], half3x4(-0.26348627h, 0.52249527h, -0.4091685h, -0.41065818h, 0.050318573h, 0.06534145h, -0.15470429h, 0.52704567h, 0.08808197h, -0.37854514h, -0.22827432h, 0.1498618h), target3);
            target3 = MulAdd(src[i][j + 1], half3x4(-0.0865881h, -0.8053624h, 0.088793345h, -0.22072543h, -0.0141816195h, 0.0049849018h, 0.21256319h, -0.327414h, 0.1364984h, 0.4927693h, 0.1848864h, -0.18559869h), target3);
            target3 = MulAdd(src[i + 1][j - 1], half3x4(-0.11838837h, 0.056446314h, 0.08738398h, 0.31899074h, 0.056432292h, -0.0008520313h, 0.018734995h, -0.33501405h, -0.00918473h, -0.040785775h, 0.04093389h, -0.19747448h), target3);
            target3 = MulAdd(src[i + 1][j], half3x4(0.66065794h, -0.5208613h, -0.018835181h, 0.26112127h, 0.055486765h, 0.113573246h, -0.05028873h, 0.05364108h, 0.040549137h, 0.28754827h, -0.16565348h, -0.37204087h), target3);
            target3 = MulAdd(src[i + 1][j + 1], half3x4(0.06361742h, 0.00907182h, 0.06848412h, 0.0057870117h, -0.05289465h, 0.068106346h, -0.15660144h, -0.20288356h, -0.093512855h, -0.17268412h, 0.030761726h, 0.36189792h), target3);

            conv2d_tf_UAV[destPos] = float4(target1);
            conv2d_tf1_UAV[destPos] = float4(target2);
            conv2d_tf2_UAV[destPos] = float4(target3);
        }
    }
}

[bgfx::PASS(2, "Conv-4x3x3x24")]
[bgfx::PASS_IO("conv2d_tf, conv2d_tf1, conv2d_tf2", "conv2d_1_tf_UAV, conv2d_1_tf1_UAV, conv2d_1_tf2_UAV")]
[bgfx::BLOCK_SIZE(8, 8)]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{

    uint2 gxy = tid.xy;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y) {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    // [ a, d, g ]
    // [ b, e, h ]
    // [ c, f, i ]
    half4 a1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e1 = half4(conv2d_tf.SampleLevel(sam, pos, 0));
    half4 f1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i1 = half4(conv2d_tf.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na1 = max(-a1, half4(0));
    half4 nb1 = max(-b1, half4(0));
    half4 nc1 = max(-c1, half4(0));
    half4 nd1 = max(-d1, half4(0));
    half4 ne1 = max(-e1, half4(0));
    half4 nf1 = max(-f1, half4(0));
    half4 ng1 = max(-g1, half4(0));
    half4 nh1 = max(-h1, half4(0));
    half4 ni1 = max(-i1, half4(0));

    a1 = max(a1, half4(0));
    b1 = max(b1, half4(0));
    c1 = max(c1, half4(0));
    d1 = max(d1, half4(0));
    e1 = max(e1, half4(0));
    f1 = max(f1, half4(0));
    g1 = max(g1, half4(0));
    h1 = max(h1, half4(0));
    i1 = max(i1, half4(0));

    half4 a2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e2 = half4(conv2d_tf1.SampleLevel(sam, pos, 0));
    half4 f2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i2 = half4(conv2d_tf1.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na2 = max(-a2, half4(0));
    half4 nb2 = max(-b2, half4(0));
    half4 nc2 = max(-c2, half4(0));
    half4 nd2 = max(-d2, half4(0));
    half4 ne2 = max(-e2, half4(0));
    half4 nf2 = max(-f2, half4(0));
    half4 ng2 = max(-g2, half4(0));
    half4 nh2 = max(-h2, half4(0));
    half4 ni2 = max(-i2, half4(0));

    a2 = max(a2, half4(0));
    b2 = max(b2, half4(0));
    c2 = max(c2, half4(0));
    d2 = max(d2, half4(0));
    e2 = max(e2, half4(0));
    f2 = max(f2, half4(0));
    g2 = max(g2, half4(0));
    h2 = max(h2, half4(0));
    i2 = max(i2, half4(0));

    half4 a3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(-inputPt.x, -inputPt.y), 0));
    half4 b3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0));
    half4 c3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0));
    half4 d3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0));
    half4 e3 = half4(conv2d_tf2.SampleLevel(sam, pos, 0));
    half4 f3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(0, inputPt.y), 0));
    half4 g3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0));
    half4 h3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0));
    half4 i3 = half4(conv2d_tf2.SampleLevel(sam, pos + float2(inputPt.x, inputPt.y), 0));

    half4 na3 = max(-a3, half4(0));
    half4 nb3 = max(-b3, half4(0));
