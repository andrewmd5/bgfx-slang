        target1 = mad(src[3][3], half4(-0.0376542955636978h, -0.0137260686606169h, -0.2183600962162018h, -0.0829529240727425h), target1);
        target1 = mad(src[3][4], half4(0.0143303163349628h, 0.0085790483281016h, 0.0312815308570862h, 0.0557830408215523h), target1);
        target1 = mad(src[4][0], half4(0.0196402054280043h, 0.0245775021612644h, 0.0333996489644051h, 0.0064323167316616h), target1);
