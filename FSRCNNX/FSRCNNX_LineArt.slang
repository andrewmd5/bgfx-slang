    target1 = MulAdd(bl2, half4x4(0.0441149584949017h, -0.1473216116428375h, 0.1350974887609482h, -0.2101743519306183h, 0.4860914349555969h, -0.0438372306525707h, 0.1496813595294952h, 0.1337997019290924h, 0.2939592599868774h, -0.2875731289386749h, 0.3024089336395264h, 0.2730985283851624h, 0.3860357403755188h, -0.2070714235305786h, 0.0471001267433167h, 0.0515876151621342h), target1);
    target1 = MulAdd(tc1, half4x4(-0.0282726809382439h, -0.0808876901865005h, -0.1294671446084976h, 0.0327957235276699h, 0.2005466669797897h, 0.0710152760148048h, -0.2951858937740326h, 0.1284866034984589h, -0.3245949447154999h, -0.2784474790096283h, -0.0651488602161407h, 0.2024642229080200h, -0.1790685206651688h, -0.1523464322090149h, 0.0683958381414413h, -0.0721997469663620h), target1);
    target1 = MulAdd(tc2, half4x4(0.2084605693817139h, 0.2224501073360443h, 0.2990169227123260h, -0.0822417438030243h, 0.1661120802164078h, 0.2242873460054398h, 0.3008987009525299h, -0.0589924007654190h, 1.0089585781097412h, 0.3364263474941254h, 0.3114744126796722h, -0.4205997586250305h, 0.2149223387241364h, -0.2686808407306671h, 0.6869788169860840h, 0.0397010855376720h), target1);
    target1 = MulAdd(mc1, half4x4(-0.1719545274972916h, 0.2342357635498047h, -0.1108281537890434h, 0.0051285717636347h, -0.5348495244979858h, -0.0063809715211391h, -0.2947000265121460h, 0.0092384787276387h, 0.1788431107997894h, -0.8757466077804565h, -0.0199933666735888h, -0.0933040529489517h, -1.1017562150955200h, -1.1397477388381958h, -0.8490890264511108h, 2.0844755172729492h), target1);
