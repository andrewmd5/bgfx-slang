[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

static const half2x3 rgb2uv = {
    -0.169h, -0.331h, 0.5h,
    0.5h, -0.419h, -0.081h
};

static const half3x3 yuv2rgb = {
    1, -0.00093h, 1.401687h,
    1, -0.3437h, -0.71417h,
    1, 1.77216h, 0.00099h
};

half GetLuma(half3 rgb)
{
    return dot(half3(0.299h, 0.587h, 0.114h), rgb);
}

#define SH_PIXELS_X 36
#define SH_PIXELS_Y 28

groupshared half shPixelsY[SH_PIXELS_Y][SH_PIXELS_X];

[bgfx::EFFECT("FSRCNNX LineArt", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("FSRCNNX - Fast super-resolution convolutional neural network for real-time upscaling")]
[bgfx::FP16]
[bgfx::PASS(1, "feature map")]
[bgfx::PASS_IO("INPUT", "featureMap1_UAV, featureMap2_UAV")]
[bgfx::BLOCK_SIZE(32, 24)]
[shader("compute")]
[numthreads(128, 1, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID, uint3 gtid: SV_GroupThreadID, uint3 gid: SV_GroupID)
{
    uint2 blockStart = gid.xy * uint2(32, 24);
    float2 inputPt = GetInputPt();
    uint2 inputSize = GetInputSize();
    uint i;

    for (i = gtid.x * 2; i < SH_PIXELS_X * SH_PIXELS_Y / 2; i += 128 * 2)
    {
        uint2 pos = uint2(i % SH_PIXELS_X, i / SH_PIXELS_X * 2);
        const float2 tpos = (blockStart + pos - 1.5f) * inputPt;

        half4 sr = (half4)INPUT.GatherRed(sam, tpos);
        half4 sg = (half4)INPUT.GatherGreen(sam, tpos);
        half4 sb = (half4)INPUT.GatherBlue(sam, tpos);

        shPixelsY[pos.y][pos.x] = GetLuma(half3(sr.w, sg.w, sb.w));
        shPixelsY[pos.y][pos.x + 1] = GetLuma(half3(sr.z, sg.z, sb.z));
        shPixelsY[pos.y + 1][pos.x] = GetLuma(half3(sr.x, sg.x, sb.x));
        shPixelsY[pos.y + 1][pos.x + 1] = GetLuma(half3(sr.y, sg.y, sb.y));
    }

    GroupMemoryBarrierWithGroupSync();

    for (i = gtid.x; i < 32 * 24; i += 128)
    {
        uint2 pos = uint2(i % 32, i / 32);
        uint2 destPos = blockStart + pos;

        if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
        {
            continue;
        }

        half src[5][5];
        $for(ii in Range(0, 5))
        {
            $for(jj in Range(0, 5))
            {
                src[jj][ii] = shPixelsY[pos.y + ii][pos.x + jj];
            }
        }

        half4 target1 = half4(-0.3117050230503082h, 0.1817725896835327h, 0.0011673698900267h, -0.0044658286496997h);
        target1 = mad(src[0][0], half4(-0.0187959559261799h, -0.0206312909722328h, 0.0226501729339361h, 0.0111862262710929h), target1);
        target1 = mad(src[0][1], half4(0.0469042696058750h, 0.0428658165037632h, -0.0208927169442177h, -0.0053485808894038h), target1);
        target1 = mad(src[0][2], half4(0.0486242026090622h, 0.0268428903073072h, -0.1095351055264473h, -0.0197027549147606h), target1);
        target1 = mad(src[0][3], half4(-0.0301427692174911h, -0.0444439016282558h, 0.0803908482193947h, -0.0072240661829710h), target1);
        target1 = mad(src[0][4], half4(0.0097448397427797h, 0.0132117131724954h, -0.0087575586512685h, 0.0003270092420280h), target1);
        target1 = mad(src[1][0], half4(0.0227436870336533h, 0.0284603293985128h, -0.0899902656674385h, 0.0174379274249077h), target1);
        target1 = mad(src[1][1], half4(-0.0880827009677887h, -0.0890802741050720h, 0.3386772871017456h, -0.0749290063977242h), target1);
        target1 = mad(src[1][2], half4(-0.0832799598574638h, -0.1518420130014420h, 0.1693033277988434h, 0.1514045447111130h), target1);
        target1 = mad(src[1][3], half4(0.0490957386791706h, 0.0839962288737297h, 0.0323486365377903h, -0.0491475425660610h), target1);
        target1 = mad(src[1][4], half4(0.0281097982078791h, 0.0267692077904940h, -0.0460123419761658h, 0.0137899341061711h), target1);
        target1 = mad(src[2][0], half4(0.0592067055404186h, -0.0008030450553633h, 0.1280025541782379h, -0.0270480886101723h), target1);
