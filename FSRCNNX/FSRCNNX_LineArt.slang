        target1 = mad(src[4][3], half4(0.0111092608422041h, 0.0116711426526308h, 0.0460555553436279h, 0.0563828162848949h), target1);
        target1 = mad(src[4][4], half4(-0.0043270774185658h, -0.0096766958013177h, -0.0235258601605892h, -0.0409700050950050h), target1);

