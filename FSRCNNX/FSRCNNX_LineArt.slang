[bgfx::PASS(2, "mapping 1")]
[bgfx::PASS_IO("featureMap1, featureMap2", "tex1_UAV, tex2_UAV")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 tl1 = (half4)featureMap1.SampleLevel(sam, pos - inputPt, 0);
    half4 ml1 = (half4)featureMap1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0);
    half4 bl1 = (half4)featureMap1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0);
    half4 tc1 = (half4)featureMap1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0);
    half4 mc1 = (half4)featureMap1.SampleLevel(sam, pos, 0);
    half4 bc1 = (half4)featureMap1.SampleLevel(sam, pos + float2(0, inputPt.y), 0);
    half4 tr1 = (half4)featureMap1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0);
    half4 mr1 = (half4)featureMap1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0);
    half4 br1 = (half4)featureMap1.SampleLevel(sam, pos + inputPt, 0);

    half4 tl2 = (half4)featureMap2.SampleLevel(sam, pos - inputPt, 0);
    half4 ml2 = (half4)featureMap2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0);
    half4 bl2 = (half4)featureMap2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0);
    half4 tc2 = (half4)featureMap2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0);
    half4 mc2 = (half4)featureMap2.SampleLevel(sam, pos, 0);
    half4 bc2 = (half4)featureMap2.SampleLevel(sam, pos + float2(0, inputPt.y), 0);
    half4 tr2 = (half4)featureMap2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0);
    half4 mr2 = (half4)featureMap2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0);
    half4 br2 = (half4)featureMap2.SampleLevel(sam, pos + inputPt, 0);

    half4 target1 = half4(-0.0031195033807307h, -0.0977938771247864h, 0.0337169878184795h, 0.0840695425868034h);
    target1 = MulAdd(tl1, half4x4(0.0028950418345630h, 0.2153117954730988h, -0.1120878234505653h, 0.1065240651369095h, -0.0902118757367134h, 0.2227627933025360h, -0.1268638819456100h, 0.0378417931497097h, 0.0262128096073866h, 0.1100647151470184h, -0.0224360711872578h, -0.2487984448671341h, 0.3278627693653107h, 0.3930607438087463h, -0.3361104130744934h, -0.2318559885025024h), target1);
    target1 = MulAdd(tl2, half4x4(-0.1388952732086182h, -0.0210590325295925h, -0.0107318097725511h, 0.1340505480766296h, -0.2403931617736816h, 0.4324082732200623h, -0.1229069381952286h, -0.1129430904984474h, -0.2194076776504517h, -0.2529417872428894h, 0.2493167072534561h, 0.1228863969445229h, -0.6289532780647278h, 0.2511698901653290h, -0.1145481690764427h, -0.1931190490722656h), target1);
    target1 = MulAdd(ml1, half4x4(0.0802633240818977h, -0.2823207676410675h, -0.0453533977270126h, 0.2149281948804855h, 0.2391699999570847h, -0.3012505769729614h, -0.0672336667776108h, 0.1134754717350006h, -0.1874532252550125h, 0.2426864057779312h, 0.0001024203302222h, -0.2685940861701965h, -0.2393693625926971h, -0.0148733090609312h, 0.4815890491008759h, -0.5666245818138123h), target1);
    target1 = MulAdd(ml2, half4x4(0.2353847920894623h, 0.7481728792190552h, 0.0613395981490612h, -0.3136185705661774h, -0.6453479528427124h, 0.2987860739231110h, -0.1935778856277466h, -0.4407877624034882h, -0.1155721992254257h, -0.8143445253372192h, -0.1829861551523209h, 0.0808847546577454h, 0.3689287006855011h, -0.1318729221820831h, 0.1494798213243484h, -0.7250000834465027h), target1);
