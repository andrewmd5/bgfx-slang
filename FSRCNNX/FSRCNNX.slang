    target1 = MulAdd(bl2, half4x4(-0.0498303361237049h, 0.0224859956651926h, 0.1952174901962280h, -0.0311204437166452h, 0.2501715123653412h, -0.5893352627754211h, -1.0793941020965576h, 0.0160885509103537h, 0.5081620812416077h, 0.0482814386487007h, 0.0546359121799469h, -0.0501569248735905h, 0.1400523334741592h, -0.0106841633096337h, -0.0940591320395470h, -0.1791856139898300h), target1);
    target1 = MulAdd(tc1, half4x4(0.0393299944698811h, 0.2232691347599030h, -0.1055066883563995h, -0.1607919186353683h, -0.1567825973033905h, -0.0042221010662615h, -0.0548228211700916h, 0.2352052628993988h, 0.1483389288187027h, 0.7503526806831360h, 0.0797731876373291h, -0.0049001369625330h, -0.0242983382195234h, -0.0308702979236841h, 0.0828925222158432h, 0.0561857633292675h), target1);
    target1 = MulAdd(tc2, half4x4(0.0926392748951912h, -0.0418718457221985h, -0.3060409128665924h, -0.1883587390184402h, 0.0284292586147785h, -0.3584854304790497h, -0.7909982800483704h, -0.0187337957322598h, -0.2496993243694305h, -0.7520986795425415h, 0.3771523833274841h, -0.0259053874760866h, 0.0337998159229755h, 0.2209153026342392h, 0.0708771497011185h, -0.2814430892467499h), target1);
    target1 = MulAdd(mc1, half4x4(-0.5287809371948242h, 0.5777525901794434h, 0.0880500450730324h, -0.8452472090721130h, -0.3393408954143524h, -0.2273543328046799h, -0.1298527419567108h, 0.4990308582782745h, 1.2613251209259033h, -0.7636719942092896h, 1.5694186687469482h, -0.4087363779544830h, 0.0874531939625740h, 0.7067158818244934h, -0.3419588804244995h, -0.3265531957149506h), target1);
