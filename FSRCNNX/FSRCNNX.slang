[format("rgba16f")]
Texture2D tex4;

[bgfx::SIZE("INPUT_WIDTH", "INPUT_HEIGHT")]
[format("rgba16f")]
RWTexture2D<float4> tex4_UAV;

[bgfx::SAMPLER(FilterMode.POINT, AddressMode.CLAMP)]
SamplerState sam;

[bgfx::SAMPLER(FilterMode.LINEAR, AddressMode.CLAMP)]
SamplerState sam1;

static const half2x3 rgb2uv = {
    -0.169h, -0.331h, 0.5h,
    0.5h, -0.419h, -0.081h
};

static const half3x3 yuv2rgb = {
    1, -0.00093h, 1.401687h,
    1, -0.3437h, -0.71417h,
    1, 1.77216h, 0.00099h
};

#define SH_PIXELS_X 36
#define SH_PIXELS_Y 28

groupshared half shPixelsY[SH_PIXELS_Y][SH_PIXELS_X];

half GetLuma(half3 rgb)
{
    return dot(half3(0.299h, 0.587h, 0.114h), rgb);
}

[bgfx::EFFECT("FSRCNNX", 2)]
[bgfx::CATEGORY("Neural Network")]
[bgfx::DESCRIPTION("FSRCNNX - Fast super-resolution convolutional neural network for real-time upscaling")]
[bgfx::FP16]
[bgfx::PASS(1, "Feature Map")]
[bgfx::PASS_IO("INPUT", "featureMap1_UAV, featureMap2_UAV")]
[bgfx::BLOCK_SIZE(32, 24)]
[shader("compute")]
[numthreads(128, 1, 1)]
void Pass1(uint3 tid: SV_DispatchThreadID, uint3 gtid: SV_GroupThreadID, uint3 gid: SV_GroupID)
{
    uint2 blockStart = gid.xy * uint2(32, 24);
    float2 inputPt = GetInputPt();
    uint2 inputSize = GetInputSize();
    uint i;

    for (i = gtid.x * 2; i < SH_PIXELS_X * SH_PIXELS_Y / 2; i += 128 * 2)
    {
        uint2 pos = uint2(i % SH_PIXELS_X, i / SH_PIXELS_X * 2);
        const float2 tpos = (blockStart + pos - 1.5f) * inputPt;

        const half4 sr = (half4)INPUT.GatherRed(sam, tpos);
        const half4 sg = (half4)INPUT.GatherGreen(sam, tpos);
        const half4 sb = (half4)INPUT.GatherBlue(sam, tpos);

        shPixelsY[pos.y][pos.x] = GetLuma(half3(sr.w, sg.w, sb.w));
        shPixelsY[pos.y][pos.x + 1] = GetLuma(half3(sr.z, sg.z, sb.z));
        shPixelsY[pos.y + 1][pos.x] = GetLuma(half3(sr.x, sg.x, sb.x));
        shPixelsY[pos.y + 1][pos.x + 1] = GetLuma(half3(sr.y, sg.y, sb.y));
    }

    GroupMemoryBarrierWithGroupSync();

    for (i = gtid.x; i < 32 * 24; i += 128)
    {
        const uint2 pos = uint2(i % 32, i / 32);
        const uint2 destPos = blockStart + pos;

        if (destPos.x >= inputSize.x || destPos.y >= inputSize.y)
        {
            continue;
        }

        half src[5][5];
        $for(ii in Range(0, 5))
        {
            $for(jj in Range(0, 5))
            {
                src[jj][ii] = shPixelsY[pos.y + ii][pos.x + jj];
            }
        }

        half4 target1 = half4(-0.1572492271661758h, -0.0120896836742759h, 0.0061487639322877h, -0.2852848768234253h);
        target1 = mad(src[0][0], half4(-0.0047900392673910h, 0.0537447109818459h, -0.0000247144635068h, 0.0066653941757977h), target1);
        target1 = mad(src[0][1], half4(0.0073144687339664h, -0.0309004038572311h, -0.0109181385487318h, -0.0092840325087309h), target1);
        target1 = mad(src[0][2], half4(0.0591700896620750h, 0.1974907070398331h, -0.0197357516735792h, -0.0546554848551750h), target1);
        target1 = mad(src[0][3], half4(-0.0011764382943511h, -0.0299451071768999h, 0.0229587312787771h, 0.0021908886265010h), target1);
        target1 = mad(src[0][4], half4(0.0098101310431957h, 0.0080995410680771h, -0.0030452020000666h, -0.0132035519927740h), target1);
        target1 = mad(src[1][0], half4(-0.0168330334126949h, -0.0743711441755295h, -0.0259261634200811h, 0.0234480481594801h), target1);
        target1 = mad(src[1][1], half4(0.0239933785051107h, 0.1896541714668274h, 0.0207756329327822h, -0.0370332375168800h), target1);
        target1 = mad(src[1][2], half4(0.0094799501821399h, -0.0652511194348335h, -0.0004292793164495h, -0.0726212188601494h), target1);
        target1 = mad(src[1][3], half4(0.0297284796833992h, -0.1210186630487442h, -0.0202929321676493h, -0.0574462898075581h), target1);
        target1 = mad(src[1][4], half4(-0.0318185277283192h, 0.0840775370597839h, 0.0110451309010386h, 0.0415569432079792h), target1);
        target1 = mad(src[2][0], half4(-0.0253141783177853h, 0.1168256178498268h, 0.1159729585051537h, 0.0963164269924164h), target1);
        target1 = mad(src[2][1], half4(-0.1103615835309029h, -0.0276833958923817h, -0.4999594092369080h, 0.1053867191076279h), target1);
