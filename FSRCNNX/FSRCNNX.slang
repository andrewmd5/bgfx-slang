[bgfx::PASS(5, "Mapping 4, Sub-band Residuals")]
[bgfx::PASS_IO("tex1, tex2, featureMap1, featureMap2", "tex3_UAV, tex4_UAV")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass5(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 tl1 = (half4)tex1.SampleLevel(sam, pos - inputPt, 0);
    half4 ml1 = (half4)tex1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0);
    half4 bl1 = (half4)tex1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0);
