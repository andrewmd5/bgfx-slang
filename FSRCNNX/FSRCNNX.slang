        target1 = mad(src[3][3], half4(0.0244008023291826h, 0.1881769001483917h, -0.0206351149827242h, -0.0628309547901154h), target1);
        target1 = mad(src[3][4], half4(0.0075713125988841h, 0.0508594363927841h, 0.0430423170328140h, -0.0124188791960478h), target1);
        target1 = mad(src[4][0], half4(-0.0166875869035721h, -0.0047865519300103h, 0.0006719123339280h, 0.0316803231835365h), target1);
        target1 = mad(src[4][1], half4(-0.0058461269363761h, 0.0990798473358154h, -0.0177743826061487h, -0.0066122291609645h), target1);
        target1 = mad(src[4][2], half4(-0.0972401946783066h, -0.0225446373224258h, -0.0037693574558944h, 0.1953062713146210h), target1);
        target1 = mad(src[4][3], half4(-0.0216837190091610h, -0.1824268400669098h, 0.0069816261529922h, 0.0283037684857845h), target1);
        target1 = mad(src[4][4], half4(-0.0025767991319299h, 0.0459827110171318h, -0.0080216089263558h, 0.0084134787321091h), target1);

        half4 target2 = half4(0.0541447550058365h, 0.0088306749239564h, -0.0112389577552676h, -0.0127860950306058h);
        target2 = mad(src[0][0], half4(0.0142660010606050h, 0.0137931071221828h, 0.0061188107356429h, -0.0104134222492576h), target2);
