[bgfx::PASS(2, "Mapping 1")]
[bgfx::PASS_IO("featureMap1, featureMap2", "tex1_UAV, tex2_UAV")]
[shader("compute")]
[numthreads(8, 8, 1)]
void Pass2(uint3 tid: SV_DispatchThreadID)
{
    uint2 gxy = Swizzle8x8((tid.y % 8) * 8 + (tid.x % 8)) + (tid.xy / 8) * 8;
    uint2 inputSize = GetInputSize();
    if (gxy.x >= inputSize.x || gxy.y >= inputSize.y)
    {
        return;
    }

    float2 inputPt = GetInputPt();
    float2 pos = (gxy + 0.5f) * inputPt;

    half4 tl1 = (half4)featureMap1.SampleLevel(sam, pos - inputPt, 0);
    half4 ml1 = (half4)featureMap1.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0);
    half4 bl1 = (half4)featureMap1.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0);
    half4 tc1 = (half4)featureMap1.SampleLevel(sam, pos + float2(0, -inputPt.y), 0);
    half4 mc1 = (half4)featureMap1.SampleLevel(sam, pos, 0);
    half4 bc1 = (half4)featureMap1.SampleLevel(sam, pos + float2(0, inputPt.y), 0);
    half4 tr1 = (half4)featureMap1.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0);
    half4 mr1 = (half4)featureMap1.SampleLevel(sam, pos + float2(inputPt.x, 0), 0);
    half4 br1 = (half4)featureMap1.SampleLevel(sam, pos + inputPt, 0);

    half4 tl2 = (half4)featureMap2.SampleLevel(sam, pos - inputPt, 0);
    half4 ml2 = (half4)featureMap2.SampleLevel(sam, pos + float2(-inputPt.x, 0), 0);
    half4 bl2 = (half4)featureMap2.SampleLevel(sam, pos + float2(-inputPt.x, inputPt.y), 0);
    half4 tc2 = (half4)featureMap2.SampleLevel(sam, pos + float2(0, -inputPt.y), 0);
    half4 mc2 = (half4)featureMap2.SampleLevel(sam, pos, 0);
    half4 bc2 = (half4)featureMap2.SampleLevel(sam, pos + float2(0, inputPt.y), 0);
    half4 tr2 = (half4)featureMap2.SampleLevel(sam, pos + float2(inputPt.x, -inputPt.y), 0);
    half4 mr2 = (half4)featureMap2.SampleLevel(sam, pos + float2(inputPt.x, 0), 0);
    half4 br2 = (half4)featureMap2.SampleLevel(sam, pos + inputPt, 0);

    half4 target1 = half4(-0.0445119962096214h, -0.7632357478141785h, 0.0156328510493040h, -0.2424548566341400h);
    target1 = MulAdd(tl1, half4x4(0.1279004216194153h, -0.0275541823357344h, 0.2275633513927460h, 0.2241709381341934h, 0.0197204202413559h, -0.0456816256046295h, -0.1296672523021698h, 0.0564568229019642h, -0.0241488646715879h, -0.0237508192658424h, -0.1899632662534714h, 0.4177669584751129h, -0.1814560592174530h, -0.0526473335921764h, 0.1154382973909378h, -0.0715614855289459h), target1);
    target1 = MulAdd(tl2, half4x4(-0.0660311505198479h, 0.0416736751794815h, 0.3146112561225891h, 0.1472041457891464h, -0.3456672728061676h, -0.0055983816273510h, 0.0022350433282554h, 0.0819796621799469h, 0.0057485047727823h, 0.1532524228096008h, 0.0204557459801435h, -0.2500547170639038h, -0.0524359568953514h, -0.1911625266075134h, -0.1078366711735725h, -0.1296254843473434h), target1);
    target1 = MulAdd(ml1, half4x4(0.0904538556933403h, -0.0150672039017081h, 0.3322310745716095h, 0.0638923197984695h, 0.5975797176361084h, -0.2452044337987900h, -0.4947478473186493h, -0.0783191770315170h, 0.5771877169609070h, -0.0870653912425041h, -0.8966570496559143h, -0.2140965163707733h, -0.0493861362338066h, -0.0380848757922649h, -0.1345319598913193h, -0.0186063013970852h), target1);
    target1 = MulAdd(ml2, half4x4(-0.2523841261863708h, 0.1387074738740921h, 0.7878478765487671h, -0.2251627445220947h, 0.2277439534664154h, 0.5417668819427490h, 0.0866540968418121h, -0.1707777529954910h, -0.0598246827721596h, -0.4717158675193787h, -1.2242834568023682h, 0.0454643070697784h, -0.3503442704677582h, 0.0573085807263851h, 0.2530198395252228h, -0.0207283068448305h), target1);
